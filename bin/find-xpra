#!/usr/bin/perl
# find-xpra — discover X11/xpra/VNC sessions across the network and pop up
# a chooser to attach.
#
# Discovery: query net-mgr for online machines with tcp/22 open (skip APs),
# then `ssh host show-x11 -ns` in parallel and aggregate.  Local sessions
# are included by running show-x11 directly.  Choice pops up a zenity menu;
# selection runs `xpra attach ssh://HOST/DISPLAY` (or local `:DISPLAY`).

use strict;
use warnings;
use Getopt::Long qw(:config no_ignore_case no_bundling);
use IO::Select;
use IO::Pipe;
use IO::Socket::INET;
use POSIX ();
use JSON::PP qw(encode_json decode_json);
use File::Path qw(make_path);
use lib '/usr/local/src/net-mgr/lib';
use NetMgr::Client;

# Snapshot before GetOptions consumes it; needed to re-exec on Rescan.
my @ORIG_ARGV = @ARGV;

# Persisted per-host preferences live in ~/.config/find-xpra/config.json:
#   { "nas3": { "terminal": "mate-terminal" }, ... }
# `*` is the wildcard-default key.
my $CONFIG_DIR  = ($ENV{XDG_CONFIG_HOME} // "$ENV{HOME}/.config") . '/find-xpra';
my $CONFIG_PATH = "$CONFIG_DIR/config.json";
my $CACHE_PATH  = "$CONFIG_DIR/cache.json";
my $SETTINGS    = _load_settings();
my $CACHE       = _load_cache();

my $listen     = $ENV{NET_MGR_LISTEN};
my $ssh_user;             # undef → let ssh_config(5) pick the user
my $user;                 # --user: ssh as USER and filter sessions to USER
my $ssh_to     = 3;
my $overall_to = 8;
my $list_only;
my $no_local;
my $no_scan;
my $scan;
my $pick;
my $no_prompt;
my $no_mount;
my $ssh_key;
my $debug;
my $any;
my $all;
my @extra_hosts;
my $help;

GetOptions(
    'listen=s'   => \$listen,
    'user=s'     => \$user,
    'ssh-user=s' => \$ssh_user,
    'ssh-key=s'  => \$ssh_key,
    'timeout=i'  => \$ssh_to,
    'list'       => \$list_only,
    'no-local'   => \$no_local,
    'no-scan'    => \$no_scan,
    'no-prompt|keys-only' => \$no_prompt,
    'no-mount'   => \$no_mount,
    'scan'       => \$scan,
    'pick'       => \$pick,
    'debug'      => \$debug,
    'any'        => \$any,
    'a|all'      => \$all,
    'host=s@'    => \@extra_hosts,
    'h|help'     => \$help,
) or die usage();
print(usage()), exit 0 if $help;

# --user is a shorthand: ssh as that user AND only show their sessions.
# --ssh-user (if also given) wins for the ssh-as part.
$ssh_user //= $user if defined $user;

# By default, prompts go through ssh-askpass (a GUI dialog) — the parallel
# probe forks have stdin closed and a fresh session, so ssh can't ask on the
# tty even if it wanted to.  SSH_ASKPASS_REQUIRE=force makes OpenSSH 8.4+
# use askpass even with $DISPLAY unset on systems that ship one.
$ENV{SSH_ASKPASS_REQUIRE} //= 'force' unless $no_prompt;

# Debug log: when --debug is on, mirror stderr trace to a file too so
# the trace survives launching from a Tk/desktop context where stderr
# isn't on a terminal.  Append; multiple find-xpra runs and forked
# probes all write here, prefixed with pid so their lines stay sortable.
our $DEBUG_LOG_PATH = '/tmp/find-xpra-debug.log';
our $DEBUG_LOG_FH;
if ($debug) {
    if (open $DEBUG_LOG_FH, '>>', $DEBUG_LOG_PATH) {
        $DEBUG_LOG_FH->autoflush(1);
        print {$DEBUG_LOG_FH}
            "\n=== ", scalar(localtime), " pid=$$ ===\n",
            "    cmd: $0 ", join(' ', @ORIG_ARGV), "\n";
    } else {
        warn "debug log: can't open $DEBUG_LOG_PATH: $!\n";
    }
}

sub _dbg {
    return unless $debug;
    my $msg = join('', @_);
    $msg .= "\n" unless $msg =~ /\n\z/;
    print STDERR $msg;
    print {$DEBUG_LOG_FH} $msg if $DEBUG_LOG_FH;
}

# --- on-demand encrypted key store ---------------------------------------
# If ~/.ssh/keys-<method> is a symlink to the cipher directory, run a
# one-shot mount script (`find-xpra-<method>`) that mounts the cleartext
# at ~/.keys, waits until either it's been idle for 60s or it gets
# SIGHUP, then unmounts and exits.  Concurrent find-xpras share the
# mount: while the script is alive we just SIGUSR1 it to bump its idle
# timeout instead of starting a second mount.  The script owns its own
# unmount, so find-xpra never has to clean up on exit.
#
# Currently `gocryptfs` is the only supported method.

our $KEYS_MNT       = ($ENV{HOME} // '') . '/.keys';
our $KEYS_PIDFILE   = do {
    my $base = $ENV{XDG_RUNTIME_DIR}
            // ($ENV{HOME} ? "$ENV{HOME}/.cache" : '/tmp');
    "$base/find-xpra-keys.pid";
};

sub _keys_link {
    # Pick the first .ssh/keys-<method> symlink we know how to mount.
    my $home = $ENV{HOME} // '';
    return unless length $home;
    for my $method ('gocryptfs') {
        my $link = "$home/.ssh/keys-$method";
        return ($method, $link) if -l $link;
    }
    return;
}

sub _keys_is_mounted {
    return 0 unless -d $KEYS_MNT;
    open my $fh, '<', '/proc/mounts' or return 0;
    while (<$fh>) {
        my @f = split / /;
        return 1 if @f >= 2 && $f[1] eq $KEYS_MNT;
    }
    return 0;
}

# Read pidfile -> live mount-script pid, or undef (cleans stale files).
sub _keys_mount_pid {
    open my $fh, '<', $KEYS_PIDFILE or return undef;
    my $pid = <$fh>;
    close $fh;
    chomp $pid if defined $pid;
    return undef unless defined $pid && $pid =~ /^\d+$/;
    return $pid + 0 if kill 0, $pid;
    unlink $KEYS_PIDFILE;
    return undef;
}

# Locate the per-method mount script (find-xpra-<method>).  Prefer the
# binary alongside us in the source / install tree; fall back to PATH.
sub _keys_helper {
    my ($method) = @_;
    my $name = "find-xpra-$method";
    require File::Basename;
    my $dir = File::Basename::dirname($0);
    return "$dir/$name" if -x "$dir/$name";
    return $name;     # let exec resolve via PATH
}

# Foreground: ensure ~/.keys is mounted.  Returns 1 on success, 0 if no
# keys-<method> symlink is configured, the helper failed to mount, or
# the mount didn't appear within the timeout.
sub _keys_ensure {
    return 0 if $no_mount || $no_prompt;
    my ($method, $link) = _keys_link() or return 0;

    # Mount script already running?  Bump its idle timeout and wait.
    if (my $pid = _keys_mount_pid()) {
        kill 'USR1', $pid;
        _dbg("[debug] keys: USR1 -> $pid");
        return _keys_wait_ready($pid);
    }

    # Nobody home.  Double-fork the helper script for this method so it
    # outlives us — find-xpra exiting must not tear the mount down.
    my $helper = _keys_helper($method);
    _dbg("[debug] keys: spawning $helper");
    my $kid = fork;
    if (!defined $kid) { warn "find-xpra: keys fork: $!\n"; return 0 }
    if ($kid == 0) {
        POSIX::setsid();
        my $kid2 = fork;
        POSIX::_exit(0) if !defined $kid2 || $kid2 != 0;
        open STDIN,  '<', '/dev/null';
        open STDOUT, '>>', '/dev/null';
        # Leave STDERR attached so a mount failure is visible.
        { exec { $helper } $helper };
        POSIX::_exit(127);
    }
    waitpid($kid, 0);
    return _keys_wait_ready();
}

# Poll until ~/.keys is mounted, the helper exits, or we time out.
# Returns 1 on mount success, 0 otherwise.  $expect_pid (optional) is
# the pre-existing helper we just signalled — if it dies before the
# mount appears we abort early.
sub _keys_wait_ready {
    my ($expect_pid) = @_;
    my $deadline = time + 30;
    while (time < $deadline) {
        return 1 if _keys_is_mounted();
        if (defined $expect_pid) {
            return 0 if !kill 0, $expect_pid;
        } else {
            return 0 if !defined _keys_mount_pid();
        }
        select undef, undef, undef, 0.1;
    }
    warn "find-xpra: timed out waiting for $KEYS_MNT to mount\n";
    return 0;
}

sub ssh_opts {
    my @opts = (
        '-o', "ConnectTimeout=$ssh_to",
        '-o', 'StrictHostKeyChecking=accept-new',
        '-o', 'ServerAliveInterval=3',
        '-o', 'ServerAliveCountMax=2',
    );
    # Identity: --ssh-key wins, else fall back to the per-user key the
    # picker's "Keys" dialog saved in $SETTINGS->{_user_keys}{$user}.
    my $key = $ssh_key;
    if (!defined $key && defined $ssh_user) {
        $key = $SETTINGS->{_user_keys}{$ssh_user};
    }
    push @opts, '-i', $key if defined $key && length $key;
    if ($no_prompt) {
        push @opts,
            '-o', 'BatchMode=yes',
            '-o', 'NumberOfPasswordPrompts=0',
            '-o', 'PreferredAuthentications=publickey';
    }
    return @opts;
}

# Build (ssh-args, login) for a candidate.  Use the candidate name as
# the login destination so ~/.ssh/config Host blocks (User, IdentityFile,
# Port, ...) match — but force the actual connection to the IP we
# discovered via `-o HostName=<ip>`, so we don't depend on DNS or
# /etc/hosts being right for that name.  When the name is missing or
# already an IP, fall back to the plain-IP form.
sub ssh_target {
    my ($c) = @_;
    my $name = $c->{name};
    my $ip   = $c->{ip};
    my @args;
    my $host;
    if (defined $name && defined $ip && $name ne $ip) {
        push @args, '-o', "HostName=$ip";
        $host = $name;
    } else {
        $host = $ip // $name;
    }
    my $login = defined $ssh_user ? "$ssh_user\@$host" : $host;
    return (@args, $login);
}

# Resolve the ssh login user for a candidate by consulting ssh_config.
# Two-step:
#   1. `ssh -G NAME` evaluates Host/Match blocks where NAME is the alias
#      (e.g. `Host clevo User claude` matches when NAME is "clevo").
#   2. If that returned just the default $USER (i.e. no rule matched),
#      reverse-scan the config for any Host block whose `Hostname` line
#      points at NAME / IP / bare-name.  This handles the common case
#      where the alias differs from the real hostname:
#         Host clevo
#             Hostname clevo-air.grfx.com
#             User claude
#      so a candidate named "clevo-air" or "clevo-air.grfx.com" still
#      picks up User=claude.
sub _ssh_config_user {
    my ($name, $ip) = @_;
    return undef unless defined $name && length $name;
    my $g_user;
    # Fork-exec ssh -G with stderr silenced so the harmless
    # "Pseudo-terminal will not be allocated because stdin is not a
    # terminal" warning doesn't flood the user's terminal.
    my $cpid = open my $h, '-|';
    if (!defined $cpid) {
        # fork failed — fall through to reverse-lookup only.
    } elsif ($cpid == 0) {
        open STDERR, '>', '/dev/null';
        exec 'ssh', '-G', $name or POSIX::_exit(127);
    } else {
        while (<$h>) { $g_user = $1, last if /^user\s+(\S+)/ }
        close $h;
    }
    return $g_user if defined $g_user
                   && length $g_user
                   && $g_user ne ($ENV{USER} // '');
    my $hostname_map = _ssh_config_hostname_map();
    for my $key (
        lc $name,
        (defined $ip ? lc $ip : ()),
        ($name =~ /^([^.]+)\./ ? lc $1 : ()),
    ) {
        return $hostname_map->{$key} if defined $hostname_map->{$key};
    }
    return $g_user;
}

# Build a lower-cased "Hostname value -> User" map across all ssh_config
# files, plus a bare-form alias (Hostname `clevo-air.grfx.com` also
# entered as `clevo-air`).  First definition wins, matching ssh's own
# precedence.
sub _ssh_config_hostname_map {
    my %map;
    my $cur;
    my $finalize = sub {
        return unless $cur;
        if (defined $cur->{user} && defined $cur->{hostname}) {
            my $hn = lc $cur->{hostname};
            $map{$hn} //= $cur->{user};
            $map{$1}  //= $cur->{user} if $hn =~ /^([^.]+)\./;
        }
        $cur = undef;
    };
    for my $f (
        ($ENV{HOME} ? "$ENV{HOME}/.ssh/config" : ()),
        '/etc/ssh/ssh_config',
        glob('/etc/ssh/ssh_config.d/*.conf'),
    ) {
        next unless -r $f;
        open my $fh, '<', $f or next;
        while (<$fh>) {
            s/#.*//;
            s/^\s+|\s+$//g;
            next unless length;
            if (/^Host\s+/i) {
                $finalize->();
                $cur = { user => undef, hostname => undef };
            } elsif ($cur) {
                if    (/^Hostname\s+(\S+)/i) { $cur->{hostname} = $1 }
                elsif (/^User\s+(\S+)/i)     { $cur->{user}     = $1 }
            }
        }
        $finalize->();
        close $fh;
    }
    return \%map;
}

# Collect every distinct User mentioned across ~/.ssh/config and
# /etc/ssh/ssh_config, plus the current $USER, plus any names the user
# explicitly added via the picker's "Add user" button (persisted under
# $SETTINGS->{_users}).  Used to populate the per-row user dropdown so a
# host that ssh_config defaults to (e.g.) `claude` can still be probed
# as `dkc`/`wdkc` from the same picker.
sub _ssh_config_users {
    my %users;
    $users{$ENV{USER}} = 1 if defined $ENV{USER} && length $ENV{USER};
    for my $u (keys %{ $SETTINGS->{_users} || {} }) {
        $users{$u} = 1;
    }
    for my $f (
        ($ENV{HOME} ? "$ENV{HOME}/.ssh/config" : ()),
        '/etc/ssh/ssh_config',
        glob('/etc/ssh/ssh_config.d/*.conf'),
    ) {
        next unless -r $f;
        open my $fh, '<', $f or next;
        while (<$fh>) {
            next if /^\s*(?:#|$)/;
            $users{$1} = 1 if /^\s*User\s+(\S+)/i;
        }
        close $fh;
    }
    return sort keys %users;
}

sub usage { <<'EOF' }
usage: find-xpra [options]
  --listen HOST[:PORT]  net-mgr address (default: $NET_MGR_LISTEN, then
                        127.0.0.1:7531, then nmap-scan local /24 for :7531)
  --user USER           ssh as USER and only show sessions owned by USER
  --ssh-user USER       override ssh user only (default: from ssh_config(5))
  --ssh-key FILE        ssh -i FILE (private key to authenticate with)
  --no-prompt, --keys-only
                        never prompt for an ssh password (BatchMode=yes,
                        publickey-only); default is to allow ssh-askpass
  --no-mount            don't try to mount an encrypted ~/.ssh/keys-*
                        store; assume any keys ssh needs are already
                        available (or use --keys-only to fail fast)
  --scan                force nmap scan even if local net-mgr is up
  --pick                pop up a host chooser before any ssh probe;
                        sorted by favorite, last-known session count,
                        then signals (X / VNC / net-mgr); per-row star
                        toggles favorite, "Forget" clears the cache
                        entry (Tk dialog; --list gets a CLI prompt)
  --no-scan             don't fall back to scanning the subnet for net-mgr
  --timeout SEC         per-host ssh ConnectTimeout (default: 3)
  --list                print rows to stdout instead of popping a chooser
  --no-local            skip local show-x11 probe; also skip our own IP
                        when scanning for net-mgr
  --any                 show sessions belonging to all users, not just
                        the ssh login user (discovers displays from
                        /tmp/.X11-unix/ on each host)
  -a, --all             show everything otherwise hidden: displays under
                        :20 (presumed plain X), displays over :1000, and
                        sessions whose only contents are session plumbing
  --host HOST           add HOST to the probe list (repeatable); if no
                        sessions are discovered, offers :0 as fallback
  --debug               print the probe command for each candidate and
                        leave ssh's stderr attached so failures show why
  -h, --help            this message
EOF

sub probe_net_mgr {
    # Quick TCP probe — does anything answer at HOST[:PORT]?
    my ($addr) = @_;
    my ($host, $port) = split /:/, $addr, 2;
    $port = 7531 if !defined $port || $port eq '';
    my $sock = IO::Socket::INET->new(
        PeerAddr => $host,
        PeerPort => $port,
        Proto    => 'tcp',
        Timeout  => 1,
    ) or return 0;
    close $sock;
    return 1;
}

sub _local_ips_set {
    # Cross-platform: try `ip` (Linux), `ifconfig` (BSD/macOS, older
    # Linux), then `ipconfig` (Cygwin/Windows native).  Returns a hashref
    # keyed by every IPv4/IPv6 address we own.
    my %ips;
    if (open my $h, '-|', 'ip', '-o', 'addr', 'show') {
        while (<$h>) { $ips{$1} = 1 if /\binet6?\s+([\da-f.:]+)/i }
        close $h;
    }
    if (!%ips && open my $h, '-|', 'ifconfig') {
        while (<$h>) { $ips{$1} = 1 if /\binet6?\s+(?:addr:\s*)?([\da-f.:]+)/i }
        close $h;
    }
    if (!%ips && open my $h, '-|', 'ipconfig') {
        while (<$h>) { $ips{$1} = 1
            if /(?:IPv4 Address|IPv6 Address|IP Address)[^:]*:\s*([\da-f.:]+)/i }
        close $h;
    }
    return \%ips;
}

sub _default_src_ip {
    # The IP we'd use to reach the outside world.  On Linux, ask `ip
    # route get`.  Otherwise, fall back to the first non-loopback IPv4
    # we own — good enough for picking a /24 to nmap-scan.
    if (open my $h, '-|', 'ip', 'route', 'get', '1.1.1.1') {
        while (<$h>) { return $1 if /\bsrc\s+(\S+)/ }
    }
    my $ips = _local_ips_set();
    for my $ip (sort keys %$ips) {
        next unless $ip =~ /^\d+\.\d+\.\d+\.\d+$/;
        next if $ip =~ /^127\./;
        return $ip;
    }
    return undef;
}

sub scan_net_mgr {
    # nmap the local /24 for port 7531/tcp.  Returns 'host:port' or undef.
    # If $skip_self, drop our own source IP from the result so a remote
    # peer wins instead of looping back to ourselves.
    my ($skip_self) = @_;
    my $src = _default_src_ip();
    return undef unless $src;
    (my $subnet = $src) =~ s{\.\d+$}{.0/24};
    my @hosts;
    if (open my $nh, '-|',
        'nmap', '-Pn', '-T4', '-n', '-p', '7531', '--open', '-oG', '-', $subnet) {
        while (<$nh>) {
            if (/^Host:\s+(\S+).*7531\/open/) {
                next if $skip_self && $1 eq $src;
                push @hosts, $1;
            }
        }
        close $nh;
    }
    return @hosts ? "$hosts[0]:7531" : undef;
}

# --- discover candidate hosts via net-mgr ---------------------------------

unless (defined $listen) {
    if ($scan) {
        $listen = scan_net_mgr($no_local)
            or die "--scan: no net-mgr found on local /24\n";
    } elsif (probe_net_mgr('127.0.0.1:7531')) {
        $listen = '127.0.0.1:7531';
    } elsif (!$no_scan) {
        $listen = scan_net_mgr($no_local)
            or die "no net-mgr found locally or on the subnet; use --listen HOST\n";
    } else {
        die "no local net-mgr at 127.0.0.1:7531 and --no-scan set; use --listen HOST\n";
    }
}

my $cli = NetMgr::Client->new(listen => $listen);
$cli->hello(consumer => "net-show-x11.$$");
my $machines = $cli->snapshot(1, 'machines');
my $ifaces   = $cli->snapshot(2, 'interfaces');
my $addrs    = $cli->snapshot(3, 'addresses', where => "family = 'v4'");
my $ports22  = $cli->snapshot(4, 'ports', where => "port = 22");
my $aps      = $cli->snapshot(5, 'aps');
# Service ports used to prioritise the --pick list.  X11: 6000-6063
# (TCP-listening Xorg/Xvfb), VNC: 5900-5999, net-mgr: 7531.
my $svc_ports = $cli->snapshot(6, 'ports',
    where => "(port >= 6000 AND port <= 6063)"
           . " OR (port >= 5900 AND port <= 5999)"
           . " OR port = 7531");
$cli->bye;

my %ap_mac  = map { $_->{mac} => 1 } @$aps;
my %ssh_mac = map { $_->{mac} => 1 } @$ports22;
my %ip_for;
for my $a (@$addrs) {
    push @{ $ip_for{$a->{mac}} }, $a->{addr};
}
my %macs_of;
for my $i (@$ifaces) {
    next unless defined $i->{machine_id};
    push @{ $macs_of{$i->{machine_id}} }, $i->{mac};
}
my %svc_for;     # mac => [ports]
for my $p (@$svc_ports) {
    push @{ $svc_for{$p->{mac}} }, $p->{port};
}

# Local IPs — used to flag candidates that are us, so we run show-x11
# directly instead of sshing into ourselves.  _local_ips_set() probes
# ip / ifconfig / ipconfig in turn so this works on Linux, BSD/macOS
# and Cygwin alike.
my %local_ip = %{ _local_ips_set() };

my @candidates;
for my $m (@$machines) {
    next unless $m->{online};
    my $best_ip;
    my ($x_n, $vnc_n, $nm_n) = (0, 0, 0);
    for my $mac (@{ $macs_of{$m->{id}} || [] }) {
        for my $p (@{ $svc_for{$mac} || [] }) {
            $x_n++   if $p >= 6000 && $p <= 6063;
            $vnc_n++ if $p >= 5900 && $p <= 5999;
            $nm_n++  if $p == 7531;
        }
        next if $ap_mac{$mac};
        next unless $ssh_mac{$mac};
        ($best_ip) = sort @{ $ip_for{$mac} || [] } unless defined $best_ip;
    }
    next unless defined $best_ip;
    push @candidates, { name => $m->{primary_name} // $best_ip, ip => $best_ip,
                        local => $local_ip{$best_ip} ? 1 : 0,
                        x => $x_n, vnc => $vnc_n, nm => $nm_n };
}
# The net-mgr host itself isn't in its own inventory — add it explicitly,
# unless it's loopback (covered by the localhost probe; adding 127.0.0.1
# would either duplicate it or, with --no-local, ssh-probe ourselves
# under the wrong host label).
my ($mgr_host) = split /:/, $listen, 2;
my $mgr_is_local = $mgr_host =~ /^(?:127\.|::1$|localhost$)/
                || $local_ip{$mgr_host};
unless ($mgr_is_local
        || grep { ($_->{name} // '') eq $mgr_host || ($_->{ip} // '') eq $mgr_host } @candidates) {
    push @candidates, { name => $mgr_host, ip => $mgr_host };
}

for my $h (@extra_hosts) {
    next if grep { ($_->{name} // '') eq $h || ($_->{ip} // '') eq $h } @candidates;
    push @candidates, { name => $h, ip => $h, _extra => 1 };
}

if ($no_local) {
    @candidates = grep { !$_->{local} } @candidates;
} elsif (!grep { $_->{local} } @candidates) {
    # Fallback when the local box isn't in net-mgr's inventory.
    push @candidates, { name => 'localhost', ip => undef, local => 1 };
}

# If --user is set and differs from the current account, the local
# shortcut (which runs show-x11/xpra-list as $ENV{USER}) won't see the
# target user's sessions.  Strip the `local` flag so we ssh in as $user
# instead.  Need an IP for ssh — fall back to 127.0.0.1 for the
# "localhost" placeholder.
if (defined $user && $user ne ($ENV{USER} // '')) {
    for my $c (@candidates) {
        next unless $c->{local};
        $c->{local} = 0;
        $c->{ip} //= '127.0.0.1';
    }
}

# Resolve per-candidate ssh user via `ssh -G NAME` when neither --user
# nor --ssh-user was given.  ~/.ssh/config Host blocks (e.g. `Host clevo
# User claude`) then drive both the ssh login and the user we tag the
# session under, so `find-xpra --listen clevo` correctly attributes
# sessions to claude rather than to whoever ran find-xpra.
unless (defined $ssh_user) {
    for my $c (@candidates) {
        next if $c->{local};
        $c->{ssh_user} = _ssh_config_user($c->{name}, $c->{ip});
    }
}

if ($pick) {
    # Sort by:
    #   1. favorite (sticky pin from prior runs)
    #   2. cached session count (so a host last seen with sessions floats)
    #   3. net-mgr-known signals: X (6000-6063), VNC (5900-5999), net-mgr (7531)
    #   4. name (alphabetic) — stable order for everything else.
    my @ranked = sort {
           (($SETTINGS->{ _name_for($b) }{favorite}//0)
            <=> ($SETTINGS->{ _name_for($a) }{favorite}//0))
        || (($CACHE->{ _name_for($b) }{n_sessions}//0)
            <=> ($CACHE->{ _name_for($a) }{n_sessions}//0))
        || (($b->{x}  // 0) <=> ($a->{x}  // 0))
        || (($b->{vnc}// 0) <=> ($a->{vnc}// 0))
        || (($b->{nm} // 0) <=> ($a->{nm} // 0))
        || (_name_for($a)   cmp _name_for($b))
    } @candidates;
    my $chosen = pick_host(\@ranked);
    defined $chosen or exit 1;
    @candidates = ($chosen);
    # If the picker's user-dropdown selected a specific login, lift it
    # to the global $ssh_user so ssh_target() / ssh_opts() / attach all
    # honour it for the rest of the run.
    $ssh_user = $chosen->{ssh_user}
        if defined $chosen->{ssh_user} && length $chosen->{ssh_user};
    # We're now probing exactly one host the user explicitly picked, so
    # the parallel-probe haste no longer applies — give them plenty of
    # time to deal with the askpass dialog.
    $overall_to = 120;
}

sub _name_for {
    my ($c) = @_;
    return $c->{name} // 'localhost';
}

sub _host_label {
    my ($c) = @_;
    return 'localhost' if !defined $c->{ip};   # explicit-fallback case
    my $name = _name_for($c);
    my $disp = $name;
    $disp .= " ($c->{ip})"   if $c->{ip} ne $name;
    $disp .= "  [local]"     if $c->{local};
    if (my $cl = _cache_label($name)) { $disp .= "  [$cl]" }
    my @tags;
    push @tags, "$c->{x} X"     if $c->{x};
    push @tags, "$c->{vnc} VNC" if $c->{vnc};
    push @tags, "net-mgr"       if $c->{nm};
    $disp .= "  [".join(', ', @tags)."]" if @tags;
    return $disp;
}

sub pick_host {
    my ($cands) = @_;
    if ($list_only) {
        print STDERR "Hosts:\n";
        for my $i (0 .. $#$cands) {
            my $fav = $SETTINGS->{ _name_for($cands->[$i]) }{favorite} ? '* ' : '  ';
            print STDERR sprintf("  [%d] %s%s\n", $i+1, $fav, _host_label($cands->[$i]));
        }
        print STDERR "Pick (1-", scalar @$cands, ", empty to cancel): ";
        my $line = <STDIN>;
        return undef unless defined $line;
        chomp $line;
        return undef if $line eq '';
        my $i = $line - 1;
        return undef unless $i >= 0 && $i < @$cands;
        return $cands->[$i];
    }
    # Tk picker runs in a forked subprocess: keeps the main process from
    # ever loading Tk, so the post-pick parallel-ssh probe doesn't fork
    # off a child carrying the parent's X11 fd (which crashes both ends
    # when the child exits, even with POSIX::_exit).  Child writes the
    # chosen index to a pipe; parent reads it and proceeds.
    pipe(my $rh, my $wh) or die "pipe: $!";
    my $pid = fork // die "fork: $!";
    if (!$pid) {
        close $rh;
        _dbg("[debug] picker: child started, requiring Tk");
        require Tk;
        Tk->import;
        _dbg("[debug] picker: Tk loaded");
        my @user_choices = _ssh_config_users();
        _dbg("[debug] picker: user_choices = " . join(',', @user_choices));
        my $mw = MainWindow->new(-title => 'find-xpra: pick host');
        _dbg("[debug] picker: MainWindow created");
        $mw->optionAdd('*Font' => 'sans-serif 11');
        # Bottom controls packed FIRST with -side => 'bottom' so they
        # always anchor to the window's bottom edge regardless of how
        # tall the rows section gets.  The header packs to the top.
        my $bottom_f = $mw->Frame;
        $bottom_f->pack(-side => 'bottom', -fill => 'x', -pady => 10);
        $mw->Label(-text => 'Probe which host?', -padx => 16, -pady => 8)
            ->pack(-side => 'top', -anchor => 'w');

        # Host rows go in a Canvas-wrapped Frame so the dialog scrolls
        # vertically when there are more candidates than fit on screen.
        my $rows_outer = $mw->Frame;
        $rows_outer->pack(-side => 'top', -fill => 'both', -expand => 1);
        my $canvas = $rows_outer->Canvas(
            -borderwidth        => 0,
            -highlightthickness => 0,
        );
        my $sb = $rows_outer->Scrollbar(
            -orient  => 'vertical',
            -command => [ 'yview', $canvas ],
        );
        $canvas->configure(-yscrollcommand => [ 'set', $sb ]);
        $sb    ->pack(-side => 'right', -fill => 'y');
        $canvas->pack(-side => 'left',  -fill => 'both', -expand => 1);
        my $rows_f = $canvas->Frame;
        my $rows_winid = $canvas->createWindow(0, 0,
            -window => $rows_f, -anchor => 'nw');
        # Keep the scrollregion in sync with the inner frame's natural
        # size, and have the canvas request a height that fits the rows
        # but is capped to ~70% of the screen so the window never grows
        # past where the bottom controls would be off-screen.
        my $cap_h = int($mw->screenheight * 0.70);
        $rows_f->bind('<Configure>', sub {
            $canvas->configure(-scrollregion => [ $canvas->bbox('all') ]);
            my $req_w = $rows_f->reqwidth;
            my $req_h = $rows_f->reqheight;
            $canvas->configure(-width  => $req_w);
            $canvas->configure(-height => $req_h > $cap_h ? $cap_h : $req_h);
        });
        # Mouse wheel scrolls the canvas (X11 buttons 4/5; MouseWheel for
        # systems that send a delta).
        $canvas->Tk::bind('<Button-4>',
                          sub { $canvas->yview('scroll', -3, 'units') });
        $canvas->Tk::bind('<Button-5>',
                          sub { $canvas->yview('scroll',  3, 'units') });
        $canvas->Tk::bind('<MouseWheel>', sub {
            my $d = $Tk::event ? $Tk::event->D : 0;
            $canvas->yview('scroll', $d > 0 ? -3 : 3, 'units');
        });

        # "Hidden" hosts (Forget'd in a previous run) stay out of the
        # picker until the user clicks "Show all", which switches mode
        # so hidden rows reappear with an "Enable" button to un-hide.
        my $show_hidden = 0;
        my @row_widgets;
        my ($show_btn, $rebuild_rows);
        $rebuild_rows = sub {
            $_->destroy for @row_widgets;
            @row_widgets = ();
            my $r = 0;
            for my $i (0 .. $#$cands) {
                my $c    = $cands->[$i];
                my $name = _name_for($c);
                my $is_hidden = $SETTINGS->{$name}{hidden} ? 1 : 0;
                next if $is_hidden && !$show_hidden;
                my $is_fav = $SETTINGS->{$name}{favorite} ? 1 : 0;
                # Per-row chosen user: starts at the resolved ssh-config
                # User (or $USER for the explicit-localhost fallback) and
                # is bound to an Optionmenu so the human can override
                # before clicking the host button.
                my $row_user = $ssh_user
                            // $c->{ssh_user}
                            // $ENV{USER}
                            // ($user_choices[0] // '');
                my ($fav_btn, $main_btn, $user_om, $action_btn);
                $fav_btn = $rows_f->Button(
                    -text => $is_fav ? "\x{2605}" : "\x{2606}",
                    -command => sub {
                        $is_fav = !$is_fav;
                        $SETTINGS->{$name}{favorite} = $is_fav ? 1 : 0;
                        _save_settings($SETTINGS);
                        $fav_btn->configure(
                            -text => $is_fav ? "\x{2605}" : "\x{2606}");
                    });
                $main_btn = $rows_f->Button(
                    -text => _host_label($c), -anchor => 'w',
                    -command => sub {
                        # Send back chosen index + the user from this row
                        # so the parent ssh-probes as exactly that user.
                        print {$wh} "$i\t$row_user\n";
                        close $wh;
                        $mw->destroy;
                    });
                $user_om = $rows_f->Optionmenu(
                    -options => [@user_choices],
                    -variable => \$row_user,
                );
                # Optionmenu defaults to the first option; force it to
                # our resolved/preferred user if it's in the list.
                if (length $row_user
                    && grep { $_ eq $row_user } @user_choices) {
                    $user_om->setOption($row_user);
                }
                if ($is_hidden) {
                    $action_btn = $rows_f->Button(
                        -text => 'Enable',
                        -command => sub {
                            delete $SETTINGS->{$name}{hidden};
                            _save_settings($SETTINGS);
                            $rebuild_rows->();
                        });
                } else {
                    $action_btn = $rows_f->Button(
                        -text => 'Forget',
                        -command => sub {
                            $SETTINGS->{$name}{hidden} = 1;
                            _save_settings($SETTINGS);
                            delete $CACHE->{$name};
                            _save_cache();
                            $rebuild_rows->();
                        });
                }
                $fav_btn   ->grid(-row => $r, -column => 0, -padx => 4, -pady => 1);
                $main_btn  ->grid(-row => $r, -column => 1, -padx => 4, -pady => 1, -sticky => 'ew');
                $user_om   ->grid(-row => $r, -column => 2, -padx => 4, -pady => 1, -sticky => 'ew');
                $action_btn->grid(-row => $r, -column => 3, -padx => 4, -pady => 1);
                push @row_widgets, $fav_btn, $main_btn, $user_om, $action_btn;
                $r++;
            }
        };
        $rebuild_rows->();
        _dbg("[debug] picker: rows built");

        # Show all and Hide swap places: only one is visible at a time.
        # Default view: [Show all] [Cancel].  After clicking Show all:
        # [Hide] [Cancel].
        my ($cancel_btn, $hide_btn);
        $show_btn = $bottom_f->Button(
            -text => 'Show all',
            -command => sub {
                $show_hidden = 1;
                $rebuild_rows->();
                $show_btn->packForget;
                $hide_btn->pack(-side => 'left', -padx => 6,
                                -before => $cancel_btn);
            });
        $hide_btn = $bottom_f->Button(
            -text => 'Hide',
            -command => sub {
                $show_hidden = 0;
                $rebuild_rows->();
                $hide_btn->packForget;
                $show_btn->pack(-side => 'left', -padx => 6,
                                -before => $cancel_btn);
            });
        $cancel_btn = $bottom_f->Button(
            -text => 'Cancel',
            -command => sub { $mw->destroy });
        my $add_btn = $bottom_f->Button(
            -text => 'Add user',
            -command => sub {
                my $top = $mw->Toplevel(-title => 'find-xpra: add user');
                $top->Label(-text => 'New username for the dropdowns:',
                            -padx => 12, -pady => 8)->pack(-anchor => 'w');
                my $name = '';
                my $entry = $top->Entry(-textvariable => \$name, -width => 30);
                $entry->pack(-padx => 12, -pady => 4, -fill => 'x');
                $entry->focus;
                my $bf = $top->Frame->pack(-pady => 8);
                my $accept = sub {
                    $name =~ s/^\s+|\s+$//g;
                    if (length $name) {
                        $SETTINGS->{_users}{$name} = 1;
                        _save_settings($SETTINGS);
                        # Refresh the choices list and rebuild rows so
                        # every dropdown picks up the new option.
                        @user_choices = _ssh_config_users();
                        $rebuild_rows->();
                    }
                    $top->destroy;
                };
                $bf->Button(-text => 'OK',     -command => $accept)
                   ->pack(-side => 'left', -padx => 6);
                $bf->Button(-text => 'Cancel', -command => sub { $top->destroy })
                   ->pack(-side => 'left', -padx => 6);
                $entry->bind('<Return>', $accept);
                $top->protocol('WM_DELETE_WINDOW' => sub { $top->destroy });
            });
        my $keys_btn = $bottom_f->Button(
            -text => 'Keys',
            -command => sub {
                my $top = $mw->Toplevel(-title => 'find-xpra: ssh keys');
                $top->Label(-text => 'Per-user ssh key files (used when '
                                   . '--ssh-key isn\'t given):',
                            -padx => 12, -pady => 8)->pack(-anchor => 'w');
                my %paths;   # user -> scalar holding current path
                for my $u (@user_choices) {
                    my $val = $SETTINGS->{_user_keys}{$u} // '';
                    $paths{$u} = \$val;
                    my $row = $top->Frame;
                    $row->pack(-fill => 'x', -padx => 12, -pady => 2);
                    $row->Label(-text => $u, -width => 12, -anchor => 'w')
                        ->pack(-side => 'left');
                    my $entry = $row->Entry(-textvariable => $paths{$u},
                                            -width => 40);
                    $entry->pack(-side => 'left', -fill => 'x',
                                 -expand => 1, -padx => 4);
                    $row->Button(-text => 'Browse', -command => sub {
                        my $start = "$ENV{HOME}/.ssh";
                        $start = $ENV{HOME} unless -d $start;
                        my $f = $top->getOpenFile(
                            -title      => "ssh key for $u",
                            -initialdir => $start,
                        );
                        ${ $paths{$u} } = $f
                            if defined $f && length $f;
                    })->pack(-side => 'left', -padx => 2);
                    $row->Button(-text => 'Clear', -command => sub {
                        ${ $paths{$u} } = '';
                    })->pack(-side => 'left', -padx => 2);
                }
                my $bf = $top->Frame->pack(-pady => 10);
                $bf->Button(-text => 'Save', -command => sub {
                    for my $u (keys %paths) {
                        my $v = ${ $paths{$u} };
                        $v =~ s/^\s+|\s+$//g if defined $v;
                        if (defined $v && length $v) {
                            $SETTINGS->{_user_keys}{$u} = $v;
                        } else {
                            delete $SETTINGS->{_user_keys}{$u};
                        }
                    }
                    _save_settings($SETTINGS);
                    $top->destroy;
                })->pack(-side => 'left', -padx => 6);
                $bf->Button(-text => 'Cancel',
                            -command => sub { $top->destroy })
                   ->pack(-side => 'left', -padx => 6);
                $top->protocol('WM_DELETE_WINDOW' => sub { $top->destroy });
            });
        # Initial layout: Show all + Add user + Keys + Cancel
        # (Hide kept in reserve — swaps with Show all.)
        $show_btn  ->pack(-side => 'left', -padx => 6);
        $add_btn   ->pack(-side => 'left', -padx => 6);
        $keys_btn  ->pack(-side => 'left', -padx => 6);
        $cancel_btn->pack(-side => 'left', -padx => 6);

        $mw->protocol('WM_DELETE_WINDOW' => sub { $mw->destroy });
        _dbg("[debug] picker: about to MainLoop");
        Tk::MainLoop();
        _dbg("[debug] picker: MainLoop returned");
        # Cancel/window-close: $wh was never written to.  Closing it now
        # signals EOF to the parent so it doesn't block reading.
        close $wh;
        POSIX::_exit(0);
    }
    close $wh;
    my $line = <$rh>;
    close $rh;
    waitpid($pid, 0);
    # The picker subprocess may have written settings (favourites,
    # hidden hosts, added users, per-user keys); reload so the parent
    # sees them for ssh_opts() / probe / attach.
    $SETTINGS = _load_settings();
    return undef unless defined $line && length $line;
    chomp $line;
    my ($idx_str, $picked_user) = split /\t/, $line, 2;
    return undef unless defined $idx_str && $idx_str =~ /^(\d+)$/;
    my $idx = $1 + 0;
    return undef unless $idx < @$cands;
    my $picked = $cands->[$idx];
    # Honour the user the picker selected (overrides any earlier
    # ssh-config resolution) so the probe / attach run as that user.
    $picked->{ssh_user} = $picked_user
        if defined $picked_user && length $picked_user;
    return $picked;
}

# Single MainWindow for the whole process — Tk segfaults if you create,
# destroy, and recreate one.  Lazily initialised; withdrawn until something
# (chooser, no-sessions dialog) actually needs it.  Picker, settings,
# proc-list popups, etc. attach as Toplevels of this.
my $TK_MW;
sub _tk_mw {
    return $TK_MW if $TK_MW;
    _dbg("[debug] _tk_mw: require Tk");
    require Tk;
    _dbg("[debug] _tk_mw: Tk->import");
    Tk->import;
    _dbg("[debug] _tk_mw: MainWindow->new");
    $TK_MW = MainWindow->new(-title => 'find-xpra');
    _dbg("[debug] _tk_mw: MW created, configuring");
    $TK_MW->optionAdd('*Font' => 'sans-serif 11');
    # Don't withdraw — the picker is a subprocess now, so the parent MW
    # doesn't need to be hidden to make room for the picker Toplevel.
    # Withdraw + immediate deiconify on a freshly-created MW seems to be
    # what triggers the segfault on this Tk build.
    _dbg("[debug] _tk_mw: ready");
    return $TK_MW;
}

# --- parallel show-x11 probe ----------------------------------------------

# Mount the on-demand key store (if configured) before we fork — child
# probes inherit the mount and we avoid N races to mount the same path.
_keys_ensure();

my $sel = IO::Select->new;
my %pid_for;
for my $c (@candidates) {
    my $pipe = IO::Pipe->new;
    my $pid  = fork;
    die "fork: $!" unless defined $pid;
    if (!$pid) {
        $pipe->writer;
        # POSIX::_exit (used at the bottom to skip Tk's END handler)
        # also skips stdio buffer flush, so anything Perl-buffered to
        # the pipe is lost.  Autoflush keeps every write reaching the
        # parent immediately.
        $pipe->autoflush(1);
        # --debug: leave stderr attached so the user sees ssh's complaint
        # ("Permission denied", "Connection refused", ...).  Otherwise
        # silence it as before so a tide of "Permission denied"s doesn't
        # drown the probe output.
        open STDERR, '>', '/dev/null' unless $debug;
        # Detach from the controlling tty + close stdin so ssh can't try
        # to read a password off the terminal (N parallel probes would
        # otherwise race for the tty).  ssh falls back to SSH_ASKPASS.
        POSIX::setsid();
        open STDIN, '<', '/dev/null';
        # Defensive self-kill: if we're still alive past the global
        # deadline, take ourselves out so a stuck ssh can't pin a fd or
        # leave a process around.  POSIX::_exit skips END blocks — Tk's
        # END would otherwise try to tear down the X11 fd inherited from
        # the parent picker and crash both processes.
        $SIG{ALRM} = sub { POSIX::_exit(1) };
        alarm($overall_to + 1);
        # Run three stages:
        #   show-x11 -ns -id   -> per-display proc list (apps + machine-id)
        #   xpra list          -> authoritative list of xpra displays, even
        #                         empty ones that show-x11 would miss
        #   cat ~/.xpra-start  -> user's "intended sessions" map; if
        #                         present we'll pivot the picker to show
        #                         these entries (green/red by running)
        # Separators mark the boundaries so the parser can switch modes.
        # No `2>/dev/null` -- a csh/tcsh login shell on the remote chokes
        # on bash-style redirection and the whole probe returns nothing.
        # The cat is `cat -- ~/.xpra-start || true` so a missing file
        # doesn't tank the pipeline; the surrounding parens make it work
        # in both bourne-style and csh-style shells.
        my $remote = 'show-x11 -ns -id; echo __XPRA__; xpra list; '
                   . 'echo __XSTART__; cat ~/.xpra-start; '
                   . 'echo __VNC__; (ss -tln 2>/dev/null || netstat -tln 2>/dev/null); '
                   . 'echo __PSVNC__; ps -eo user,pid,args';
        $remote .= q{; echo __DISPLAYS__; stat -c '%n %U' /tmp/.X11-unix/X*}
            if $any;
        my @cmd = $c->{local}
            ? ('sh', '-c', $remote)
            : ('ssh', ssh_opts(), ssh_target($c), $remote);
        _dbg("[debug] $c->{name}: ",
             join(' ', map { /\s/ ? "'$_'" : $_ } @cmd));
        if (open my $oh, '-|', @cmd) {
            my $disp;
            my $in_xpra   = 0;
            my $in_xstart = 0;
            my $in_vnc    = 0;
            my $in_disps  = 0;
            my $in_psvnc  = 0;
            my %vnc_seen;
            while (defined(my $line = <$oh>)) {
                chomp $line;
                _dbg("[debug] $c->{name}> $line");
                if ($line eq '__XPRA__')     { $in_xpra = 1; $in_xstart = 0; $in_vnc = 0; $in_disps = 0; $in_psvnc = 0; next }
                if ($line eq '__XSTART__')  { $in_xpra = 0; $in_xstart = 1; $in_vnc = 0; $in_disps = 0; $in_psvnc = 0; next }
                if ($line eq '__VNC__')     { $in_xpra = 0; $in_xstart = 0; $in_vnc = 1; $in_disps = 0; $in_psvnc = 0; next }
                if ($line eq '__PSVNC__')   { $in_xpra = 0; $in_xstart = 0; $in_vnc = 0; $in_disps = 0; $in_psvnc = 1; next }
                if ($line eq '__DISPLAYS__'){ $in_xpra = 0; $in_xstart = 0; $in_vnc = 0; $in_disps = 1; $in_psvnc = 0; next }
                if ($in_vnc) {
                    if ($line =~ /:(\d+)\b/ && $1 >= 5900 && $1 <= 5999) {
                        my $port = $1 + 0;
                        next if $vnc_seen{$port}++;
                        my $disp_n = $port - 5900;
                        print { $pipe } join("\t", '__vnc__', $c->{name}, $disp_n, $port), "\n";
                    }
                    next;
                }
                if ($in_psvnc) {
                    next unless $line =~ /^\s*(\S+)\s+(\d+)\s+(.*)/;
                    my ($ps_user, $ps_pid, $ps_cmd) = ($1, $2, $3);
                    # VNC server processes
                    if ($ps_cmd =~ /\b(?:Xvnc|x11vnc|Xtigervnc|Xtightvnc|tigervncserver|vino-server|krfb)\b/) {
                        my $disp_n;
                        if ($ps_cmd =~ /(?:^|\s):(\d+)\b/) { $disp_n = $1 }
                        elsif ($ps_cmd =~ /-display\s+:(\d+)/) { $disp_n = $1 }
                        my $port;
                        if ($ps_cmd =~ /-rfbport\s+(\d+)/) { $port = $1 }
                        $port //= 5900 + ($disp_n // 0) if defined $disp_n;
                        $disp_n //= ($port - 5900) if defined $port && $port >= 5900;
                        print { $pipe } join("\t", '__psvnc__', $c->{name},
                                             $disp_n // '', $port // '', $ps_user), "\n";
                    }
                    # Xpra server processes (Xdummy/Xvfb started by xpra)
                    if ($ps_cmd =~ /\b(?:xpra_Xdummy|Xdummy|Xvfb)\b.*(?:^|\s):(\d+)\b/) {
                        print { $pipe } join("\t", '__psxpra__', $c->{name},
                                             $1, $ps_user), "\n";
                    }
                    elsif ($ps_cmd =~ /\bxpra\s+(?:start|start-desktop)\b.*(?:^|\s):(\d+)\b/) {
                        print { $pipe } join("\t", '__psxpra__', $c->{name},
                                             $1, $ps_user), "\n";
                    }
                    next;
                }
                if ($in_disps) {
                    # stat -c '%n %U' output: /tmp/.X11-unix/X20 claude
                    if ($line =~ /X(\d+)\s+(\S+)/) {
                        print { $pipe } join("\t", '__disp__', $c->{name}, $1, $2), "\n";
                    }
                    next;
                }
                if ($in_xstart) {
                    # ~/.xpra-start lines: "<n>: <cmd>" or ":<n>: <cmd>".
                    # Skip blanks and comments.  Strip inline `#` comments.
                    (my $l = $line) =~ s/#.*//;
                    next if $l =~ /^\s*$/;
                    if ($l =~ /^\s*:?(\d+)\s*:\s*(\S.*?)\s*$/) {
                        print { $pipe } join("\t", '__xs__', $c->{name}, $1, $2), "\n";
                    }
                    next;
                }
                if ($in_xpra) {
                    # `xpra list` lines like:  "\tLIVE session at :20"
                    # Dedup happens parent-side via the row hash.
                    if ($line =~ /\bLIVE session at\s+(:\d+)\b/) {
                        print { $pipe } join("\t", '__xpra__', $c->{name}, $1), "\n";
                    }
                    next;
                }
                if ($line =~ /^#\s*host:\s*(\S*)\s+id:\s*(\S*)/) {
                    print { $pipe } join("\t", '__id', $c->{name}, $1, $2), "\n";
                } elsif ($line =~ /^(:\d+)\s*$/) {
                    $disp = $1;
                } elsif (defined $disp
                         # show-x11 emits `printf("%s  %8s %-8s %s\n", ...)`
                         # — pid is right-justified in 8 cols and the USER
                         # field is exactly 8 cols, *all spaces if blank*.
                         # Greedy `(\S+)` would otherwise eat the command's
                         # first token as the user.
                         && $line =~ /^\s+(\d+) (.{8}) (.+?)\s*$/) {
                    my ($pid, $user, $cmd) = ($1, $2, $3);
                    $user =~ s/^\s+|\s+$//g;
                    print { $pipe } join("\t", $c->{name}, $disp, $pid, $user, $cmd), "\n";
                }
            }
            close $oh;
        }
        # POSIX::_exit, not exit — Tk loaded in parent for the picker
        # leaves an END handler that closes the (shared) X11 fd; running
        # it from the forked child segfaults the parent.
        POSIX::_exit(0);
    }
    $pipe->reader;
    $sel->add($pipe);
    $pid_for{$pid} = $pipe;
}

my @rows;
my %xpra_listed;     # "$host\t$disp" -> 1 (display reported by `xpra list`)
my %vnc_ports;       # "$host\t$disp_n" -> port (VNC port from ss/netstat)
my %any_displays;    # "$host\t$disp_n" -> user (from /tmp/.X11-unix stat)
my @psvnc;           # [{host, disp_n, port, user}, ...] (from ps VNC scan)
my @psxpra;          # [{host, disp_n, user}, ...] (from ps xpra scan)
my %vnc_users;       # "$host\t$user" -> 1 (users running a VNC server)
my %remote_id;       # candidate-name -> machine-id (from `show-x11 -id`)
my %remote_host;     # candidate-name -> remote `hostname`
my %xs_for_host;     # candidate-name -> [ {disp_n, cmd}, ... ]
my %buf;
my $deadline = time + $overall_to;
while ($sel->count) {
    my $remain = $deadline - time;
    last if $remain <= 0;
    my @ready = $sel->can_read($remain);
    last unless @ready;
    for my $h (@ready) {
        my $n = sysread($h, my $chunk, 4096);
        if (!$n) { $sel->remove($h); close $h; next }
        $buf{0+$h} .= $chunk;
        while ($buf{0+$h} =~ s/^([^\n]*)\n//) {
            my $line = $1;
            if ($line =~ /^__id\t([^\t]*)\t([^\t]*)\t([^\t]*)$/) {
                $remote_host{$1} = $2;
                $remote_id{$1}   = $3;
            } elsif ($line =~ /^__xpra__\t([^\t]*)\t([^\t]*)$/) {
                $xpra_listed{"$1\t$2"} = 1;
            } elsif ($line =~ /^__xs__\t([^\t]*)\t([^\t]*)\t([^\t]*)$/) {
                push @{ $xs_for_host{$1} },
                    { disp_n => $2 + 0, cmd => $3 };
            } elsif ($line =~ /^__vnc__\t([^\t]*)\t([^\t]*)\t([^\t]*)$/) {
                $vnc_ports{"$1\t$2"} = $3 + 0;
            } elsif ($line =~ /^__disp__\t([^\t]*)\t([^\t]*)\t([^\t]*)$/) {
                $any_displays{"$1\t$2"} = $3;
            } elsif ($line =~ /^__psvnc__\t/) {
                my @f = split /\t/, $line;
                if (length $f[2]) {
                    push @psvnc, { host => $f[1], disp_n => $f[2]+0,
                                   port => (length $f[3] ? $f[3]+0 : undef),
                                   user => $f[4] };
                }
                $vnc_users{"$f[1]\t$f[4]"} = 1 if defined $f[4];
            } elsif ($line =~ /^__psxpra__\t([^\t]*)\t([^\t]*)\t([^\t]*)$/) {
                push @psxpra, { host => $1, disp_n => $2+0, user => $3 };
            } else {
                my @f = split /\t/, $line, 5;
                push @rows, \@f if @f == 5;
            }
        }
    }
}
_dbg("[debug] parent: select-loop done, "
     . scalar(@rows) . " rows, "
     . scalar(keys %xpra_listed) . " xpra-listed, "
     . scalar(keys %vnc_ports) . " vnc-ports");
# Kill stragglers — TERM first, brief grace, then KILL so a stuck ssh
# can't leave the parent waiting indefinitely for the kernel to reap.
for my $pid (keys %pid_for) {
    kill 'TERM', $pid if waitpid($pid, POSIX::WNOHANG()) == 0;
}
my $kdeadline = time + 1;
for my $pid (keys %pid_for) {
    while (waitpid($pid, POSIX::WNOHANG()) == 0 && time < $kdeadline) {
        select undef, undef, undef, 0.05;
    }
    if (waitpid($pid, POSIX::WNOHANG()) == 0) {
        kill 'KILL', $pid;
        waitpid($pid, 0);
    }
}

# Dedupe aliased hosts: every show-x11 -id call printed `# host: H id: M`
# from /etc/machine-id.  Hosts sharing a machine-id are aliases for the
# same physical box (e.g. nas3-up / nas3-down on different NICs).  Pick
# the remote-reported hostname as canonical when available; otherwise
# the candidate name with no dashes / shortest.
{
    my %hosts_by_id;
    push @{ $hosts_by_id{$remote_id{$_}} }, $_
        for grep { defined $remote_id{$_} && length $remote_id{$_} } keys %remote_id;

    my %canonical;
    for my $id (keys %hosts_by_id) {
        my @group = @{ $hosts_by_id{$id} };
        next unless @group > 1;
        my $canon;
        # Prefer the host's own self-reported name if any group member
        # reported one (and it's reachable in this run).
        for my $h (@group) {
            if (defined $remote_host{$h} && length $remote_host{$h}) {
                $canon = $remote_host{$h};
                last;
            }
        }
        $canon //= (sort {
               (($a =~ /-/ ? 1 : 0) <=> ($b =~ /-/ ? 1 : 0))
            || (length($a) <=> length($b))
            || ($a cmp $b)
        } @group)[0];
        $canonical{$_} = $canon for @group;
    }
    if (%canonical) {
        $_->[0] = $canonical{$_->[0]} // $_->[0] for @rows;
        my %relabelled;
        for my $key (keys %xpra_listed) {
            my ($h, $d) = split /\t/, $key, 2;
            my $h2 = $canonical{$h} // $h;
            $relabelled{"$h2\t$d"} = 1;
        }
        %xpra_listed = %relabelled;
        my %xs_relabelled;
        for my $h (keys %xs_for_host) {
            my $h2 = $canonical{$h} // $h;
            push @{ $xs_relabelled{$h2} }, @{ $xs_for_host{$h} };
        }
        %xs_for_host = %xs_relabelled;
        my %vnc_relabelled;
        for my $key (keys %vnc_ports) {
            my ($h, $d) = split /\t/, $key, 2;
            my $h2 = $canonical{$h} // $h;
            $vnc_relabelled{"$h2\t$d"} = $vnc_ports{$key};
        }
        %vnc_ports = %vnc_relabelled;
        for my $v (@psvnc) {
            $v->{host} = $canonical{$v->{host}} // $v->{host};
        }
        for my $v (@psxpra) {
            $v->{host} = $canonical{$v->{host}} // $v->{host};
        }
        my %vu_relabelled;
        for my $key (keys %vnc_users) {
            my ($h, $u) = split /\t/, $key, 2;
            my $h2 = $canonical{$h} // $h;
            $vu_relabelled{"$h2\t$u"} = 1;
        }
        %vnc_users = %vu_relabelled;
        my %ad_relabelled;
        for my $key (keys %any_displays) {
            my ($h, $d) = split /\t/, $key, 2;
            my $h2 = $canonical{$h} // $h;
            $ad_relabelled{"$h2\t$d"} = $any_displays{$key};
        }
        %any_displays = %ad_relabelled;
    }
}

# Aggregate process rows into one entry per (host, display).
my %ip_for_name    = map { _name_for($_) => $_->{ip}       } @candidates;
my %local_for_name = map { _name_for($_) => $_->{local}    } @candidates;
my %user_for_name  = map { _name_for($_) => $_->{ssh_user} } @candidates;
my %by_session;       # "$host\t$disp" -> { host, disp, kind, user, cmds, n }
# Seed sessions reported by `xpra list` first — that way an xpra session
# with no surviving show-x11 procs (or no apps at all) still appears.
# User is seeded with whoever we logged in as: $ENV{USER} for the local
# probe, the per-candidate ssh-config-resolved user for remote probes
# (or $ssh_user / $ENV{USER} as fallbacks).
for my $key (keys %xpra_listed) {
    my ($host, $disp) = split /\t/, $key, 2;
    my $is_local = $local_for_name{$host};
    my $user_seed = $is_local
        ? ($ENV{USER} // '')
        : ($ssh_user // $user_for_name{$host} // $ENV{USER} // '');
    $by_session{$key} = { host=>$host, disp=>$disp, user=>$user_seed,
                          cmds=>[], procs=>[], n=>0, kind=>'xpra',
                          xpra_listed=>1 };
}
for my $key (keys %vnc_ports) {
    my ($host, $disp_n) = split /\t/, $key, 2;
    my $disp = ":$disp_n";
    my $sess_key = "$host\t$disp";
    if (my $existing = $by_session{$sess_key}) {
        $existing->{kind} = 'vnc' unless $existing->{kind} eq 'xpra';
        $existing->{vnc_port} //= $vnc_ports{$key};
        next;
    }
    my $is_local = $local_for_name{$host};
    my $user_seed = $is_local
        ? ($ENV{USER} // '')
        : ($ssh_user // $user_for_name{$host} // $ENV{USER} // '');
    $by_session{$sess_key} = { host=>$host, disp=>$disp, user=>$user_seed,
                               cmds=>[], procs=>[], n=>0, kind=>'vnc',
                               vnc_port=>$vnc_ports{$key} };
}
for my $key (keys %any_displays) {
    my ($host, $disp_n) = split /\t/, $key, 2;
    my $disp = ":$disp_n";
    my $sess_key = "$host\t$disp";
    my $owner  = $any_displays{$key};
    my $is_vnc = $vnc_ports{"$host\t$disp_n"} ? 1 : 0;
    if (my $existing = $by_session{$sess_key}) {
        $existing->{user} = $owner;
        if ($is_vnc) {
            $existing->{kind} = 'vnc' unless $existing->{kind} eq 'xpra';
            $existing->{vnc_port} //= 5900 + $disp_n;
        }
        next;
    }
    my $kind_default = $is_vnc      ? 'vnc'
                     : $disp_n == 0 ? 'X'
                     :                'xpra';
    $by_session{$sess_key} = { host=>$host, disp=>$disp, user=>$owner,
                               cmds=>[], procs=>[], n=>0, kind=>$kind_default,
                               ($is_vnc ? (vnc_port => 5900 + $disp_n) : ()) };
}
for my $v (@psvnc) {
    my $disp = ":$v->{disp_n}";
    my $sess_key = "$v->{host}\t$disp";
    if (my $existing = $by_session{$sess_key}) {
        $existing->{kind} = 'vnc' unless $existing->{kind} eq 'xpra';
        $existing->{vnc_port} //= $v->{port} if defined $v->{port};
        $existing->{user} = $v->{user} if defined $v->{user} && length $v->{user};
        next;
    }
    $by_session{$sess_key} = { host=>$v->{host}, disp=>$disp, user=>$v->{user},
                               cmds=>[], procs=>[], n=>0, kind=>'vnc',
                               vnc_port=>$v->{port} };
}
for my $v (@psxpra) {
    my $disp = ":$v->{disp_n}";
    my $sess_key = "$v->{host}\t$disp";
    if (my $existing = $by_session{$sess_key}) {
        $existing->{kind} //= 'xpra';
        $existing->{user} = $v->{user} if defined $v->{user} && length $v->{user};
        next;
    }
    $by_session{$sess_key} = { host=>$v->{host}, disp=>$disp, user=>$v->{user},
                               cmds=>[], procs=>[], n=>0, kind=>'xpra' };
}
for my $r (@rows) {
    my ($host, $disp, $pid, $user, $cmd) = @$r;
    my $key = "$host\t$disp";
    # Default kind by display number: <:20 is presumed plain X, :20+ is
    # presumed xpra.  Overridden to 'xpra' for displays `xpra list`
    # confirmed.
    my ($n) = $disp =~ /^:(\d+)$/;
    my $kind_default = (defined $n && $n >= 20) ? 'xpra' : 'X';
    my $s = $by_session{$key} //= { host=>$host, disp=>$disp, user=>$user,
                                     cmds=>[], procs=>[], n=>0, kind=>$kind_default };
    $s->{kind} = 'xpra' if $xpra_listed{$key};
    # Prefer a non-empty user — some procs (eg. pulseaudio in xpra
    # sessions) report no USER and would otherwise lock in the session
    # owner as ''.
    $s->{user} = $user if length $user && !length $s->{user};
    $s->{n}++;
    push @{ $s->{procs} }, { pid => $pid, user => $user, cmd => $cmd };
    # Drop session-plumbing daemons; keep candidate "main apps" with args.
    next if $cmd =~ m{\b(?:dbus-daemon|dbus-launch|dconf-service|gvfsd|gvfs-?\S*|xdg-\S+|ibus-\S+|pulseaudio|gnome-keyring|at-spi\S*|xpra/?\S*daemonizer|sleep)\b};
    next if $cmd =~ m{/sbin/init|/lib/systemd|cron|sshd|mate-session|lxsession};
    # Drop sub-process helpers spawned by the main app.  The user-launched
    # firefox/chrome/electron we want is the parent — its forked children
    # carry -contentproc / --type=renderer-style flags.
    next if $cmd =~ m{(?:crashhelper|-helper\b|RemoteSandbox|GMPProcess|NetworkBroker|content-process)};
    next if $cmd =~ m{\s-contentproc\b|\s--type=\S};
    # X / VNC servers are session infrastructure, not user-launched apps.
    # Tag the session as VNC when we spot a VNC server process.
    if ($cmd =~ m{^(?:\S*/)?(?:Xvnc|Xtightvnc|x11vnc|Xtigervnc|krfb|vino-server|tigervncserver)\b}) {
        $s->{kind} = 'vnc' unless $s->{kind} eq 'xpra';
        $s->{vnc_port} //= 5900 + $n if defined $n;
    }
    $s->{vnc_port} //= $vnc_ports{"$host\t$n"} if defined $n;
    next if $cmd =~ m{^(?:\S*/)?(?:Xvnc|Xtightvnc|x11vnc|Xvfb|Xorg|Xtigervnc|krfb|vino-server|tigervncserver)\b};
    push @{ $s->{cmds} }, $cmd;
}

# Pick the "main app" cmdline for each session.  Heuristic:
#   1. Prefer cmds that aren't just a bare interactive shell.
#   2. Among the rest, prefer the one with the most arguments — a user-
#      invoked app like `thunderbird -P Calendar` carries args, while a
#      window-manager / wrapper typically doesn't.
#   3. Fall back to the first command if everything's a shell.
# Known GUI applications — always beat generic / shell / network tools.
my %gui_app = map { $_ => 1 } qw(
    firefox firefox-bin firefox-esr iceweasel
    chromium chromium-browser google-chrome chrome brave brave-browser
    qutebrowser nyxt epiphany
    thunderbird
    code codium vscodium electron
    libreoffice soffice loimpress lowriter localc
    gimp inkscape blender krita
    audacity vlc mpv totem
    discord slack signal-desktop telegram-desktop element-desktop zoom
    keepassxc gnumeric abiword
    emacs gvim
);

sub _argv0_basename {
    my ($cmd) = @_;
    my ($a) = $cmd =~ /^(\S+)/;
    return '' unless defined $a;
    $a =~ s{^.*/}{};
    return $a;
}

sub _main_cmd {
    my @cmds = @_;
    return '' unless @cmds;
    # Drop bare interactive shells with no args.
    my @nonshell = grep {
        $_ !~ m{^(?:/usr|/bin)?/?(?:bin/)?(?:bash|sh|csh|tcsh|zsh|ksh|fish)\s*(?:-\S+\s*)*$}
    } @cmds;
    @nonshell = @cmds unless @nonshell;
    # Tier 1: known GUI apps (firefox, thunderbird, code, ...) always
    # beat ssh, vim-in-xterm, generic invocations, etc.  Among multiple
    # GUI apps, longest invocation wins.
    my @gui = grep { $gui_app{ _argv0_basename($_) } } @nonshell;
    if (@gui) {
        return (sort { (() = $b =~ /\s\S/g) <=> (() = $a =~ /\s\S/g)
                    || length($b) <=> length($a) } @gui)[0];
    }
    # De-prioritize shell -c wrappers — the user's "main app" is usually
    # whatever a real GUI binary is, not the wrapping `sh -c '...'`.
    my @shellc  = grep {  m{^(?:/usr|/bin)?/?(?:bin/)?(?:ba|c|t|z|k)?sh\s+-c\b} } @nonshell;
    my @primary = grep { !m{^(?:/usr|/bin)?/?(?:bin/)?(?:ba|c|t|z|k)?sh\s+-c\b} } @nonshell;
    my @ranked  = @primary ? @primary : @shellc;
    # Pick the entry with the most arg tokens (longest user invocation).
    return (sort { (() = $b =~ /\s\S/g) <=> (() = $a =~ /\s\S/g)
                || length($b) <=> length($a) } @ranked)[0];
}

# Format the main cmd for display: basename + args, capped.
sub _fmt_cmd {
    my ($cmd, $max) = @_;
    return '(daemons only)' unless length $cmd;
    my ($argv0, $rest) = split /\s+/, $cmd, 2;
    $argv0 =~ s{^.*/}{};
    my $out = defined $rest && length $rest ? "$argv0 $rest" : $argv0;
    $out =~ s/\s+$//;
    $out = substr($out, 0, $max - 3) . '...' if length($out) > $max;
    return $out;
}

my @sessions = values %by_session;

# Stamp each session with an IP (looked up from candidates by name) and a
# numeric display.  Drop displays under :20 unless --all was given —
# they're presumed plain X (see kind heuristic above).
for my $s (@sessions) {
    ($s->{disp_n}) = $s->{disp} =~ /^:(\d+)/;
    $s->{ip}       = $ip_for_name{$s->{host}};
    $s->{local}    = $local_for_name{$s->{host}} ? 1 : 0;
}
# --host fallback: if a manually-added host produced no sessions, offer :0.
{
    my %seen_host = map { $_->{host} => 1 } @sessions;
    for my $c (grep { $_->{_extra} } @candidates) {
        my $name = _name_for($c);
        next if $seen_host{$name};
        push @sessions, { host => $name, disp => ':0', disp_n => 0,
                          ip => $c->{ip}, local => 0, kind => 'X',
                          user => $ssh_user // $user_for_name{$name} // $ENV{USER} // '',
                          cmds => [], procs => [], n => 0,
                          apps => '(root display)', _extra => 1 };
    }
}
unless ($all || $any) {
    @sessions = grep {
        $_->{kind} eq 'vnc' || $_->{_extra}
        || (defined $_->{disp_n} && $_->{disp_n} >= 20 && $_->{disp_n} <= 1000)
    } @sessions;
}
if (defined $user && !$any) {
    @sessions = grep { defined $_->{user} && $_->{user} eq $user } @sessions;
}

# If a host published a ~/.xpra-start file, pivot the picker to its
# entries.  For each line we either:
#   - reuse the live session detected at that display, or
#   - synthesize a stub session if nothing's running there yet,
# then mark _xs_running based on whether a process matching the
# expected command is observed on that display.  Sessions detected on
# the host but absent from .xpra-start are dropped — the start file is
# the source of truth when present.
for my $host (keys %xs_for_host) {
    my @entries = @{ $xs_for_host{$host} };
    next unless @entries;
    my @host_existing = grep { $_->{host} eq $host } @sessions;
    my %by_disp = map { $_->{disp_n} => $_ } @host_existing;
    my $h_local  = $host_existing[0] && $host_existing[0]{local};
    my $h_ip     = $local_for_name{$host} ? '127.0.0.1' : $ip_for_name{$host};
    my $h_user   = $local_for_name{$host}
                 ? ($ENV{USER} // '')
                 : ($ssh_user // $user_for_name{$host} // $ENV{USER} // '');
    my @new;
    for my $e (@entries) {
        my $existing = $by_disp{$e->{disp_n}};
        my $base = lc(_argv0_basename($e->{cmd}));
        my $running = 0;
        if ($existing && length $base) {
            for my $p (@{ $existing->{procs} }) {
                if (index(lc(_argv0_basename($p->{cmd})), $base) >= 0
                 || index(lc($p->{cmd}), $base) >= 0) {
                    $running = 1;
                    last;
                }
            }
        }
        my $s = $existing // {
            host        => $host,
            disp        => ":$e->{disp_n}",
            disp_n      => $e->{disp_n},
            kind        => 'xpra',
            user        => $h_user,
            n           => 0,
            cmds        => [],
            procs       => [],
            xpra_listed => 0,
            local       => $h_local ? 1 : 0,
            ip          => $h_ip,
        };
        $s->{apps}        = $e->{cmd};
        $s->{_xs_cmd}     = $e->{cmd};
        $s->{_xs_running} = $running;
        push @new, $s;
    }
    my %new_disp = map { $_->{disp_n} => 1 } @new;
    @sessions = grep {
        $_->{host} ne $host
        || (($_->{user} // '') ne $h_user)
        || ($_->{kind} eq 'vnc' && !$new_disp{$_->{disp_n}})
    } @sessions;
    push @sessions, @new;
}

# --- probe other users' ~/.xpra-start (--any) --------------------------------
# SSH as each other user to grab their intended-sessions file, then merge
# into @sessions.  Blue = running, grey = not running.
if ($any) {
    my $own_user = $ssh_user // $ENV{USER} // '';
    my %to_probe;
    for my $s (@sessions) {
        next unless defined $s->{user} && length $s->{user};
        next if $s->{user} eq $own_user;
        next if $s->{kind} eq 'vnc';
        $to_probe{"$s->{host}\t$s->{user}"} //= {
            host => $s->{host}, user => $s->{user},
            ip => $s->{ip}, local => $s->{local},
        };
    }
    if (%to_probe) {
        _keys_ensure();
        my $sel2 = IO::Select->new;
        my %pid2;
        for my $key (keys %to_probe) {
            my $info = $to_probe{$key};
            my $pipe = IO::Pipe->new;
            my $pid  = fork;
            die "fork: $!" unless defined $pid;
            if (!$pid) {
                $pipe->writer;
                $pipe->autoflush(1);
                open STDERR, '>', '/dev/null' unless $debug;
                POSIX::setsid();
                open STDIN, '<', '/dev/null';
                $SIG{ALRM} = sub { POSIX::_exit(1) };
                alarm(10);
                my @sopts = (
                    '-o', "ConnectTimeout=$ssh_to",
                    '-o', 'StrictHostKeyChecking=accept-new',
                    '-o', 'ServerAliveInterval=3',
                    '-o', 'ServerAliveCountMax=2',
                );
                my $ukey = $SETTINGS->{_user_keys}{$info->{user}};
                push @sopts, '-i', $ukey if defined $ukey && length $ukey;
                if ($no_prompt) {
                    push @sopts, '-o', 'BatchMode=yes',
                        '-o', 'NumberOfPasswordPrompts=0',
                        '-o', 'PreferredAuthentications=publickey';
                }
                my $login = "$info->{user}\@$info->{host}";
                if (defined $info->{ip} && $info->{ip} ne $info->{host}) {
                    push @sopts, '-o', "HostName=$info->{ip}";
                }
                my @cmd = ('ssh', @sopts, $login, 'cat ~/.xpra-start');
                _dbg("[debug] xs-other: ", join(' ', @cmd));
                if (open my $oh, '-|', @cmd) {
                    while (<$oh>) {
                        chomp;
                        (my $l = $_) =~ s/#.*//;
                        next if $l =~ /^\s*$/;
                        if ($l =~ /^\s*:?(\d+)\s*:\s*(\S.*?)\s*$/) {
                            print {$pipe} join("\t",
                                $info->{host}, $info->{user}, $1, $2), "\n";
                        }
                    }
                    close $oh;
                }
                POSIX::_exit(0);
            }
            $pipe->reader;
            $sel2->add($pipe);
            $pid2{$pid} = $pipe;
        }
        my %xs_other;
        my %buf2;
        my $deadline2 = time + 10;
        while ($sel2->count) {
            my $remain = $deadline2 - time;
            last if $remain <= 0;
            my @ready = $sel2->can_read($remain);
            last unless @ready;
            for my $h (@ready) {
                my $n = sysread($h, my $chunk, 4096);
                if (!$n) { $sel2->remove($h); close $h; next }
                $buf2{0+$h} .= $chunk;
                while ($buf2{0+$h} =~ s/^([^\n]*)\n//) {
                    my ($host, $xu, $dn, $cmd) = split /\t/, $1, 4;
                    push @{ $xs_other{"$host\t$xu"} },
                        { disp_n => $dn + 0, cmd => $cmd };
                }
            }
        }
        for my $pid (keys %pid2) {
            kill 'TERM', $pid if waitpid($pid, POSIX::WNOHANG()) == 0;
        }
        my $kd = time + 1;
        for my $pid (keys %pid2) {
            while (waitpid($pid, POSIX::WNOHANG()) == 0 && time < $kd) {
                select undef, undef, undef, 0.05;
            }
            kill('KILL', $pid), waitpid($pid, 0)
                if waitpid($pid, POSIX::WNOHANG()) == 0;
        }
        _dbg("[debug] xs-other: " . scalar(keys %xs_other) . " users responded");

        my %existing_disp;
        for my $s (@sessions) {
            $existing_disp{"$s->{host}\t$s->{disp_n}"} = $s;
        }
        for my $key (keys %xs_other) {
            my ($host, $xu) = split /\t/, $key, 2;
            for my $e (@{ $xs_other{$key} }) {
                my $dk = "$host\t$e->{disp_n}";
                my $existing = $existing_disp{$dk};
                my $running = $existing ? 1 : 0;
                my $s = $existing // {
                    host    => $host,
                    disp    => ":$e->{disp_n}",
                    disp_n  => $e->{disp_n},
                    kind    => 'xpra',
                    user    => $xu,
                    n       => 0,
                    cmds    => [],
                    procs   => [],
                    local   => $local_for_name{$host} ? 1 : 0,
                    ip      => $ip_for_name{$host},
                };
                $s->{apps}            = $e->{cmd};
                $s->{_xs_cmd}         = $e->{cmd};
                $s->{_xs_running}     = $running;
                $s->{_xs_other_user}  = 1;
                $s->{_attach_as}      = $xu;
                $s->{user}            = $xu;
                unless ($existing) {
                    push @sessions, $s;
                    $existing_disp{$dk} = $s;
                }
            }
        }
    }
}

@sessions = sort {
       ($b->{local}//0) <=> ($a->{local}//0)
    || $a->{host} cmp $b->{host}
    || $a->{disp_n} <=> $b->{disp_n}
} @sessions;

# Build display rows: pick a main cmd and format it.  An xpra-listed
# session with no surviving non-daemon procs reads as "(empty xpra)" so
# the user can still attach to it.  Rows sourced from a remote
# ~/.xpra-start are exempt — their apps text is the user's intended
# command, regardless of what's actually running on the display.
for my $s (@sessions) {
    next if defined $s->{_xs_cmd};
    next if $s->{_extra} && defined $s->{apps};
    my $main = _main_cmd(@{ $s->{cmds} });
    my $own_user = $ssh_user // $ENV{USER} // '';
    my $other_user = $any && defined $s->{user} && length $s->{user}
                   && $s->{user} ne $own_user;
    if ($other_user) {
        $s->{_attach_as} = $s->{user};
    }
    $s->{apps} = length $main           ? _fmt_cmd($main, 60)
               : $s->{xpra_listed}      ? '(empty xpra)'
               : $s->{kind} eq 'vnc'    ? '(vnc)'
               : $other_user            ? '(login required)'
               :                          '(daemons only)';
}

# Drop sessions whose only contents are session plumbing (no real app to
# attach to).  Keep xpra-listed and vnc sessions even if empty — the user
# might specifically want to attach.  --all/--any keeps everything.
unless ($all || $any) {
    @sessions = grep {
        $_->{apps} ne '(daemons only)' || $_->{kind} eq 'vnc'
    } @sessions;
}

# Cache successful probe results per host so the next picker run shows
# "[N sess Tm ago]" labels — useful when ssh isn't working today.  Only
# update on positive results (>0 sessions); a transient failure shouldn't
# erase a known-good entry.
{
    my %sess_count;
    $sess_count{$_->{host}}++ for @sessions;
    my $changed;
    for my $host (keys %sess_count) {
        $CACHE->{$host} = { ts => time, n_sessions => $sess_count{$host} };
        $changed = 1;
    }
    _save_cache() if $changed;
}

_dbg("[debug] parent: " . scalar(@sessions) . " sessions ready, "
     . ($list_only ? '--list mode' : 'about to open Tk chooser'));

unless (@sessions) {
    if ($list_only) { print STDERR "no X11/xpra/VNC sessions found\n"; exit 1 }
    my $mw = _tk_mw();
    $mw->title('find-xpra');
    $mw->deiconify;
    $mw->Label(-text => 'No X11/xpra/VNC sessions found.', -padx => 30, -pady => 30)
       ->pack;
    # Destroy the window so MainLoop returns cleanly, then exit at
    # the script level — calling `exit` directly from inside a Tk
    # callback unwinds Perl while MainLoop is still on the stack and
    # Tk's END handler then segfaults tearing down a half-live UI.
    $mw->Button(-text => 'Close', -command => sub { $mw->destroy })
       ->pack(-pady => 6);
    Tk::MainLoop();
    exit 1;
}

if ($list_only) {
    printf "%-16s %-6s %-5s %-8s %-4s %s\n",
        'HOST','DISP','KIND','USER','PROC','APPS';
    for my $s (@sessions) {
        printf "%-16s %-6s %-5s %-8s %-4d %s\n",
            $s->{host}, $s->{disp}, $s->{kind}, $s->{user}, $s->{n}, $s->{apps};
    }
    exit 0;
}

# --- adopt pre-existing viewer processes -----------------------------------
# Scan for running xpra-attach / vncviewer processes so the UI shows them
# as already connected.  These are not our children (spawned by a prior
# find-xpra instance or manually), so we track them with kill(0) instead
# of waitpid.

sub _scan_attached {
    my @found;
    open my $h, '-|', 'ps', '-eo', 'pid,args' or return [];
    while (<$h>) {
        s/^\s+//;
        my ($pid, $cmd) = /^(\d+)\s+(.+)/ or next;
        $pid += 0;
        next if $pid == $$;
        if ($cmd =~ /\bxpra\b.*\battach\b.*\bssh:\/\/(?:\S+@)?([^\s\/]+)\/(\d+)\b/) {
            push @found, { pid => $pid, type => 'xpra', host => $1, disp_n => $2 + 0 };
        }
        elsif ($cmd =~ /\bxpra\b.*\battach\b.*\s:(\d+)\s*$/) {
            push @found, { pid => $pid, type => 'xpra', local => 1, disp_n => $1 + 0 };
        }
        elsif ($cmd =~ /\bvncviewer\s+localhost:(\d+)\s*$/ && $1 < 100) {
            push @found, { pid => $pid, type => 'vnc', local => 1, disp_n => $1 + 0 };
        }
        elsif ($cmd =~ /\bvncviewer\s+localhost::(\d+)\b/ && $1 >= 15900) {
            push @found, { pid => $pid, type => 'vnc', disp_n => $1 - 15900, cmd => $cmd };
        }
    }
    close $h;
    return \@found;
}

{
    my $found = _scan_attached();
    _dbg("[debug] adopt: " . scalar(@$found) . " viewer processes found");
    for my $s (@sessions) {
        my $dn = $s->{disp_n} // next;
        for my $f (@$found) {
            next unless $f->{disp_n} == $dn;
            my $match = 0;
            if ($f->{type} eq 'xpra' && $s->{kind} ne 'vnc') {
                $match = 1 if  $s->{local} &&  $f->{local};
                $match = 1 if !$s->{local} && !$f->{local}
                           && defined $f->{host} && $f->{host} eq $s->{host};
            }
            elsif ($f->{type} eq 'vnc' && $s->{kind} eq 'vnc') {
                $match = 1 if  $s->{local} &&  $f->{local};
                $match = 1 if !$s->{local} && !$f->{local}
                           && defined $f->{cmd} && $f->{cmd} =~ /\Q$s->{host}\E/;
            }
            if ($match) {
                $s->{pid} = $f->{pid};
                $s->{_adopted} = 1;
                _dbg("[debug] adopt: $s->{host} $s->{disp} -> pid $f->{pid}");
                last;
            }
        }
    }
}

# --- pop up Tk chooser ----------------------------------------------------
#
# A row per session, with an [Attach] button at the end of each row.
# Clicking [Attach] fires `xpra attach …` as a detached child and leaves
# the window up so several sessions can be attached.  Closing the window
# (regular decoration) ends the program.

sub _ask_host {
    my ($parent) = @_;
    my $dlg = $parent->Toplevel(-title => 'Add host');
    $dlg->transient($parent);
    $dlg->grab;
    $dlg->Label(-text => 'Hostname or IP:')->pack(-padx => 8, -pady => [8,4]);
    my $val = '';
    my $entry = $dlg->Entry(-textvariable => \$val, -width => 30);
    $entry->pack(-padx => 8);
    $entry->focus;
    my $ok;
    my $submit = sub { $ok = 1; $dlg->destroy };
    $entry->bind('<Return>', $submit);
    my $bf = $dlg->Frame->pack(-pady => 8);
    $bf->Button(-text => 'OK',     -command => $submit)
       ->pack(-side => 'left', -padx => 4);
    $bf->Button(-text => 'Cancel', -command => sub { $dlg->destroy })
       ->pack(-side => 'left', -padx => 4);
    $dlg->waitWindow;
    $val =~ s/^\s+|\s+$//g;
    return $ok ? $val : undef;
}

_dbg("[debug] parent: requiring Tk for chooser");
my $mw = _tk_mw();
_dbg("[debug] parent: MainWindow created");
$mw->title('find-xpra: attach to X11 session');
$mw->deiconify;
my @cols = ('Host', 'Display', 'Kind', 'User', 'Apps', '', '');

# Rescan: re-exec self with the same args.  Discovery runs again and the
# UI rebuilds.  In-flight xpra-attach children are setsid'd so they
# survive the exec; their Disconnect tracking is lost (close the viewer
# via xpra's own UI in that case).
my $header_f = $mw->Frame->grid(-row => 0, -column => 0,
                                -columnspan => scalar(@cols),
                                -sticky => 'ew', -padx => 6, -pady => 4);
$header_f->Button(-text => 'Rescan',
                  -command => sub { exec { $^X } $^X, $0, @ORIG_ARGV })
         ->pack(-side => 'left', -fill => 'x', -expand => 1);
$header_f->Button(-text => 'Add host',
                  -command => sub {
                      my $host = _ask_host($mw);
                      return unless defined $host && length $host;
                      exec { $^X } $^X, $0, @ORIG_ARGV, '--host', $host;
                  })
         ->pack(-side => 'left', -fill => 'x', -expand => 1);
# Global default DPI — passed to `xpra attach --dpi=N` for every session
# unless the host's Settings dialog overrides it.  Blank means "let xpra
# auto-detect" (the historical behaviour).  Saved on FocusOut / Return.
$header_f->Label(-text => 'Default DPI:')
         ->pack(-side => 'left', -padx => [12, 4]);
my $default_dpi = $SETTINGS->{'*'}{dpi} // '';
my $dpi_entry = $header_f->Entry(-textvariable => \$default_dpi,
                                 -width   => 5,
                                 -justify => 'right')
                         ->pack(-side => 'left');
my $save_default_dpi = sub {
    $default_dpi =~ s/^\s+|\s+$//g;
    if (length $default_dpi && $default_dpi =~ /^\d+$/) {
        $SETTINGS->{'*'}{dpi} = $default_dpi + 0;
    } else {
        delete $SETTINGS->{'*'}{dpi};
        $default_dpi = '';
    }
    _save_settings($SETTINGS);
};
$dpi_entry->bind('<FocusOut>', $save_default_dpi);
$dpi_entry->bind('<Return>',   $save_default_dpi);

for my $i (0 .. $#cols) {
    $mw->Label(-text => $cols[$i], -font => 'sans-serif 11 bold',
               -relief => 'ridge', -padx => 6, -pady => 2)
       ->grid(-row => 1, -column => $i, -sticky => 'ew');
}
my $r = 2;
for my $s (@sessions) {
    my @vals = ($s->{host}, $s->{disp}, $s->{kind}, $s->{user}, $s->{apps});
    # When the row was sourced from a remote ~/.xpra-start, color it
    # green if the listed app appears to be running on its display, red
    # otherwise.  Plain detected sessions stay the default colour.
    my %fg;
    if (defined $s->{_xs_cmd}) {
        if ($s->{_xs_other_user}) {
            %fg = (-foreground => $s->{_xs_running} ? '#0055cc' : '#808080');
        } else {
            %fg = (-foreground => $s->{_xs_running} ? '#0a7d10' : '#c00000');
        }
    }
    for my $c (0 .. $#vals) {
        $mw->Label(-text => $vals[$c], -anchor => 'w', -padx => 6, %fg)
           ->grid(-row => $r, -column => $c, -sticky => 'ew');
    }
    my $sess = $s;     # closure capture
    # Action menu + Go button.  The dropdown reflects what's possible for
    # the session's current state — Attach when detached; Disconnect /
    # Force kill / KILL / Terminal when an xpra-attach child is alive
    # (Terminal would pop a window on a display nobody's viewing if we
    # offered it before attaching).  "Attach Browser" is appended to both
    # lists when the async HTML5-port probe (below) finds xpra-web open.
    my @ACTIONS_DETACHED = $sess->{kind} eq 'vnc'
        ? ('Attach', '---', 'Apps', 'Settings')
        : $sess->{kind} eq 'X'
        ? ('Connect as VNC', 'X11-VNC', '---', 'Settings')
        : ('Attach', 'Connect as VNC', 'X11-VNC',
           'Restart app', 'Restart Xpra', 'Restart Xpra with web',
           '---', 'Helper', 'Apps', 'Settings');
    my @ACTIONS_ATTACHED = $sess->{kind} eq 'vnc'
        ? ('Disconnect', 'Force kill', 'KILL',
           '---', 'Apps', 'Settings')
        : $sess->{kind} eq 'X'
        ? ('Disconnect', 'Force kill', 'KILL',
           '---', 'Settings')
        : ('Disconnect', 'Force kill', 'KILL', 'Terminal',
           'Connect as VNC', 'X11-VNC',
           'Restart app', 'Restart Xpra', 'Restart Xpra with web',
           '---', 'Helper', 'Apps', 'Settings');
    my $detached_default = $sess->{kind} eq 'X' ? 'Connect as VNC' : 'Attach';
    my $action = $detached_default;
    my $current_opts = \@ACTIONS_DETACHED;
    # Default-action helper: the menu reverts to this after any Go click
    # so the dropdown always shows the most likely next action for the
    # session's state, not the one the user just fired.
    my $default_action = sub {
        return $sess->{pid} ? 'Disconnect' : $detached_default;
    };
    my ($action_mb, $action_menu);
    # Rebuild the menu items for the currently displayed list.  When
    # $default is defined, also reset $action (state flip).  Without
    # $default, keep $action if still valid in the new list (used after
    # the browser probe appends "Attach Browser" mid-session).
    my $set_actions = sub {
        my ($opts, $default) = @_;
        $current_opts = $opts if defined $opts;
        $action_menu->delete(0, 'end');
        for my $o (@$current_opts) {
            if ($o eq '---') {
                $action_menu->add('separator');
                next;
            }
            my $val = $o;
            $action_menu->add('command', -label => $o,
                              -command => sub { $action = $val });
        }
        if (defined $default) {
            $action = $default;
        } elsif (!grep { $_ eq $action } @$current_opts) {
            $action = $current_opts->[0] // '';
        }
    };
    $action_mb = $mw->Menubutton(
        -textvariable => \$action,
        -indicatoron  => 1,
        -relief       => 'raised',
        -borderwidth  => 1,
        -anchor       => 'w',
        -width        => 21,
    );
    $action_menu = $action_mb->Menu(-tearoff => 0);
    $action_mb->configure(-menu => $action_menu);
    if ($sess->{pid}) {
        $set_actions->(\@ACTIONS_ATTACHED, 'Disconnect');
    } else {
        $set_actions->(\@ACTIONS_DETACHED, $detached_default);
    }
    # Escalating disconnect: xpra viewers occasionally ignore a plain TERM
    # (mid-handshake, stuck modal, hung ssh transport, ...) so the user
    # can step up explicitly via the menu — TERM pid, then TERM the whole
    # process group (ssh + xpra workers), then KILL the group.
    my $go_btn = $mw->Button(-text => "\x{25B6}",
        -command => sub {
            my $picked = $action;
            if ($picked eq 'Connect as VNC') {
                _keys_ensure() unless $sess->{local};
                my $pid = spawn_attach(_vnc_attach_cmd($sess));
                $sess->{pid} = $pid;
                $set_actions->(\@ACTIONS_ATTACHED, 'Disconnect');
                return;
            }
            if ($picked eq 'X11-VNC') {
                _keys_ensure() unless $sess->{local};
                my $pid = spawn_attach(_x11vnc_cmd($sess));
                $sess->{pid} = $pid;
                $set_actions->(\@ACTIONS_ATTACHED, 'Disconnect');
                return;
            }
            if ($picked eq 'Attach') {
                _keys_ensure() unless $sess->{local};
                my $pid = spawn_attach(
                    $sess->{kind} eq 'vnc'
                        ? _vnc_attach_cmd($sess)
                        : _attach_cmd($sess));
                $sess->{pid} = $pid;
                # State flip; $set_actions already resets $action to
                # 'Disconnect' (the new default) so no revert needed.
                $set_actions->(\@ACTIONS_ATTACHED, 'Disconnect');
                return;
            }
            if ($picked eq 'Attach Browser') {
                my $url = $sess->{_html_url};
                # Route through xpra-helper so the user's sticky/filter
                # rules pick the target session + browser profile instead
                # of dropping the URL on the local default handler.
                spawn_detached('xpra-helper', $url) if $url;
            }
            elsif ($picked eq 'Terminal') {
                _keys_ensure() unless $sess->{local};
                spawn_detached(_term_cmd($sess));
            }
            elsif ($picked eq 'Helper') {
                spawn_detached('xpra-helper', '--pin');
            }
            elsif ($picked eq 'Apps') {
                _show_procs($sess);
            }
            elsif ($picked eq 'Settings') {
                _show_settings($sess);
            }
            elsif ($picked eq 'Restart app'
                || $picked eq 'Restart Xpra'
                || $picked eq 'Restart Xpra with web') {
                _keys_ensure() unless $sess->{local};
                spawn_detached(_launch_xpra_cmd($sess, $picked));
            }
            elsif (my $pid = $sess->{pid}) {
                if ($picked eq 'Disconnect') {
                    kill 'TERM', $pid;
                    $action = 'Force kill';
                    $mw->after(2000, sub {
                        return unless $sess->{pid} && $sess->{pid} == $pid;
                        kill 'TERM', -$pid;
                        kill 'TERM',  $pid;
                        $action = 'KILL';
                        $mw->after(2000, sub {
                            return unless $sess->{pid} && $sess->{pid} == $pid;
                            kill 'KILL', -$pid;
                            kill 'KILL',  $pid;
                        });
                    });
                    return;
                }
                elsif ($picked eq 'Force kill') {
                    kill 'TERM', -$pid;
                    kill 'TERM',  $pid;
                }
                elsif ($picked eq 'KILL') {
                    kill 'KILL', -$pid;
                    kill 'KILL',  $pid;
                }
            }
            # Revert dropdown to the most-likely next action.  The reap
            # timer will later flip the whole list back to ACTIONS_DETACHED
            # if a kill succeeded.
            $action = $default_action->();
        });
    $action_mb->grid(-row => $r, -column => 5, -padx => 6, -pady => 1, -sticky => 'ew');
    $go_btn   ->grid(-row => $r, -column => 6, -padx => 6, -pady => 1, -sticky => 'ew');
    # Called by the html port-probe fileevent when xpra-web is reachable.
    # Mutates the action lists in place so future state flips also offer
    # the browser action; refreshes the visible menu without disturbing
    # the user's current selection.
    $sess->{_enable_browser} = sub {
        return if grep { $_ eq 'Attach Browser' } @ACTIONS_DETACHED;
        # Splice in right after the primary action so users don't have
        # to scroll past kill/restart entries to find it.
        splice(@ACTIONS_DETACHED, 1, 0, 'Attach Browser');
        splice(@ACTIONS_ATTACHED, 1, 0, 'Attach Browser');
        $set_actions->();
    };
    $sess->{_set_actions}      = $set_actions;
    $sess->{_actions_detached} = \@ACTIONS_DETACHED;
    $r++;
}

# Background HTML5-port probe.  We can't synchronously TCP-connect from
# the Tk thread without freezing the UI on closed/firewalled ports
# (1s × N), so a forked child does the probes serially and writes
# "host\tdisp_n\tport\tfound\n" back through a pipe.  Plain pipe() +
# typeglobs (rather than IO::Pipe) so Tk's fileevent has no doubt about
# what filehandle it's polling — empirically the IO::Pipe variant
# stayed silent.  sysread + line-buffer drain handles the "multiple
# lines arrived in one read" case (Smak Gotcha #11).
{
    pipe(my $html_r, my $html_w) or warn "find-xpra: html pipe: $!\n";
    # Snapshot every IPv4 we own so the probe can also try the real
    # interface for "local" sessions — xpra-web bound to a specific
    # NIC (eg 192.168.x.y) won't be reachable on 127.0.0.1.
    my @local_ips = sort grep {
        /^\d+\.\d+\.\d+\.\d+\z/ && !/^127\./
    } keys %{ _local_ips_set() };
    if ($html_r && $html_w) {
        my $html_kid = fork;
        if (!defined $html_kid) {
            warn "find-xpra: html probe fork: $!\n";
            close $html_r; close $html_w;
        } elsif ($html_kid == 0) {
            close $html_r;
            select((select($html_w), $|=1)[0]);
            POSIX::setsid();
            open STDIN, '<', '/dev/null';
            for my $s (@sessions) {
                next unless defined $s->{disp_n};
                my $port = 14500 + $s->{disp_n};
                # Try several addresses; the first to accept wins and
                # becomes the URL host.  Loopback first for local
                # sessions (covers xpra-web on 127.0.0.1); then the
                # session's IP and hostname (covers xpra-web bound to
                # a real interface, e.g. 192.168.x.y, even when the
                # session is "local" to find-xpra).
                my @addrs;
                if ($s->{local}) {
                    push @addrs, '127.0.0.1', @local_ips;
                }
                for my $a ($s->{ip}, $s->{host}) {
                    next unless defined $a && length $a;
                    push @addrs, $a unless grep { $_ eq $a } @addrs;
                }
                my $found = '';
                for my $addr (@addrs) {
                    my $sock = IO::Socket::INET->new(
                        PeerAddr => $addr, PeerPort => $port,
                        Proto => 'tcp', Timeout => 1);
                    if ($sock) { close $sock; $found = $addr; last }
                }
                _dbg("[debug] html: $s->{host} :$s->{disp_n} port=$port "
                   . "addrs=[@addrs] found=" . ($found // '-'));
                print $html_w
                    join("\t", $s->{host}, $s->{disp_n}, $port, $found), "\n";
            }
            close $html_w;
            POSIX::_exit(0);
        } else {
            close $html_w;
            my $buf = '';
            $mw->fileevent($html_r, 'readable', sub {
                my $n = sysread($html_r, my $chunk, 4096);
                if (!$n) {
                    $mw->fileevent($html_r, 'readable', '');
                    close $html_r;
                    waitpid($html_kid, 0);
                    _dbg("[debug] html: probe child reaped");
                    return;
                }
                $buf .= $chunk;
                while ($buf =~ s/^([^\n]*)\n//) {
                    my ($h, $d, $p, $found) = split /\t/, $1, 4;
                    _dbg("[debug] html: result host=$h disp=$d port=$p "
                       . "found=" . (defined $found && length $found ? $found : '-'));
                    next unless defined $found && length $found;
                    for my $s (@sessions) {
                        next unless $s->{host} eq $h
                                 && defined $s->{disp_n}
                                 && $s->{disp_n} == $d;
                        $s->{_html_url} = "https://$found:$p/";
                        $s->{_enable_browser}->() if $s->{_enable_browser};
                        _dbg("[debug] html: enabled browser action for "
                           . "$h :$d -> $s->{_html_url}");
                        last;
                    }
                }
            });
        }
    }
}

# Reap exited viewer processes so the UI flips back when the viewer closes
# on its own.  Try waitpid first — it handles both freshly spawned children
# AND children inherited through exec (Rescan).  For truly external
# processes (adopted from a different find-xpra PID), waitpid returns -1
# (ECHILD); fall back to kill(0) for those.
$mw->repeat(750, sub {
    for my $s (@sessions) {
        my $pid = $s->{pid} // next;
        my $r = waitpid($pid, POSIX::WNOHANG());
        my $gone = $r > 0              ? 1
                 : $r == 0             ? 0
                 : !kill(0, $pid);      # -1 (ECHILD): not our child
        if ($gone) {
            $s->{pid} = undef;
            $s->{_adopted} = 0;
            $s->{_set_actions}->($s->{_actions_detached}, 'Attach');
        }
    }
});

Tk::MainLoop();

# Pop up a per-host settings window — currently just terminal choice,
# but designed to grow.  Saves to ~/.config/find-xpra/config.json on Save.
sub _show_settings {
    my ($s) = @_;
    my $host = $s->{host};
    my $top  = $mw->Toplevel(-title => "find-xpra: settings for $host");
    $top->Label(-text => "Terminal for $host:",
                -font => 'sans-serif 11 bold')
        ->pack(-anchor => 'w', -padx => 12, -pady => 6);

    my @choices = qw(xterm mate-terminal gnome-terminal urxvt
                     alacritty kitty terminator lxterminal st);
    my $sel = _terminal_for($host);
    for my $t (@choices) {
        $top->Radiobutton(-text => $t, -value => $t, -variable => \$sel,
                          -anchor => 'w')
            ->pack(-fill => 'x', -padx => 30);
    }

    # Per-host DPI override.  Blank = inherit the global default DPI
    # (set beside the Rescan button).
    $top->Label(-text => "DPI override for $host (blank = use default):",
                -font => 'sans-serif 11 bold')
        ->pack(-anchor => 'w', -padx => 12, -pady => [10, 6]);
    my $host_dpi = $SETTINGS->{$host}{dpi} // '';
    $top->Entry(-textvariable => \$host_dpi, -width => 8, -justify => 'right')
        ->pack(-anchor => 'w', -padx => 30);

    # VNC zoom factor — percentage applied via FLTK_SCALING_FACTOR /
    # GDK_DPI_SCALE / QT_SCALE_FACTOR when launching vncviewer.
    $top->Label(-text => "VNC zoom % for $host (blank = 100%):",
                -font => 'sans-serif 11 bold')
        ->pack(-anchor => 'w', -padx => 12, -pady => [10, 6]);
    my $host_zoom = $SETTINGS->{$host}{vnc_zoom} // '';
    $top->Entry(-textvariable => \$host_zoom, -width => 8, -justify => 'right')
        ->pack(-anchor => 'w', -padx => 30);

    my $btns = $top->Frame->pack(-pady => 10);
    $btns->Button(-text => 'Save', -command => sub {
        $SETTINGS->{$host}{terminal} = $sel;
        $host_dpi =~ s/^\s+|\s+$//g;
        if (length $host_dpi && $host_dpi =~ /^\d+$/) {
            $SETTINGS->{$host}{dpi} = $host_dpi + 0;
        } else {
            delete $SETTINGS->{$host}{dpi};
        }
        $host_zoom =~ s/^\s+|\s+$//g;
        if (length $host_zoom && $host_zoom =~ /^\d+$/ && $host_zoom != 100) {
            $SETTINGS->{$host}{vnc_zoom} = $host_zoom + 0;
        } else {
            delete $SETTINGS->{$host}{vnc_zoom};
        }
        _save_settings($SETTINGS);
        $top->destroy;
    })->pack(-side => 'left', -padx => 6);
    $btns->Button(-text => 'Cancel', -command => sub { $top->destroy })
         ->pack(-side => 'left', -padx => 6);
}

# Pop up a window with every process on this (host, display).  Useful
# when the picked "main app" doesn't represent what's really running.
sub _show_procs {
    my ($s) = @_;
    my $top = $mw->Toplevel(-title => "$s->{host} $s->{disp} — all processes");
    my $txt = $top->Scrolled('Text',
                             -scrollbars => 'osoe',
                             -width      => 110,
                             -height     => 25,
                             -font       => 'monospace 10',
                             -wrap       => 'none',
                            )->pack(-fill => 'both', -expand => 1);
    for my $p (@{ $s->{procs} }) {
        $txt->insert('end', sprintf("%7d  %-10s  %s\n",
                     $p->{pid}, $p->{user}, $p->{cmd}));
    }
    $txt->configure(-state => 'disabled');
    $top->Button(-text => 'Close', -command => sub { $top->destroy })
        ->pack(-pady => 4);
}
exit 0;

our $XPRA_BIN;
sub _xpra_bin {
    return $XPRA_BIN if defined $XPRA_BIN;
    _dbg("[debug] _xpra_bin: \$^O=$^O  XPRA=" . ($ENV{XPRA} // '(unset)'));
    # Honour an explicit override first (e.g. XPRA=/path/to/xpra).
    if (defined $ENV{XPRA} && length $ENV{XPRA}) {
        _dbg("[debug] _xpra_bin: using XPRA env=$ENV{XPRA}");
        return $XPRA_BIN = $ENV{XPRA};
    }
    # Cygwin/MSYS/Windows: prefer the native Windows install under
    # Program Files over whatever `command -v xpra` reports.  Cygwin's
    # PATH often leaks Windows directories so PATH lookup can find a
    # broken stub or a binary that won't actually run from a Cygwin
    # process; the explicit Xpra_cmd.exe / Xpra.exe paths are the
    # reliable choice.  $^O is "cygwin" / "msys" / "MSWin32".
    if ($^O =~ /^(?:cygwin|msys|MSWin32)$/i) {
        for my $p (
            '/cygdrive/c/Program Files/Xpra/Xpra_cmd.exe',
            '/cygdrive/c/Program Files (x86)/Xpra/Xpra_cmd.exe',
            '/cygdrive/c/Program Files/Xpra/Xpra.exe',
            '/cygdrive/c/Program Files (x86)/Xpra/Xpra.exe',
            'C:/Program Files/Xpra/Xpra_cmd.exe',
            'C:/Program Files (x86)/Xpra/Xpra_cmd.exe',
            'C:/Program Files/Xpra/Xpra.exe',
            'C:/Program Files (x86)/Xpra/Xpra.exe',
        ) {
            my $hit = -e $p ? 'exists' : 'missing';
            my $exec = -x $p ? 'exec'   : 'noexec';
            _dbg("[debug] _xpra_bin:   $p ($hit, $exec)");
            if (-e $p) {
                _dbg("[debug] _xpra_bin: using $p");
                return $XPRA_BIN = $p;
            }
        }
    }
    # If something on PATH responds, use it.
    my $rc = system 'sh', '-c', 'command -v xpra >/dev/null 2>&1';
    _dbg("[debug] _xpra_bin: PATH lookup rc=$rc -> "
         . ($rc == 0 ? 'using bare xpra' : 'falling through'));
    return $XPRA_BIN = 'xpra' if $rc == 0;
    # Last resort — let exec fail loudly rather than silently.
    return $XPRA_BIN = 'xpra';
}

sub _attach_cmd {
    my ($s) = @_;
    (my $disp_n = $s->{disp}) =~ s/^://;
    my @dpi_opts;
    if (defined(my $dpi = _dpi_for($s->{host}))) {
        push @dpi_opts, "--dpi=$dpi";
    }
    if ($s->{local} && !$s->{_attach_as}) {
        return (_xpra_bin(), 'attach', @dpi_opts, ":$disp_n");
    }
    # Use the host name in the ssh URL so ~/.ssh/config Host blocks (User,
    # IdentityFile, ...) match.  If we know the IP, force the actual
    # connection to it via xpra's --ssh override (`-o HostName=$ip`) so
    # we don't depend on DNS/mDNS being right for the name.
    my $name = $s->{host};
    my $ip   = $s->{ip};
    my @opts;
    if (defined $name && defined $ip && $name ne $ip) {
        push @opts, "--ssh=ssh -o HostName=$ip";
    } else {
        $name = $ip if defined $ip;
    }
    my $login_user = $s->{_attach_as} // $ssh_user;
    my $url = defined $login_user
        ? "ssh://$login_user\@$name/$disp_n"
        : "ssh://$name/$disp_n";
    return (_xpra_bin(), 'attach', @opts, @dpi_opts, $url);
}

sub _vnc_attach_cmd {
    my ($s) = @_;
    (my $disp_n = $s->{disp}) =~ s/^://;
    my $port = $s->{vnc_port} // (5900 + $disp_n);
    my (@env, $env_sh);
    if (defined(my $zoom = _zoom_for($s->{host}))) {
        my $scale = sprintf("%.2f", $zoom / 100);
        @env = ('env', "FLTK_SCALING_FACTOR=$scale",
                "GDK_DPI_SCALE=$scale", "QT_SCALE_FACTOR=$scale");
        $env_sh = "FLTK_SCALING_FACTOR=$scale GDK_DPI_SCALE=$scale"
                . " QT_SCALE_FACTOR=$scale ";
    }
    if ($s->{local}) {
        return (@env, 'net-vnc', "localhost:$disp_n");
    }
    my $name = $s->{host};
    my $ip   = $s->{ip};
    my @tgt  = ssh_target({ name => $name, ip => $ip });
    my @sopts = ssh_opts();
    my $local_port = 15900 + $disp_n;
    my $ssh_str = join(' ', map { /[\s'"]/ ? "'$_'" : $_ }
                       ('ssh', @sopts, @tgt,
                        '-L', "$local_port:localhost:$port", '-N'));
    $env_sh //= '';
    my $script = "$ssh_str & VNC_SSH=\$!; sleep 1; "
               . "${env_sh}net-vnc localhost::$local_port; "
               . "kill \$VNC_SSH 2>/dev/null";
    return ('bash', '-c', $script);
}

sub _x11vnc_cmd {
    my ($s) = @_;
    (my $disp_n = $s->{disp}) =~ s/^://;
    my $rfb_port = 5900 + $disp_n;
    my $local_port = 15900 + $disp_n;
    my $env_sh = '';
    if (defined(my $zoom = _zoom_for($s->{host}))) {
        my $scale = sprintf("%.2f", $zoom / 100);
        $env_sh = "FLTK_SCALING_FACTOR=$scale GDK_DPI_SCALE=$scale"
                . " QT_SCALE_FACTOR=$scale ";
    }
    my $name = $s->{host};
    my $ip   = $s->{ip};
    my @tgt  = ssh_target({ name => $name, ip => $ip });
    my $login_user = $s->{_attach_as};
    if (defined $login_user) {
        $tgt[-1] =~ s/^[^\@]*\@//;
        $tgt[-1] = "$login_user\@$tgt[-1]";
    }
    my @sopts = ssh_opts();
    my $ssh_str = join(' ', map { /[\s'"]/ ? "'$_'" : $_ }
                       ('ssh', @sopts, @tgt,
                        '-L', "$local_port:localhost:$rfb_port"));
    my $script = "$ssh_str "
               . "'x11vnc -display :$disp_n -rfbport $rfb_port -nopw -once' "
               . "& X11VNC_SSH=\$!; sleep 2; "
               . "${env_sh}net-vnc localhost::$local_port; "
               . "kill \$X11VNC_SSH 2>/dev/null";
    return ('bash', '-c', $script);
}

# Build a launch-xpra invocation for the given session and action
# ("Restart app" / "Restart Xpra").  launch-xpra reads the host's own
# ~/.xpra-start to find the app command, so we just hand it the display
# number, the mode flag, and (for Restart Xpra) the resolved DPI.
sub _launch_xpra_cmd {
    my ($s, $action) = @_;
    (my $disp_n = $s->{disp}) =~ s/^://;
    my $mode = $action eq 'Restart app' ? '--restart-app' : '--restart-xpra';
    my @lx = ('launch-xpra', $mode, "--display=$disp_n");
    if ($mode eq '--restart-xpra') {
        if (defined(my $dpi = _dpi_for($s->{host}))) {
            push @lx, "--dpi=$dpi";
        }
        push @lx, '--web' if $action eq 'Restart Xpra with web';
    }
    return @lx if $s->{local};
    return ('ssh', ssh_opts(),
            ssh_target({ name => $s->{host}, ip => $s->{ip} }),
            @lx);
}

# Build the command to launch a terminal on the session's display.
# Uses the `( cmd & )` subshell-background idiom so the launching shell
# can exit immediately (and ssh with it).  Forces bash because the
# remote login shell may be csh/tcsh.
sub _load_settings {
    return {} unless -f $CONFIG_PATH;
    open my $fh, '<', $CONFIG_PATH or return {};
    local $/; my $json = <$fh>;
    close $fh;
    return eval { decode_json($json) } // {};
}

sub _save_settings {
    my ($s) = @_;
    make_path($CONFIG_DIR);
    open my $fh, '>', $CONFIG_PATH or do { warn "save: $!"; return };
    print $fh encode_json($s);
    close $fh;
}

sub _load_cache {
    return {} unless -f $CACHE_PATH;
    open my $fh, '<', $CACHE_PATH or return {};
    local $/; my $json = <$fh>;
    close $fh;
    return eval { decode_json($json) } // {};
}

sub _save_cache {
    make_path($CONFIG_DIR);
    open my $fh, '>', $CACHE_PATH or do { warn "cache save: $!"; return };
    print $fh encode_json($CACHE);
    close $fh;
}

sub _ago {
    my ($ts) = @_;
    my $a = time - ($ts // 0);
    return $a < 60     ? "${a}s"
         : $a < 3600   ? sprintf("%dm", int($a/60))
         : $a < 86400  ? sprintf("%dh", int($a/3600))
         :               sprintf("%dd", int($a/86400));
}

sub _cache_label {
    my ($name) = @_;
    my $c = $CACHE->{$name} or return undef;
    return undef unless defined $c->{n_sessions} && $c->{n_sessions} > 0;
    return sprintf('%d sess %s ago', $c->{n_sessions}, _ago($c->{ts}));
}

sub _terminal_for {
    my ($host) = @_;
    return $SETTINGS->{$host}{terminal}
        // $SETTINGS->{'*'}{terminal}
        // 'xterm';
}

# Resolve the DPI to pass to `xpra attach --dpi=N` for $host.  Per-host
# override wins over the global default (entry beside Rescan).  Returns
# undef when neither is set (xpra falls back to auto-detect).
sub _dpi_for {
    my ($host) = @_;
    my $dpi = $SETTINGS->{$host}{dpi} // $SETTINGS->{'*'}{dpi};
    return undef unless defined $dpi && $dpi =~ /^\d+$/ && $dpi > 0;
    return $dpi + 0;
}

sub _zoom_for {
    my ($host) = @_;
    my $zoom = $SETTINGS->{$host}{vnc_zoom} // $SETTINGS->{'*'}{vnc_zoom};
    return undef unless defined $zoom && $zoom =~ /^\d+$/ && $zoom > 0 && $zoom != 100;
    return $zoom + 0;
}

sub _term_cmd {
    my ($s) = @_;
    (my $disp_n = $s->{disp}) =~ s/^://;
    my $term = _terminal_for($s->{host});
    # mate-terminal / gnome-terminal don't accept `-display`; they use
    # the DISPLAY env var.  xterm accepts both — we use env-var form so
    # one launch line works for everything.
    my $cmd = "(DISPLAY=:$disp_n $term &)";
    if ($s->{local}) {
        # Perl exec hands $cmd to bash directly — no shell re-tokenisation,
        # so no extra quoting needed.
        return ('bash', '-c', $cmd);
    }
    # ssh joins everything after the target with spaces and ships it to
    # the remote shell, which re-parses.  Without literal single quotes
    # around the bash arg, the remote shell would interpret the parens
    # as a subshell of *its own* and bash -c would get an empty arg.
    return ('ssh', ssh_opts(),
            ssh_target({ name => $s->{host}, ip => $s->{ip} }),
            'bash', '-c', "'$cmd'");
}

# Fire-and-forget spawn (no PID tracking, no zombie).  Double-fork into
# a new session so it survives find-xpra exit; init reaps the orphan.
sub spawn_detached {
    my @cmd = @_;
    my $pid = fork // die "fork: $!";
    if ($pid) { waitpid($pid, 0); return; }
    # In the forked child: skip Tk's END handler, which would close the
    # X11 fd inherited from the parent and crash the chooser.
    POSIX::setsid();
    my $pid2 = fork;
    POSIX::_exit(1) unless defined $pid2;
    POSIX::_exit(0) if $pid2;
    open STDIN,  '<', '/dev/null';
    open STDOUT, '>', '/dev/null';
    open STDERR, '>', '/dev/null';
    exec { $cmd[0] } @cmd or POSIX::_exit(127);
}

# Spawn an xpra-attach child in its own session (so it keeps running if
# find-xpra exits or the controlling terminal closes) and return the
# child PID.  Caller is expected to waitpid(WNOHANG) it from the Tk
# repeat-timer when the viewer exits.
sub spawn_attach {
    my @cmd = @_;
    _dbg("[debug] attach: " . join(' ', map { /\s/ ? "'$_'" : $_ } @cmd));
    my $pid = fork;
    die "fork: $!" unless defined $pid;
    return $pid if $pid;
    # In the forked child: skip Tk's END so we don't share-close the
    # parent chooser's X11 fd if exec fails.
    POSIX::setsid();
    open STDIN,  '<', '/dev/null';
    # In --debug mode keep stdout/stderr attached (and tee'd to the log
    # file via _dbg) so xpra's launch errors are visible.  Otherwise
    # silence them so a failed attach doesn't spam the chooser.
    if ($debug && $DEBUG_LOG_FH) {
        open STDOUT, '>&', $DEBUG_LOG_FH;
        open STDERR, '>&', $DEBUG_LOG_FH;
    } else {
        open STDOUT, '>', '/dev/null';
        open STDERR, '>', '/dev/null';
    }
    exec { $cmd[0] } @cmd or POSIX::_exit(127);
}
