#!/usr/bin/perl
# find-xpra — discover X11/xpra/VNC sessions across the network and pop up
# a chooser to attach.
#
# Discovery: query net-mgr for online machines with tcp/22 open (skip APs),
# then `ssh host show-x11 -ns` in parallel and aggregate.  Local sessions
# are included by running show-x11 directly.  Choice pops up a zenity menu;
# selection runs `xpra attach ssh://HOST/DISPLAY` (or local `:DISPLAY`).

use strict;
use warnings;
use Getopt::Long qw(:config no_ignore_case no_bundling);
use IO::Select;
use IO::Pipe;
use IO::Socket::INET;
use POSIX ();
use JSON::PP qw(encode_json decode_json);
use File::Path qw(make_path);
use File::Temp qw(tempfile);

our %ATTACH_INFO;   # pid => { cmd => [...], log => path, start => epoch }
                    # populated by spawn_attach, consumed by the reap timer
                    # and the user-initiated Disconnect/kill handlers.
use lib '/usr/local/src/net-mgr/lib';
use NetMgr::Client;

my $VERSION = '__GIT_VERSION__';
if ($VERSION eq '__' . 'GIT_VERSION__') {
    use File::Basename;
    my $srcdir = dirname(dirname($0));
    chomp($VERSION = `git -C '$srcdir' describe --always 2>/dev/null` || 'dev');
}

# Snapshot before GetOptions consumes it; needed to re-exec on Rescan.
my @ORIG_ARGV = @ARGV;

# Persisted per-host preferences live in ~/.config/find-xpra/config.json:
#   { "nas3": { "terminal": "mate-terminal" }, ... }
# `*` is the wildcard-default key.
my $CONFIG_DIR  = ($ENV{XDG_CONFIG_HOME} // "$ENV{HOME}/.config") . '/find-xpra';
my $CONFIG_PATH = "$CONFIG_DIR/config.json";
my $CACHE_PATH  = "$CONFIG_DIR/cache.json";
my $SETTINGS    = _load_settings();
my $CACHE       = _load_cache();

# Soft ceiling on display numbers shown.  Xpra shadow/proxy servers use
# very high synthetic display IDs (e.g. :1000200) the user rarely wants in
# the list.  Stored in $SETTINGS->{_max_disp}: a positive integer is the
# ceiling, 0 means "no limit", and an absent key falls back to the default
# below.  Editable from the header "Settings" dialog.  --all/--any bypass
# it entirely.
my $MAX_DISP_DEFAULT = 9999;
my $max_disp = $SETTINGS->{_max_disp} // $MAX_DISP_DEFAULT;
$max_disp = undef if defined $max_disp && $max_disp == 0;   # 0 => unlimited

# "Show hidden" view toggle: when off (default) sessions whose host is
# marked Hide (per-host Settings; local :0 hidden by default) are kept out
# of the list to reduce clutter.  When on, those hidden sessions are
# revealed too.  Toggled by a header button; not persisted (per-session).
my $show_hidden = 0;

# Target X display for windows we launch (viewers, terminals, helpers).
# When find-xpra itself runs inside an xpra/nested session, spawned
# viewers would otherwise inherit that session's $DISPLAY and open inside
# it; set this to e.g. ":0" to push them to the real screen instead.
# Blank = inherit the current $DISPLAY (historical behaviour).  Edited in
# the header "Display:" field; seeded from a saved default if present.
my $target_display = $SETTINGS->{_target_display} // '';
# Apply $target_display to the current (child) process's environment, just
# before exec in the spawn_* helpers.  No-op when blank.
sub _apply_target_display {
    return unless defined $target_display && length $target_display;
    $ENV{DISPLAY} = $target_display;
}

# ssh-askpass program for GUI password prompts.  ssh exec's $SSH_ASKPASS
# by name (PATH lookup); if the configured/default program doesn't exist,
# ssh silently can't prompt and publickey-only connections fail with no
# visible reason.  $SETTINGS->{_askpass} pins a choice from the Settings
# dialog; otherwise auto-detect the first installed one.  Distros scatter
# these: a bare name on PATH, or under /usr/lib*/openssh, /usr/libexec.
my @ASKPASS_CANDIDATES = qw(
    /usr/bin/ssh-askpass
    /usr/bin/ssh-askpass-gnome
    /usr/bin/ksshaskpass
    /usr/bin/lxqt-openssh-askpass
    /usr/bin/ssh-askpass-fullscreen
    /usr/lib/openssh/gnome-ssh-askpass
    /usr/lib/openssh/ssh-askpass
    /usr/libexec/openssh/ssh-askpass
    /usr/libexec/openssh/gnome-ssh-askpass
);
# Return the askpass program to use: the configured one (if set), else the
# first candidate that exists on disk, else undef (no usable askpass).
sub _askpass {
    my $cfg = $SETTINGS->{_askpass};
    # An explicit configured choice always wins, trusted VERBATIM (bare
    # name or full path) — don't second-guess it with an -x test, so it
    # works on platforms whose askpass lives somewhere our candidate list
    # doesn't cover (e.g. Cygwin paths).  'auto'/empty means auto-detect.
    return $cfg if defined $cfg && length $cfg && $cfg ne 'auto';
    for my $c (@ASKPASS_CANDIDATES) {
        return $c if -x $c;
    }
    return undef;
}

my $listen     = $ENV{NET_MGR_LISTEN};
my $ssh_user;             # undef → let ssh_config(5) pick the user
my $user;                 # --user: ssh as USER and filter sessions to USER
my $ssh_to     = 3;
my $overall_to = 8;
my $list_only;
my $no_local;
my $no_scan;
my $scan;
my $pick;
my $no_prompt;
my $no_mount;
my $ssh_key;
my $debug;
my $any;
my $all;
my @extra_hosts;
my $help;

GetOptions(
    'listen=s'   => \$listen,
    'user=s'     => \$user,
    'ssh-user=s' => \$ssh_user,
    'ssh-key=s'  => \$ssh_key,
    'timeout=i'  => \$ssh_to,
    'list'       => \$list_only,
    'no-local'   => \$no_local,
    'no-scan'    => \$no_scan,
    'no-prompt|keys-only' => \$no_prompt,
    'no-mount'   => \$no_mount,
    'scan'       => \$scan,
    'pick'       => \$pick,
    'debug'      => \$debug,
    'any'        => \$any,
    'a|all'      => \$all,
    'host=s@'    => \@extra_hosts,
    'h|help'     => \$help,
) or die usage();
print(usage()), exit 0 if $help;

# --user is a shorthand: ssh as that user AND only show their sessions.
# --ssh-user (if also given) wins for the ssh-as part.
$ssh_user //= $user if defined $user;

# By default, prompts go through ssh-askpass (a GUI dialog) — the parallel
# probe forks have stdin closed and a fresh session, so ssh can't ask on the
# tty even if it wanted to.  SSH_ASKPASS_REQUIRE=force makes OpenSSH 8.4+
# use askpass even with $DISPLAY unset on systems that ship one.
unless ($no_prompt) {
    # Override (not //=): the environment may already export SSH_ASKPASS
    # to something that doesn't exist here, which would silently defeat
    # the Settings choice.  Our resolved value wins; only fall back to the
    # inherited env if we found nothing at all.
    if (defined(my $ap = _askpass())) { $ENV{SSH_ASKPASS} = $ap }
    $ENV{SSH_ASKPASS_REQUIRE} //= 'force';
}

# Debug log: when --debug is on, mirror stderr trace to a file too so
# the trace survives launching from a Tk/desktop context where stderr
# isn't on a terminal.  Append; multiple find-xpra runs and forked
# probes all write here, prefixed with pid so their lines stay sortable.
our $DEBUG_LOG_PATH = '/tmp/find-xpra-debug.log';
our $DEBUG_LOG_FH;
if ($debug) {
    if (open $DEBUG_LOG_FH, '>>', $DEBUG_LOG_PATH) {
        $DEBUG_LOG_FH->autoflush(1);
        print {$DEBUG_LOG_FH}
            "\n=== ", scalar(localtime), " pid=$$ ===\n",
            "    cmd: $0 ", join(' ', @ORIG_ARGV), "\n";
    } else {
        warn "debug log: can't open $DEBUG_LOG_PATH: $!\n";
    }
}

sub _dbg {
    return unless $debug;
    my $msg = join('', @_);
    $msg .= "\n" unless $msg =~ /\n\z/;
    print STDERR $msg;
    print {$DEBUG_LOG_FH} $msg if $DEBUG_LOG_FH;
}

# --- on-demand encrypted key store ---------------------------------------
# If ~/.ssh/keys-<method> is a symlink to the cipher directory, run a
# one-shot mount script (`find-xpra-<method>`) that mounts the cleartext
# at ~/.keys, waits until either it's been idle for 60s or it gets
# SIGHUP, then unmounts and exits.  Concurrent find-xpras share the
# mount: while the script is alive we just SIGUSR1 it to bump its idle
# timeout instead of starting a second mount.  The script owns its own
# unmount, so find-xpra never has to clean up on exit.
#
# Currently `gocryptfs` is the only supported method.

our $KEYS_MNT       = ($ENV{HOME} // '') . '/.keys';
our $KEYS_PIDFILE   = do {
    my $base = $ENV{XDG_RUNTIME_DIR}
            // ($ENV{HOME} ? "$ENV{HOME}/.cache" : '/tmp');
    "$base/find-xpra-keys.pid";
};

sub _keys_link {
    # Pick the first .ssh/keys-<method> symlink we know how to mount.
    my $home = $ENV{HOME} // '';
    return unless length $home;
    for my $method ('gocryptfs') {
        my $link = "$home/.ssh/keys-$method";
        return ($method, $link) if -l $link;
    }
    return;
}

sub _keys_is_mounted {
    return 0 unless -d $KEYS_MNT;
    open my $fh, '<', '/proc/mounts' or return 0;
    while (<$fh>) {
        my @f = split / /;
        return 1 if @f >= 2 && $f[1] eq $KEYS_MNT;
    }
    return 0;
}

# Read pidfile -> live mount-script pid, or undef (cleans stale files).
sub _keys_mount_pid {
    open my $fh, '<', $KEYS_PIDFILE or return undef;
    my $pid = <$fh>;
    close $fh;
    chomp $pid if defined $pid;
    return undef unless defined $pid && $pid =~ /^\d+$/;
    return $pid + 0 if kill 0, $pid;
    unlink $KEYS_PIDFILE;
    return undef;
}

# Locate the per-method mount script (find-xpra-<method>).  Prefer the
# binary alongside us in the source / install tree; fall back to PATH.
sub _keys_helper {
    my ($method) = @_;
    my $name = "find-xpra-$method";
    require File::Basename;
    my $dir = File::Basename::dirname($0);
    return "$dir/$name" if -x "$dir/$name";
    return $name;     # let exec resolve via PATH
}

# Foreground: ensure ~/.keys is mounted.  Returns 1 on success, 0 if no
# keys-<method> symlink is configured, the helper failed to mount, or
# the mount didn't appear within the timeout.
sub _keys_ensure {
    return 0 if $no_mount || $no_prompt;
    my ($method, $link) = _keys_link() or return 0;

    # Mount script already running?  Bump its idle timeout and wait.
    if (my $pid = _keys_mount_pid()) {
        kill 'USR1', $pid;
        _dbg("[debug] keys: USR1 -> $pid");
        return _keys_wait_ready($pid);
    }

    # Nobody home.  Double-fork the helper script for this method so it
    # outlives us — find-xpra exiting must not tear the mount down.
    my $helper = _keys_helper($method);
    _dbg("[debug] keys: spawning $helper");
    my $kid = fork;
    if (!defined $kid) { warn "find-xpra: keys fork: $!\n"; return 0 }
    if ($kid == 0) {
        POSIX::setsid();
        my $kid2 = fork;
        POSIX::_exit(0) if !defined $kid2 || $kid2 != 0;
        open STDIN,  '<', '/dev/null';
        open STDOUT, '>>', '/dev/null';
        # Leave STDERR attached so a mount failure is visible.
        { exec { $helper } $helper };
        POSIX::_exit(127);
    }
    waitpid($kid, 0);
    return _keys_wait_ready();
}

# Poll until ~/.keys is mounted, the helper exits, or we time out.
# Returns 1 on mount success, 0 otherwise.  $expect_pid (optional) is
# the pre-existing helper we just signalled — if it dies before the
# mount appears we abort early.
sub _keys_wait_ready {
    my ($expect_pid) = @_;
    my $deadline = time + 30;
    while (time < $deadline) {
        return 1 if _keys_is_mounted();
        if (defined $expect_pid) {
            return 0 if !kill 0, $expect_pid;
        } else {
            return 0 if !defined _keys_mount_pid();
        }
        select undef, undef, undef, 0.1;
    }
    warn "find-xpra: timed out waiting for $KEYS_MNT to mount\n";
    return 0;
}

sub ssh_opts {
    my (%o) = @_;
    my @opts = (
        '-o', "ConnectTimeout=$ssh_to",
        '-o', 'StrictHostKeyChecking=accept-new',
        '-o', 'ServerAliveInterval=3',
        '-o', 'ServerAliveCountMax=2',
    );
    my $key = $ssh_key;
    if (!defined $key && defined $ssh_user) {
        $key = $SETTINGS->{_user_keys}{$ssh_user};
    }
    push @opts, '-i', $key if defined $key && length $key;
    if ($no_prompt && !$o{interactive}) {
        push @opts,
            '-o', 'BatchMode=yes',
            '-o', 'NumberOfPasswordPrompts=0',
            '-o', 'PreferredAuthentications=publickey';
    }
    # User-configured extra ssh arguments (Settings → "Extra ssh
    # arguments"), e.g. -Y / -C.  Whitespace-split; appended last so they
    # can override the defaults above.
    my $extra = $SETTINGS->{_ssh_extra_args};
    if (defined $extra && length $extra) {
        push @opts, grep { length } split /\s+/, $extra;
    }
    return @opts;
}

# Build (ssh-args, login) for a candidate.  Use the candidate name as
# the login destination so ~/.ssh/config Host blocks (User, IdentityFile,
# Port, ...) match — but force the actual connection to the IP we
# discovered via `-o HostName=<ip>`, so we don't depend on DNS or
# /etc/hosts being right for that name.  When the name is missing or
# already an IP, fall back to the plain-IP form.
sub ssh_target {
    my ($c) = @_;
    my $name = $c->{name};
    my $ip   = $c->{ip};
    my @args;
    my $host;
    if ($c->{_extra}) {
        $host = $ip // $name;
    } elsif (defined $name && defined $ip && $name ne $ip) {
        push @args, '-o', "HostName=$ip";
        $host = $name;
    } else {
        $host = $ip // $name;
    }
    # Per-host SSH port override (from Settings dialog → ~/.config/find-xpra)
    # — needed to reach VMs behind a forwarded host port (Hyper-V, VirtualBox).
    my $port = $c->{ssh_port}
            // ($name ? $SETTINGS->{$name}{ssh_port} : undef)
            // ($ip   ? $SETTINGS->{$ip}{ssh_port}   : undef);
    push @args, '-p', $port if defined $port && $port =~ /^\d+$/ && $port != 22;
    my $user = $c->{ssh_user} // $ssh_user;
    my $login = defined $user ? "$user\@$host" : $host;
    return (@args, $login);
}

sub _sess_target {
    my ($s) = @_;
    return { name => $s->{host}, ip => $s->{ip},
             (defined $s->{_attach_as} && length $s->{_attach_as}
                ? (ssh_user => $s->{_attach_as}) : ()),
             ($s->{_extra} ? (_extra => 1) : ()) };
}

# Resolve an explicit per-host SSH login user: the Settings-dialog
# override ($SETTINGS->{HOST}{ssh_user}) first, else a user typed into
# the Add/Edit-host dialog (persisted under _extra_hosts).  Returns undef
# when neither is set, so callers fall back to ssh_config / $ssh_user.
# This is the login used for attach / VNC / SSH actions — not just the
# discovery probe.
sub _host_login_user {
    my ($host, $ip) = @_;
    my $u = (defined $host && $SETTINGS->{$host} ? $SETTINGS->{$host}{ssh_user} : undef)
         // (defined $ip   && $SETTINGS->{$ip}   ? $SETTINGS->{$ip}{ssh_user}   : undef);
    unless (defined $u && length $u) {
        for my $e (@{ $SETTINGS->{_extra_hosts} || [] }) {
            next unless defined $e->{user} && length $e->{user};
            my $match;
            $match = 1 if defined $e->{name}
                       && ((defined $host && $e->{name} eq $host)
                        || (defined $ip   && $e->{name} eq $ip));
            $match = 1 if defined $e->{ip}
                       && ((defined $host && $e->{ip} eq $host)
                        || (defined $ip   && $e->{ip} eq $ip));
            next unless $match;
            $u = $e->{user};
            last;
        }
    }
    return (defined $u && length $u) ? $u : undef;
}

# Resolve the ssh login user for a candidate by consulting ssh_config.
# Two-step:
#   1. `ssh -G NAME` evaluates Host/Match blocks where NAME is the alias
#      (e.g. `Host clevo User claude` matches when NAME is "clevo").
#   2. If that returned just the default $USER (i.e. no rule matched),
#      reverse-scan the config for any Host block whose `Hostname` line
#      points at NAME / IP / bare-name.  This handles the common case
#      where the alias differs from the real hostname:
#         Host clevo
#             Hostname clevo-air.grfx.com
#             User claude
#      so a candidate named "clevo-air" or "clevo-air.grfx.com" still
#      picks up User=claude.
sub _ssh_config_user {
    my ($name, $ip) = @_;
    return undef unless defined $name && length $name;
    my $g_user;
    # Fork-exec ssh -G with stderr silenced so the harmless
    # "Pseudo-terminal will not be allocated because stdin is not a
    # terminal" warning doesn't flood the user's terminal.
    my $cpid = open my $h, '-|';
    if (!defined $cpid) {
        # fork failed — fall through to reverse-lookup only.
    } elsif ($cpid == 0) {
        open STDERR, '>', '/dev/null';
        exec 'ssh', '-G', $name or POSIX::_exit(127);
    } else {
        while (<$h>) { $g_user = $1, last if /^user\s+(\S+)/ }
        close $h;
    }
    return $g_user if defined $g_user
                   && length $g_user
                   && $g_user ne ($ENV{USER} // '');
    my $hostname_map = _ssh_config_hostname_map();
    for my $key (
        lc $name,
        (defined $ip ? lc $ip : ()),
        ($name =~ /^([^.]+)\./ ? lc $1 : ()),
    ) {
        return $hostname_map->{$key} if defined $hostname_map->{$key};
    }
    return $g_user;
}

# Build a lower-cased "Hostname value -> User" map across all ssh_config
# files, plus a bare-form alias (Hostname `clevo-air.grfx.com` also
# entered as `clevo-air`).  First definition wins, matching ssh's own
# precedence.
sub _ssh_config_hostname_map {
    my %map;
    my $cur;
    my $finalize = sub {
        return unless $cur;
        if (defined $cur->{user} && defined $cur->{hostname}) {
            my $hn = lc $cur->{hostname};
            $map{$hn} //= $cur->{user};
            $map{$1}  //= $cur->{user} if $hn =~ /^([^.]+)\./;
        }
        $cur = undef;
    };
    for my $f (
        ($ENV{HOME} ? "$ENV{HOME}/.ssh/config" : ()),
        '/etc/ssh/ssh_config',
        glob('/etc/ssh/ssh_config.d/*.conf'),
    ) {
        next unless -r $f;
        open my $fh, '<', $f or next;
        while (<$fh>) {
            s/#.*//;
            s/^\s+|\s+$//g;
            next unless length;
            if (/^Host\s+/i) {
                $finalize->();
                $cur = { user => undef, hostname => undef };
            } elsif ($cur) {
                if    (/^Hostname\s+(\S+)/i) { $cur->{hostname} = $1 }
                elsif (/^User\s+(\S+)/i)     { $cur->{user}     = $1 }
            }
        }
        $finalize->();
        close $fh;
    }
    return \%map;
}

# Collect every distinct User mentioned across ~/.ssh/config and
# /etc/ssh/ssh_config, plus the current $USER, plus any names the user
# explicitly added via the picker's "Add user" button (persisted under
# $SETTINGS->{_users}).  Used to populate the per-row user dropdown so a
# host that ssh_config defaults to (e.g.) `claude` can still be probed
# as `dkc`/`wdkc` from the same picker.
sub _ssh_config_users {
    my %users;
    $users{$ENV{USER}} = 1 if defined $ENV{USER} && length $ENV{USER};
    for my $u (keys %{ $SETTINGS->{_users} || {} }) {
        $users{$u} = 1;
    }
    for my $f (
        ($ENV{HOME} ? "$ENV{HOME}/.ssh/config" : ()),
        '/etc/ssh/ssh_config',
        glob('/etc/ssh/ssh_config.d/*.conf'),
    ) {
        next unless -r $f;
        open my $fh, '<', $f or next;
        while (<$fh>) {
            next if /^\s*(?:#|$)/;
            $users{$1} = 1 if /^\s*User\s+(\S+)/i;
        }
        close $fh;
    }
    return sort keys %users;
}

sub usage { <<'EOF' }
usage: find-xpra [options]
  --listen HOST[:PORT]  net-mgr address (default: $NET_MGR_LISTEN, then
                        127.0.0.1:7531, then nmap-scan local /24 for :7531)
  --user USER           ssh as USER and only show sessions owned by USER
  --ssh-user USER       override ssh user only (default: from ssh_config(5))
  --ssh-key FILE        ssh -i FILE (private key to authenticate with)
  --no-prompt, --keys-only
                        never prompt for an ssh password (BatchMode=yes,
                        publickey-only); default is to allow ssh-askpass
  --no-mount            don't try to mount an encrypted ~/.ssh/keys-*
                        store; assume any keys ssh needs are already
                        available (or use --keys-only to fail fast)
  --scan                force nmap scan even if local net-mgr is up
  --pick                pop up a host chooser before any ssh probe;
                        sorted by favorite, last-known session count,
                        then signals (X / VNC / net-mgr); per-row star
                        toggles favorite, "Forget" clears the cache
                        entry (Tk dialog; --list gets a CLI prompt)
  --no-scan             don't fall back to scanning the subnet for net-mgr
  --timeout SEC         per-host ssh ConnectTimeout (default: 3)
  --list                print rows to stdout instead of popping a chooser
  --no-local            skip local show-x11 probe; also skip our own IP
                        when scanning for net-mgr
  --any                 show sessions belonging to all users, not just
                        the ssh login user (discovers displays from
                        /tmp/.X11-unix/ on each host)
  -a, --all             show everything otherwise hidden: displays under
                        :20 (presumed plain X), displays over :1000, and
                        sessions whose only contents are session plumbing
  --host HOST           add HOST to the probe list (repeatable); if no
                        sessions are discovered, offers :0 as fallback
  --debug               print the probe command for each candidate and
                        leave ssh's stderr attached so failures show why
  -h, --help            this message
EOF

sub probe_net_mgr {
    # Quick TCP probe — does anything answer at HOST[:PORT]?
    my ($addr) = @_;
    my ($host, $port) = split /:/, $addr, 2;
    $port = 7531 if !defined $port || $port eq '';
    my $sock = IO::Socket::INET->new(
        PeerAddr => $host,
        PeerPort => $port,
        Proto    => 'tcp',
        Timeout  => 1,
    ) or return 0;
    close $sock;
    return 1;
}

sub _local_ips_set {
    # Cross-platform: try `ip` (Linux), `ifconfig` (BSD/macOS, older
    # Linux), then `ipconfig` (Cygwin/Windows native).  Returns a hashref
    # keyed by every IPv4/IPv6 address we own.
    my %ips;
    if (open my $h, '-|', 'ip', '-o', 'addr', 'show') {
        while (<$h>) { $ips{$1} = 1 if /\binet6?\s+([\da-f.:]+)/i }
        close $h;
    }
    if (!%ips && open my $h, '-|', 'ifconfig') {
        while (<$h>) { $ips{$1} = 1 if /\binet6?\s+(?:addr:\s*)?([\da-f.:]+)/i }
        close $h;
    }
    if (!%ips && open my $h, '-|', 'ipconfig') {
        while (<$h>) { $ips{$1} = 1
            if /(?:IPv4 Address|IPv6 Address|IP Address)[^:]*:\s*([\da-f.:]+)/i }
        close $h;
    }
    return \%ips;
}

sub _default_src_ip {
    # The IP we'd use to reach the outside world.  On Linux, ask `ip
    # route get`.  Otherwise, fall back to the first non-loopback IPv4
    # we own — good enough for picking a /24 to nmap-scan.
    if (open my $h, '-|', 'ip', 'route', 'get', '1.1.1.1') {
        while (<$h>) { return $1 if /\bsrc\s+(\S+)/ }
    }
    my $ips = _local_ips_set();
    for my $ip (sort keys %$ips) {
        next unless $ip =~ /^\d+\.\d+\.\d+\.\d+$/;
        next if $ip =~ /^127\./;
        return $ip;
    }
    return undef;
}

sub scan_net_mgr {
    # nmap the local /24 for port 7531/tcp.  Returns 'host:port' or undef.
    # If $skip_self, drop our own source IP from the result so a remote
    # peer wins instead of looping back to ourselves.
    my ($skip_self) = @_;
    my $src = _default_src_ip();
    return undef unless $src;
    (my $subnet = $src) =~ s{\.\d+$}{.0/24};
    my @hosts;
    if (open my $nh, '-|',
        'nmap', '-Pn', '-T4', '-n', '-p', '7531', '--open', '-oG', '-', $subnet) {
        while (<$nh>) {
            if (/^Host:\s+(\S+).*7531\/open/) {
                next if $skip_self && $1 eq $src;
                push @hosts, $1;
            }
        }
        close $nh;
    }
    return @hosts ? "$hosts[0]:7531" : undef;
}

# --- discover candidate hosts via net-mgr ---------------------------------

unless (defined $listen) {
    if ($scan) {
        $listen = scan_net_mgr($no_local)
            or die "--scan: no net-mgr found on local /24\n";
    } elsif (probe_net_mgr('127.0.0.1:7531')) {
        $listen = '127.0.0.1:7531';
    } elsif (!$no_scan) {
        $listen = scan_net_mgr($no_local)
            or die "no net-mgr found locally or on the subnet; use --listen HOST\n";
    } else {
        die "no local net-mgr at 127.0.0.1:7531 and --no-scan set; use --listen HOST\n";
    }
}

my $cli = NetMgr::Client->new(listen => $listen);
$cli->hello(consumer => "net-show-x11.$$");
my $machines = $cli->snapshot(1, 'machines');
my $ifaces   = $cli->snapshot(2, 'interfaces');
my $addrs    = $cli->snapshot(3, 'addresses', where => "family = 'v4'");
my $ports22  = $cli->snapshot(4, 'ports', where => "port = 22");
my $aps      = $cli->snapshot(5, 'aps');
# Service ports used to prioritise the --pick list.  X11: 6000-6063
# (TCP-listening Xorg/Xvfb), VNC: 5900-5999, net-mgr: 7531.
my $svc_ports = $cli->snapshot(6, 'ports',
    where => "(port >= 6000 AND port <= 6063)"
           . " OR (port >= 5900 AND port <= 5999)"
           . " OR port = 7531");
$cli->bye;

my %ap_mac  = map { $_->{mac} => 1 } @$aps;
my %ssh_mac = map { $_->{mac} => 1 } @$ports22;
my %ip_for;
for my $a (@$addrs) {
    push @{ $ip_for{$a->{mac}} }, $a->{addr};
}
my %macs_of;
for my $i (@$ifaces) {
    next unless defined $i->{machine_id};
    push @{ $macs_of{$i->{machine_id}} }, $i->{mac};
}
my %svc_for;     # mac => [ports]
for my $p (@$svc_ports) {
    push @{ $svc_for{$p->{mac}} }, $p->{port};
}

# Local IPs — used to flag candidates that are us, so we run show-x11
# directly instead of sshing into ourselves.  _local_ips_set() probes
# ip / ifconfig / ipconfig in turn so this works on Linux, BSD/macOS
# and Cygwin alike.
my %local_ip = %{ _local_ips_set() };

my @candidates;
for my $m (@$machines) {
    next unless $m->{online};
    my $best_ip;
    my ($x_n, $vnc_n, $nm_n) = (0, 0, 0);
    for my $mac (@{ $macs_of{$m->{id}} || [] }) {
        for my $p (@{ $svc_for{$mac} || [] }) {
            $x_n++   if $p >= 6000 && $p <= 6063;
            $vnc_n++ if $p >= 5900 && $p <= 5999;
            $nm_n++  if $p == 7531;
        }
        next if $ap_mac{$mac};
        next unless $ssh_mac{$mac};
        ($best_ip) = sort @{ $ip_for{$mac} || [] } unless defined $best_ip;
    }
    next unless defined $best_ip;
    push @candidates, { name => $m->{primary_name} // $best_ip, ip => $best_ip,
                        local => $local_ip{$best_ip} ? 1 : 0,
                        x => $x_n, vnc => $vnc_n, nm => $nm_n };
}
# The net-mgr host itself isn't in its own inventory — add it explicitly,
# unless it's loopback (covered by the localhost probe; adding 127.0.0.1
# would either duplicate it or, with --no-local, ssh-probe ourselves
# under the wrong host label).
my ($mgr_host) = split /:/, $listen, 2;
my $mgr_is_local = $mgr_host =~ /^(?:127\.|::1$|localhost$)/
                || $local_ip{$mgr_host};
unless ($mgr_is_local
        || grep { ($_->{name} // '') eq $mgr_host || ($_->{ip} // '') eq $mgr_host } @candidates) {
    push @candidates, { name => $mgr_host, ip => $mgr_host };
}

for my $h (@extra_hosts) {
    next if grep { ($_->{name} // '') eq $h || ($_->{ip} // '') eq $h } @candidates;
    push @candidates, { name => $h, ip => $h, _extra => 1 };
}
for my $h (@{ $SETTINGS->{_extra_hosts} // [] }) {
    my ($n, $ip) = ($h->{name}, $h->{ip});
    my ($existing) = grep { ($_->{name} // '') eq $n || ($_->{ip} // '') eq $ip } @candidates;
    if ($existing) {
        $existing->{_extra}   = 1;
        $existing->{ssh_user} = $h->{user} if defined $h->{user};
        $existing->{_disp}    = $h->{disp} if defined $h->{disp};
    } else {
        push @candidates, { name => $n, ip => $ip, _extra => 1,
                            (defined $h->{user} ? (ssh_user => $h->{user}) : ()),
                            (defined $h->{disp} ? (_disp => $h->{disp})   : ()) };
    }
}

if ($no_local) {
    @candidates = grep { !$_->{local} } @candidates;
} elsif (!grep { $_->{local} } @candidates) {
    # Fallback when the local box isn't in net-mgr's inventory.
    push @candidates, { name => 'localhost', ip => undef, local => 1 };
}

# If --user is set and differs from the current account, the local
# shortcut (which runs show-x11/xpra-list as $ENV{USER}) won't see the
# target user's sessions.  Strip the `local` flag so we ssh in as $user
# instead.  Need an IP for ssh — fall back to 127.0.0.1 for the
# "localhost" placeholder.
if (defined $user && $user ne ($ENV{USER} // '')) {
    for my $c (@candidates) {
        next unless $c->{local};
        $c->{local} = 0;
        $c->{ip} //= '127.0.0.1';
    }
}

# Resolve per-candidate ssh user via `ssh -G NAME` when neither --user
# nor --ssh-user was given.  ~/.ssh/config Host blocks (e.g. `Host clevo
# User claude`) then drive both the ssh login and the user we tag the
# session under, so `find-xpra --listen clevo` correctly attributes
# sessions to claude rather than to whoever ran find-xpra.
unless (defined $ssh_user) {
    for my $c (@candidates) {
        next if $c->{local};
        $c->{ssh_user} = _ssh_config_user($c->{name}, $c->{ip});
    }
}

if ($pick) {
    # Sort by:
    #   1. favorite (sticky pin from prior runs)
    #   2. usage count (most-connected first)
    #   3. cached session count (so a host last seen with sessions floats)
    #   4. net-mgr-known signals: X (6000-6063), VNC (5900-5999), net-mgr (7531)
    #   5. name (alphabetic) — stable order for everything else.
    my %_pick_usage = %{ $SETTINGS->{_usage} // {} };
    my @ranked = sort {
           (($SETTINGS->{ _name_for($b) }{favorite}//0)
            <=> ($SETTINGS->{ _name_for($a) }{favorite}//0))
        || (($_pick_usage{ _name_for($b) }//0)
            <=> ($_pick_usage{ _name_for($a) }//0))
        || (($CACHE->{ _name_for($b) }{n_sessions}//0)
            <=> ($CACHE->{ _name_for($a) }{n_sessions}//0))
        || (($b->{x}  // 0) <=> ($a->{x}  // 0))
        || (($b->{vnc}// 0) <=> ($a->{vnc}// 0))
        || (($b->{nm} // 0) <=> ($a->{nm} // 0))
        || (_name_for($a)   cmp _name_for($b))
    } @candidates;
    my $chosen = pick_host(\@ranked);
    defined $chosen or exit 1;
    @candidates = ($chosen);
    # If the picker's user-dropdown selected a specific login, lift it
    # to the global $ssh_user so ssh_target() / ssh_opts() / attach all
    # honour it for the rest of the run.
    $ssh_user = $chosen->{ssh_user}
        if defined $chosen->{ssh_user} && length $chosen->{ssh_user};
    # We're now probing exactly one host the user explicitly picked, so
    # the parallel-probe haste no longer applies — give them plenty of
    # time to deal with the askpass dialog.
    $overall_to = 120;
}

sub _name_for {
    my ($c) = @_;
    return $c->{name} // 'localhost';
}

sub _host_label {
    my ($c) = @_;
    return 'localhost' if !defined $c->{ip};   # explicit-fallback case
    my $name = _name_for($c);
    my $disp = $name;
    $disp .= " ($c->{ip})"   if $c->{ip} ne $name;
    $disp .= "  [local]"     if $c->{local};
    if (my $cl = _cache_label($name)) { $disp .= "  [$cl]" }
    my @tags;
    push @tags, "$c->{x} X"     if $c->{x};
    push @tags, "$c->{vnc} VNC" if $c->{vnc};
    push @tags, "net-mgr"       if $c->{nm};
    $disp .= "  [".join(', ', @tags)."]" if @tags;
    return $disp;
}

sub pick_host {
    my ($cands) = @_;
    if ($list_only) {
        print STDERR "Hosts:\n";
        for my $i (0 .. $#$cands) {
            my $fav = $SETTINGS->{ _name_for($cands->[$i]) }{favorite} ? '* ' : '  ';
            print STDERR sprintf("  [%d] %s%s\n", $i+1, $fav, _host_label($cands->[$i]));
        }
        print STDERR "Pick (1-", scalar @$cands, ", empty to cancel): ";
        my $line = <STDIN>;
        return undef unless defined $line;
        chomp $line;
        return undef if $line eq '';
        my $i = $line - 1;
        return undef unless $i >= 0 && $i < @$cands;
        return $cands->[$i];
    }
    # Tk picker runs in a forked subprocess: keeps the main process from
    # ever loading Tk, so the post-pick parallel-ssh probe doesn't fork
    # off a child carrying the parent's X11 fd (which crashes both ends
    # when the child exits, even with POSIX::_exit).  Child writes the
    # chosen index to a pipe; parent reads it and proceeds.
    pipe(my $rh, my $wh) or die "pipe: $!";
    my $pid = fork // die "fork: $!";
    if (!$pid) {
        close $rh;
        _dbg("[debug] picker: child started, requiring Tk");
        require Tk;
        Tk->import;
        _dbg("[debug] picker: Tk loaded");
        my @user_choices = _ssh_config_users();
        _dbg("[debug] picker: user_choices = " . join(',', @user_choices));
        my $mw = MainWindow->new(-title => 'find-xpra: pick host');
        _dbg("[debug] picker: MainWindow created");
        $mw->optionAdd('*Font' => 'sans-serif 11');
        # Bottom controls packed FIRST with -side => 'bottom' so they
        # always anchor to the window's bottom edge regardless of how
        # tall the rows section gets.  The header packs to the top.
        my $bottom_f = $mw->Frame;
        $bottom_f->pack(-side => 'bottom', -fill => 'x', -pady => 10);
        $mw->Label(-text => 'Probe which host?', -padx => 16, -pady => 8)
            ->pack(-side => 'top', -anchor => 'w');

        # Host rows go in a Canvas-wrapped Frame so the dialog scrolls
        # vertically when there are more candidates than fit on screen.
        my $rows_outer = $mw->Frame;
        $rows_outer->pack(-side => 'top', -fill => 'both', -expand => 1);
        my $canvas = $rows_outer->Canvas(
            -borderwidth        => 0,
            -highlightthickness => 0,
        );
        my $sb = $rows_outer->Scrollbar(
            -orient  => 'vertical',
            -command => [ 'yview', $canvas ],
        );
        $canvas->configure(-yscrollcommand => [ 'set', $sb ]);
        $sb    ->pack(-side => 'right', -fill => 'y');
        $canvas->pack(-side => 'left',  -fill => 'both', -expand => 1);
        my $rows_f = $canvas->Frame;
        my $rows_winid = $canvas->createWindow(0, 0,
            -window => $rows_f, -anchor => 'nw');
        # Keep the scrollregion in sync with the inner frame's natural
        # size, and have the canvas request a height that fits the rows
        # but is capped to ~70% of the screen so the window never grows
        # past where the bottom controls would be off-screen.
        my $cap_h = int($mw->screenheight * 0.70);
        $rows_f->bind('<Configure>', sub {
            $canvas->configure(-scrollregion => [ $canvas->bbox('all') ]);
            my $req_w = $rows_f->reqwidth;
            my $req_h = $rows_f->reqheight;
            $canvas->configure(-width  => $req_w);
            $canvas->configure(-height => $req_h > $cap_h ? $cap_h : $req_h);
        });
        # Mouse wheel scrolls the canvas (X11 buttons 4/5; MouseWheel for
        # systems that send a delta).
        $canvas->Tk::bind('<Button-4>',
                          sub { $canvas->yview('scroll', -3, 'units') });
        $canvas->Tk::bind('<Button-5>',
                          sub { $canvas->yview('scroll',  3, 'units') });
        $canvas->Tk::bind('<MouseWheel>', sub {
            my $d = $Tk::event ? $Tk::event->D : 0;
            $canvas->yview('scroll', $d > 0 ? -3 : 3, 'units');
        });

        # "Hidden" hosts (Forget'd in a previous run) stay out of the
        # picker until the user clicks "Show all", which switches mode
        # so hidden rows reappear with an "Enable" button to un-hide.
        my $show_hidden = 0;
        my @row_widgets;
        my ($show_btn, $rebuild_rows);
        $rebuild_rows = sub {
            $_->destroy for @row_widgets;
            @row_widgets = ();
            my $r = 0;
            for my $i (0 .. $#$cands) {
                my $c    = $cands->[$i];
                my $name = _name_for($c);
                my $is_hidden = $SETTINGS->{$name}{hidden} ? 1 : 0;
                next if $is_hidden && !$show_hidden;
                my $is_fav = $SETTINGS->{$name}{favorite} ? 1 : 0;
                # Per-row chosen user: starts at the resolved ssh-config
                # User (or $USER for the explicit-localhost fallback) and
                # is bound to an Optionmenu so the human can override
                # before clicking the host button.
                my $row_user = $ssh_user
                            // $c->{ssh_user}
                            // $ENV{USER}
                            // ($user_choices[0] // '');
                my ($fav_btn, $main_btn, $user_om, $action_btn);
                $fav_btn = $rows_f->Button(
                    -text => $is_fav ? "\x{2605}" : "\x{2606}",
                    -command => sub {
                        $is_fav = !$is_fav;
                        $SETTINGS->{$name}{favorite} = $is_fav ? 1 : 0;
                        _save_settings($SETTINGS);
                        $fav_btn->configure(
                            -text => $is_fav ? "\x{2605}" : "\x{2606}");
                    });
                $main_btn = $rows_f->Button(
                    -text => _host_label($c), -anchor => 'w',
                    -command => sub {
                        # Send back chosen index + the user from this row
                        # so the parent ssh-probes as exactly that user.
                        print {$wh} "$i\t$row_user\n";
                        close $wh;
                        $mw->destroy;
                    });
                $user_om = $rows_f->Optionmenu(
                    -options => [@user_choices],
                    -variable => \$row_user,
                );
                # Optionmenu defaults to the first option; force it to
                # our resolved/preferred user if it's in the list.
                if (length $row_user
                    && grep { $_ eq $row_user } @user_choices) {
                    $user_om->setOption($row_user);
                }
                if ($is_hidden) {
                    $action_btn = $rows_f->Button(
                        -text => 'Enable',
                        -command => sub {
                            delete $SETTINGS->{$name}{hidden};
                            _save_settings($SETTINGS);
                            $rebuild_rows->();
                        });
                } else {
                    $action_btn = $rows_f->Button(
                        -text => 'Forget',
                        -command => sub {
                            $SETTINGS->{$name}{hidden} = 1;
                            _save_settings($SETTINGS);
                            delete $CACHE->{$name};
                            _save_cache();
                            $rebuild_rows->();
                        });
                }
                $fav_btn   ->grid(-row => $r, -column => 0, -padx => 4, -pady => 1);
                $main_btn  ->grid(-row => $r, -column => 1, -padx => 4, -pady => 1, -sticky => 'ew');
                $user_om   ->grid(-row => $r, -column => 2, -padx => 4, -pady => 1, -sticky => 'ew');
                $action_btn->grid(-row => $r, -column => 3, -padx => 4, -pady => 1);
                push @row_widgets, $fav_btn, $main_btn, $user_om, $action_btn;
                $r++;
            }
        };
        $rebuild_rows->();
        _dbg("[debug] picker: rows built");

        # Show all and Hide swap places: only one is visible at a time.
        # Default view: [Show all] [Cancel].  After clicking Show all:
        # [Hide] [Cancel].
        my ($cancel_btn, $hide_btn);
        $show_btn = $bottom_f->Button(
            -text => 'Show all',
            -command => sub {
                $show_hidden = 1;
                $rebuild_rows->();
                $show_btn->packForget;
                $hide_btn->pack(-side => 'left', -padx => 6,
                                -before => $cancel_btn);
            });
        $hide_btn = $bottom_f->Button(
            -text => 'Hide',
            -command => sub {
                $show_hidden = 0;
                $rebuild_rows->();
                $hide_btn->packForget;
                $show_btn->pack(-side => 'left', -padx => 6,
                                -before => $cancel_btn);
            });
        $cancel_btn = $bottom_f->Button(
            -text => 'Cancel',
            -command => sub { $mw->destroy });
        my $add_btn = $bottom_f->Button(
            -text => 'Add user',
            -command => sub {
                my $top = $mw->Toplevel(-title => 'find-xpra: add user');
                $top->Label(-text => 'New username for the dropdowns:',
                            -padx => 12, -pady => 8)->pack(-anchor => 'w');
                my $name = '';
                my $entry = $top->Entry(-textvariable => \$name, -width => 30);
                $entry->pack(-padx => 12, -pady => 4, -fill => 'x');
                $entry->focus;
                my $bf = $top->Frame->pack(-pady => 8);
                my $accept = sub {
                    $name =~ s/^\s+|\s+$//g;
                    if (length $name) {
                        $SETTINGS->{_users}{$name} = 1;
                        _save_settings($SETTINGS);
                        # Refresh the choices list and rebuild rows so
                        # every dropdown picks up the new option.
                        @user_choices = _ssh_config_users();
                        $rebuild_rows->();
                    }
                    $top->destroy;
                };
                $bf->Button(-text => 'OK',     -command => $accept)
                   ->pack(-side => 'left', -padx => 6);
                $bf->Button(-text => 'Cancel', -command => sub { $top->destroy })
                   ->pack(-side => 'left', -padx => 6);
                $entry->bind('<Return>', $accept);
                $top->protocol('WM_DELETE_WINDOW' => sub { $top->destroy });
            });
        my $keys_btn = $bottom_f->Button(
            -text => 'Keys',
            -command => sub {
                my $top = $mw->Toplevel(-title => 'find-xpra: ssh keys');
                $top->Label(-text => 'Per-user ssh key files (used when '
                                   . '--ssh-key isn\'t given):',
                            -padx => 12, -pady => 8)->pack(-anchor => 'w');
                my %paths;   # user -> scalar holding current path
                for my $u (@user_choices) {
                    my $val = $SETTINGS->{_user_keys}{$u} // '';
                    $paths{$u} = \$val;
                    my $row = $top->Frame;
                    $row->pack(-fill => 'x', -padx => 12, -pady => 2);
                    $row->Label(-text => $u, -width => 12, -anchor => 'w')
                        ->pack(-side => 'left');
                    my $entry = $row->Entry(-textvariable => $paths{$u},
                                            -width => 40);
                    $entry->pack(-side => 'left', -fill => 'x',
                                 -expand => 1, -padx => 4);
                    $row->Button(-text => 'Browse', -command => sub {
                        my $start = "$ENV{HOME}/.ssh";
                        $start = $ENV{HOME} unless -d $start;
                        my $f = $top->getOpenFile(
                            -title      => "ssh key for $u",
                            -initialdir => $start,
                        );
                        ${ $paths{$u} } = $f
                            if defined $f && length $f;
                    })->pack(-side => 'left', -padx => 2);
                    $row->Button(-text => 'Clear', -command => sub {
                        ${ $paths{$u} } = '';
                    })->pack(-side => 'left', -padx => 2);
                }
                my $bf = $top->Frame->pack(-pady => 10);
                $bf->Button(-text => 'Save', -command => sub {
                    for my $u (keys %paths) {
                        my $v = ${ $paths{$u} };
                        $v =~ s/^\s+|\s+$//g if defined $v;
                        if (defined $v && length $v) {
                            $SETTINGS->{_user_keys}{$u} = $v;
                        } else {
                            delete $SETTINGS->{_user_keys}{$u};
                        }
                    }
                    _save_settings($SETTINGS);
                    $top->destroy;
                })->pack(-side => 'left', -padx => 6);
                $bf->Button(-text => 'Cancel',
                            -command => sub { $top->destroy })
                   ->pack(-side => 'left', -padx => 6);
                $top->protocol('WM_DELETE_WINDOW' => sub { $top->destroy });
            });
        # Initial layout: Show all + Add user + Keys + Cancel
        # (Hide kept in reserve — swaps with Show all.)
        $show_btn  ->pack(-side => 'left', -padx => 6);
        $add_btn   ->pack(-side => 'left', -padx => 6);
        $keys_btn  ->pack(-side => 'left', -padx => 6);
        $cancel_btn->pack(-side => 'left', -padx => 6);

        $mw->protocol('WM_DELETE_WINDOW' => sub { $mw->destroy });
        _dbg("[debug] picker: about to MainLoop");
        Tk::MainLoop();
        _dbg("[debug] picker: MainLoop returned");
        # Cancel/window-close: $wh was never written to.  Closing it now
        # signals EOF to the parent so it doesn't block reading.
        close $wh;
        POSIX::_exit(0);
    }
    close $wh;
    my $line = <$rh>;
    close $rh;
    waitpid($pid, 0);
    # The picker subprocess may have written settings (favourites,
    # hidden hosts, added users, per-user keys); reload so the parent
    # sees them for ssh_opts() / probe / attach.
    $SETTINGS = _load_settings();
    return undef unless defined $line && length $line;
    chomp $line;
    my ($idx_str, $picked_user) = split /\t/, $line, 2;
    return undef unless defined $idx_str && $idx_str =~ /^(\d+)$/;
    my $idx = $1 + 0;
    return undef unless $idx < @$cands;
    my $picked = $cands->[$idx];
    # Honour the user the picker selected (overrides any earlier
    # ssh-config resolution) so the probe / attach run as that user.
    $picked->{ssh_user} = $picked_user
        if defined $picked_user && length $picked_user;
    return $picked;
}

# Single MainWindow for the whole process — Tk segfaults if you create,
# destroy, and recreate one.  Lazily initialised; withdrawn until something
# (chooser, no-sessions dialog) actually needs it.  Picker, settings,
# proc-list popups, etc. attach as Toplevels of this.
my $TK_MW;
sub _tk_mw {
    return $TK_MW if $TK_MW;
    _dbg("[debug] _tk_mw: require Tk");
    require Tk;
    _dbg("[debug] _tk_mw: Tk->import");
    Tk->import;
    _dbg("[debug] _tk_mw: MainWindow->new");
    $TK_MW = MainWindow->new(-title => 'find-xpra');
    _dbg("[debug] _tk_mw: MW created, configuring");
    $TK_MW->optionAdd('*Font' => 'sans-serif 11');
    # Don't withdraw — the picker is a subprocess now, so the parent MW
    # doesn't need to be hidden to make room for the picker Toplevel.
    # Withdraw + immediate deiconify on a freshly-created MW seems to be
    # what triggers the segfault on this Tk build.
    _dbg("[debug] _tk_mw: ready");
    return $TK_MW;
}

# --- parallel show-x11 probe ----------------------------------------------

# Mount the on-demand key store (if configured) before we fork — child
# probes inherit the mount and we avoid N races to mount the same path.
_keys_ensure();

my $sel = IO::Select->new;
my %pid_for;
for my $c (@candidates) {
    my $pipe = IO::Pipe->new;
    my $pid  = fork;
    die "fork: $!" unless defined $pid;
    if (!$pid) {
        $pipe->writer;
        # POSIX::_exit (used at the bottom to skip Tk's END handler)
        # also skips stdio buffer flush, so anything Perl-buffered to
        # the pipe is lost.  Autoflush keeps every write reaching the
        # parent immediately.
        $pipe->autoflush(1);
        # --debug: leave stderr attached so the user sees ssh's complaint
        # ("Permission denied", "Connection refused", ...).  Otherwise
        # silence it as before so a tide of "Permission denied"s doesn't
        # drown the probe output.
        open STDERR, '>', '/dev/null' unless $debug;
        # Detach from the controlling tty + close stdin so ssh can't try
        # to read a password off the terminal (N parallel probes would
        # otherwise race for the tty).  ssh falls back to SSH_ASKPASS.
        POSIX::setsid();
        open STDIN, '<', '/dev/null';
        # Defensive self-kill: if we're still alive past the global
        # deadline, take ourselves out so a stuck ssh can't pin a fd or
        # leave a process around.  POSIX::_exit skips END blocks — Tk's
        # END would otherwise try to tear down the X11 fd inherited from
        # the parent picker and crash both processes.
        $SIG{ALRM} = sub { POSIX::_exit(1) };
        alarm($overall_to + 1);
        # Run three stages:
        #   show-x11 -ns -id   -> per-display proc list (apps + machine-id)
        #   xpra list          -> authoritative list of xpra displays, even
        #                         empty ones that show-x11 would miss
        #   cat ~/.xpra-start  -> user's "intended sessions" map; if
        #                         present we'll pivot the picker to show
        #                         these entries (green/red by running)
        # Separators mark the boundaries so the parser can switch modes.
        # No `2>/dev/null` -- a csh/tcsh login shell on the remote chokes
        # on bash-style redirection and the whole probe returns nothing.
        # The cat is `cat -- ~/.xpra-start || true` so a missing file
        # doesn't tank the pipeline; the surrounding parens make it work
        # in both bourne-style and csh-style shells.
        my $remote = 'show-x11 -ns -id; echo __XPRA__; xpra list; '
                   . 'echo __XSTART__; cat ~/.xpra-start; '
                   . 'echo __VNC__; (ss -tln 2>/dev/null || netstat -tln 2>/dev/null); '
                   . 'echo __PSVNC__; ps -eo user,pid,args';
        $remote .= q{; echo __DISPLAYS__; stat -c '%n %U' /tmp/.X11-unix/X*}
            if $any;
        my @cmd = $c->{local}
            ? ('sh', '-c', $remote)
            : ('ssh', ssh_opts(), ssh_target($c), $remote);
        _dbg("[debug] $c->{name}: ",
             join(' ', map { /\s/ ? "'$_'" : $_ } @cmd));
        if (open my $oh, '-|', @cmd) {
            my $disp;
            my $in_xpra   = 0;
            my $in_xstart = 0;
            my $in_vnc    = 0;
            my $in_disps  = 0;
            my $in_psvnc  = 0;
            my %vnc_seen;
            while (defined(my $line = <$oh>)) {
                chomp $line;
                _dbg("[debug] $c->{name}> $line");
                if ($line eq '__XPRA__')     { $in_xpra = 1; $in_xstart = 0; $in_vnc = 0; $in_disps = 0; $in_psvnc = 0; next }
                if ($line eq '__XSTART__')  { $in_xpra = 0; $in_xstart = 1; $in_vnc = 0; $in_disps = 0; $in_psvnc = 0; next }
                if ($line eq '__VNC__')     { $in_xpra = 0; $in_xstart = 0; $in_vnc = 1; $in_disps = 0; $in_psvnc = 0; next }
                if ($line eq '__PSVNC__')   { $in_xpra = 0; $in_xstart = 0; $in_vnc = 0; $in_disps = 0; $in_psvnc = 1; next }
                if ($line eq '__DISPLAYS__'){ $in_xpra = 0; $in_xstart = 0; $in_vnc = 0; $in_disps = 1; $in_psvnc = 0; next }
                if ($in_vnc) {
                    if ($line =~ /:(\d+)\b/ && $1 >= 5900 && $1 <= 5999) {
                        my $port = $1 + 0;
                        next if $vnc_seen{$port}++;
                        my $disp_n = $port - 5900;
                        print { $pipe } join("\t", '__vnc__', $c->{name}, $disp_n, $port), "\n";
                    }
                    next;
                }
                if ($in_psvnc) {
                    next unless $line =~ /^\s*(\S+)\s+(\d+)\s+(.*)/;
                    my ($ps_user, $ps_pid, $ps_cmd) = ($1, $2, $3);
                    # VNC server processes
                    if ($ps_cmd =~ /\b(?:Xvnc|x11vnc|Xtigervnc|Xtightvnc|tigervncserver|vino-server|krfb)\b/) {
                        my $disp_n;
                        if ($ps_cmd =~ /(?:^|\s):(\d+)\b/) { $disp_n = $1 }
                        elsif ($ps_cmd =~ /-display\s+:(\d+)/) { $disp_n = $1 }
                        my $port;
                        if ($ps_cmd =~ /-rfbport\s+(\d+)/) { $port = $1 }
                        $port //= 5900 + ($disp_n // 0) if defined $disp_n;
                        $disp_n //= ($port - 5900) if defined $port && $port >= 5900;
                        print { $pipe } join("\t", '__psvnc__', $c->{name},
                                             $disp_n // '', $port // '', $ps_user), "\n";
                    }
                    # Xpra server processes (Xdummy/Xvfb started by xpra)
                    if ($ps_cmd =~ /\b(?:xpra_Xdummy|Xdummy|Xvfb)\b.*(?:^|\s):(\d+)\b/) {
                        print { $pipe } join("\t", '__psxpra__', $c->{name},
                                             $1, $ps_user), "\n";
                    }
                    elsif ($ps_cmd =~ /\bxpra\s+(?:start|start-desktop)\b.*(?:^|\s):(\d+)\b/) {
                        print { $pipe } join("\t", '__psxpra__', $c->{name},
                                             $1, $ps_user), "\n";
                    }
                    next;
                }
                if ($in_disps) {
                    # stat -c '%n %U' output: /tmp/.X11-unix/X20 claude
                    if ($line =~ /X(\d+)\s+(\S+)/) {
                        print { $pipe } join("\t", '__disp__', $c->{name}, $1, $2), "\n";
                    }
                    next;
                }
                if ($in_xstart) {
                    # ~/.xpra-start lines: "<n>: <cmd>" or ":<n>: <cmd>".
                    # Skip blanks and comments.  Strip inline `#` comments.
                    (my $l = $line) =~ s/#.*//;
                    next if $l =~ /^\s*$/;
                    if ($l =~ /^\s*:?(\d+)\s*:\s*(\S.*?)\s*$/) {
                        print { $pipe } join("\t", '__xs__', $c->{name}, $1, $2), "\n";
                    }
                    next;
                }
                if ($in_xpra) {
                    # `xpra list` lines like:  "\tLIVE session at :20"
                    # Dedup happens parent-side via the row hash.
                    if ($line =~ /\bLIVE session at\s+(:\d+)\b/) {
                        print { $pipe } join("\t", '__xpra__', $c->{name}, $1), "\n";
                    }
                    next;
                }
                if ($line =~ /^#\s*host:\s*(\S*)\s+id:\s*(\S*)/) {
                    print { $pipe } join("\t", '__id', $c->{name}, $1, $2), "\n";
                } elsif ($line =~ /^(:\d+)\s*$/) {
                    $disp = $1;
                } elsif (defined $disp
                         # show-x11 emits `printf("%s  %8s %-8s %s\n", ...)`
                         # — pid is right-justified in 8 cols and the USER
                         # field is exactly 8 cols, *all spaces if blank*.
                         # Greedy `(\S+)` would otherwise eat the command's
                         # first token as the user.
                         && $line =~ /^\s+(\d+) (.{8}) (.+?)\s*$/) {
                    my ($pid, $user, $cmd) = ($1, $2, $3);
                    $user =~ s/^\s+|\s+$//g;
                    print { $pipe } join("\t", $c->{name}, $disp, $pid, $user, $cmd), "\n";
                }
            }
            close $oh;
        }
        # POSIX::_exit, not exit — Tk loaded in parent for the picker
        # leaves an END handler that closes the (shared) X11 fd; running
        # it from the forked child segfaults the parent.
        POSIX::_exit(0);
    }
    $pipe->reader;
    $sel->add($pipe);
    $pid_for{$pid} = $pipe;
}

my @rows;
my %xpra_listed;     # "$host\t$disp" -> 1 (display reported by `xpra list`)
my %vnc_ports;       # "$host\t$disp_n" -> port (VNC port from ss/netstat)
my %any_displays;    # "$host\t$disp_n" -> user (from /tmp/.X11-unix stat)
my @psvnc;           # [{host, disp_n, port, user}, ...] (from ps VNC scan)
my @psxpra;          # [{host, disp_n, user}, ...] (from ps xpra scan)
my %vnc_users;       # "$host\t$user" -> 1 (users running a VNC server)
my %remote_id;       # candidate-name -> machine-id (from `show-x11 -id`)
my %remote_host;     # candidate-name -> remote `hostname`
my %xs_for_host;     # candidate-name -> [ {disp_n, cmd}, ... ]
my %buf;
my $deadline = time + $overall_to;
while ($sel->count) {
    my $remain = $deadline - time;
    last if $remain <= 0;
    my @ready = $sel->can_read($remain);
    last unless @ready;
    for my $h (@ready) {
        my $n = sysread($h, my $chunk, 4096);
        if (!$n) { $sel->remove($h); close $h; next }
        $buf{0+$h} .= $chunk;
        while ($buf{0+$h} =~ s/^([^\n]*)\n//) {
            my $line = $1;
            if ($line =~ /^__id\t([^\t]*)\t([^\t]*)\t([^\t]*)$/) {
                $remote_host{$1} = $2;
                $remote_id{$1}   = $3;
            } elsif ($line =~ /^__xpra__\t([^\t]*)\t([^\t]*)$/) {
                $xpra_listed{"$1\t$2"} = 1;
            } elsif ($line =~ /^__xs__\t([^\t]*)\t([^\t]*)\t([^\t]*)$/) {
                push @{ $xs_for_host{$1} },
                    { disp_n => $2 + 0, cmd => $3 };
            } elsif ($line =~ /^__vnc__\t([^\t]*)\t([^\t]*)\t([^\t]*)$/) {
                $vnc_ports{"$1\t$2"} = $3 + 0;
            } elsif ($line =~ /^__disp__\t([^\t]*)\t([^\t]*)\t([^\t]*)$/) {
                $any_displays{"$1\t$2"} = $3;
            } elsif ($line =~ /^__psvnc__\t/) {
                my @f = split /\t/, $line;
                if (length $f[2]) {
                    push @psvnc, { host => $f[1], disp_n => $f[2]+0,
                                   port => (length $f[3] ? $f[3]+0 : undef),
                                   user => $f[4] };
                }
                $vnc_users{"$f[1]\t$f[4]"} = 1 if defined $f[4];
            } elsif ($line =~ /^__psxpra__\t([^\t]*)\t([^\t]*)\t([^\t]*)$/) {
                push @psxpra, { host => $1, disp_n => $2+0, user => $3 };
            } else {
                my @f = split /\t/, $line, 5;
                push @rows, \@f if @f == 5;
            }
        }
    }
}
_dbg("[debug] parent: select-loop done, "
     . scalar(@rows) . " rows, "
     . scalar(keys %xpra_listed) . " xpra-listed, "
     . scalar(keys %vnc_ports) . " vnc-ports");
# Kill stragglers — TERM first, brief grace, then KILL so a stuck ssh
# can't leave the parent waiting indefinitely for the kernel to reap.
for my $pid (keys %pid_for) {
    kill 'TERM', $pid if waitpid($pid, POSIX::WNOHANG()) == 0;
}
my $kdeadline = time + 1;
for my $pid (keys %pid_for) {
    while (waitpid($pid, POSIX::WNOHANG()) == 0 && time < $kdeadline) {
        select undef, undef, undef, 0.05;
    }
    if (waitpid($pid, POSIX::WNOHANG()) == 0) {
        kill 'KILL', $pid;
        waitpid($pid, 0);
    }
}

# Dedupe aliased hosts: every show-x11 -id call printed `# host: H id: M`
# from /etc/machine-id.  Hosts sharing a machine-id are aliases for the
# same physical box (e.g. nas3-up / nas3-down on different NICs).  Pick
# the remote-reported hostname as canonical when available; otherwise
# the candidate name with no dashes / shortest.
{
    my %hosts_by_id;
    push @{ $hosts_by_id{$remote_id{$_}} }, $_
        for grep { defined $remote_id{$_} && length $remote_id{$_} } keys %remote_id;

    my %canonical;
    for my $id (keys %hosts_by_id) {
        my @group = @{ $hosts_by_id{$id} };
        next unless @group > 1;
        my $canon;
        # Prefer the host's own self-reported name if any group member
        # reported one (and it's reachable in this run).
        for my $h (@group) {
            if (defined $remote_host{$h} && length $remote_host{$h}) {
                $canon = $remote_host{$h};
                last;
            }
        }
        $canon //= (sort {
               (($a =~ /-/ ? 1 : 0) <=> ($b =~ /-/ ? 1 : 0))
            || (length($a) <=> length($b))
            || ($a cmp $b)
        } @group)[0];
        $canonical{$_} = $canon for @group;
    }
    # Always fold the local host under "localhost", whatever net-mgr named
    # it (e.g. usb15_1), so its sessions group there rather than under the
    # box's real hostname.  Reuse the relabel machinery below.
    {
        my %local_name = map  { $_->{name} => 1 }
                         grep { $_->{local} && defined $_->{name}
                                && $_->{name} ne 'localhost' } @candidates;
        if (%local_name) {
            # Aliases already collapsed onto a local name → localhost too.
            for my $k (keys %canonical) {
                $canonical{$k} = 'localhost' if $local_name{ $canonical{$k} };
            }
            $canonical{$_} = 'localhost' for keys %local_name;
            # Rename the candidate(s) so the _name_for-keyed maps below
            # (local_for_name / ip_for_name / ...) key on localhost.
            $_->{local} and $_->{name} = 'localhost' for @candidates;
        }
    }
    if (%canonical) {
        $_->[0] = $canonical{$_->[0]} // $_->[0] for @rows;
        my %relabelled;
        for my $key (keys %xpra_listed) {
            my ($h, $d) = split /\t/, $key, 2;
            my $h2 = $canonical{$h} // $h;
            $relabelled{"$h2\t$d"} = 1;
        }
        %xpra_listed = %relabelled;
        my %xs_relabelled;
        for my $h (keys %xs_for_host) {
            my $h2 = $canonical{$h} // $h;
            push @{ $xs_relabelled{$h2} }, @{ $xs_for_host{$h} };
        }
        %xs_for_host = %xs_relabelled;
        my %vnc_relabelled;
        for my $key (keys %vnc_ports) {
            my ($h, $d) = split /\t/, $key, 2;
            my $h2 = $canonical{$h} // $h;
            $vnc_relabelled{"$h2\t$d"} = $vnc_ports{$key};
        }
        %vnc_ports = %vnc_relabelled;
        for my $v (@psvnc) {
            $v->{host} = $canonical{$v->{host}} // $v->{host};
        }
        for my $v (@psxpra) {
            $v->{host} = $canonical{$v->{host}} // $v->{host};
        }
        my %vu_relabelled;
        for my $key (keys %vnc_users) {
            my ($h, $u) = split /\t/, $key, 2;
            my $h2 = $canonical{$h} // $h;
            $vu_relabelled{"$h2\t$u"} = 1;
        }
        %vnc_users = %vu_relabelled;
        my %ad_relabelled;
        for my $key (keys %any_displays) {
            my ($h, $d) = split /\t/, $key, 2;
            my $h2 = $canonical{$h} // $h;
            $ad_relabelled{"$h2\t$d"} = $any_displays{$key};
        }
        %any_displays = %ad_relabelled;
    }
}

# Aggregate process rows into one entry per (host, display).
my %ip_for_name    = map { _name_for($_) => $_->{ip}       } @candidates;
my %local_for_name = map { _name_for($_) => $_->{local}    } @candidates;
my %user_for_name  = map { _name_for($_) => $_->{ssh_user} } @candidates;
my %extra_for_name = map { _name_for($_) => $_->{_extra}   } grep { $_->{_extra} } @candidates;
my %by_session;       # "$host\t$disp" -> { host, disp, kind, user, cmds, n }
# Seed sessions reported by `xpra list` first — that way an xpra session
# with no surviving show-x11 procs (or no apps at all) still appears.
# User is seeded with whoever we logged in as: $ENV{USER} for the local
# probe, the per-candidate ssh-config-resolved user for remote probes
# (or $ssh_user / $ENV{USER} as fallbacks).
for my $key (keys %xpra_listed) {
    my ($host, $disp) = split /\t/, $key, 2;
    my $is_local = $local_for_name{$host};
    my $user_seed = $is_local
        ? ($ENV{USER} // '')
        : ($ssh_user // $user_for_name{$host} // $ENV{USER} // '');
    $by_session{$key} = { host=>$host, disp=>$disp, user=>$user_seed,
                          cmds=>[], procs=>[], n=>0, kind=>'xpra',
                          xpra_listed=>1 };
}
for my $key (keys %vnc_ports) {
    my ($host, $disp_n) = split /\t/, $key, 2;
    my $disp = ":$disp_n";
    my $sess_key = "$host\t$disp";
    if (my $existing = $by_session{$sess_key}) {
        $existing->{kind} = 'vnc' unless $existing->{kind} eq 'xpra';
        $existing->{vnc_port} //= $vnc_ports{$key};
        next;
    }
    my $is_local = $local_for_name{$host};
    my $user_seed = $is_local
        ? ($ENV{USER} // '')
        : ($ssh_user // $user_for_name{$host} // $ENV{USER} // '');
    $by_session{$sess_key} = { host=>$host, disp=>$disp, user=>$user_seed,
                               cmds=>[], procs=>[], n=>0, kind=>'vnc',
                               vnc_port=>$vnc_ports{$key} };
}
for my $key (keys %any_displays) {
    my ($host, $disp_n) = split /\t/, $key, 2;
    my $disp = ":$disp_n";
    my $sess_key = "$host\t$disp";
    my $owner  = $any_displays{$key};
    my $is_vnc = $vnc_ports{"$host\t$disp_n"} ? 1 : 0;
    if (my $existing = $by_session{$sess_key}) {
        $existing->{user} = $owner;
        if ($is_vnc) {
            $existing->{kind} = 'vnc' unless $existing->{kind} eq 'xpra';
            $existing->{vnc_port} //= 5900 + $disp_n;
        }
        next;
    }
    my $kind_default = $is_vnc      ? 'vnc'
                     : $disp_n == 0 ? 'X'
                     :                'xpra';
    $by_session{$sess_key} = { host=>$host, disp=>$disp, user=>$owner,
                               cmds=>[], procs=>[], n=>0, kind=>$kind_default,
                               ($is_vnc ? (vnc_port => 5900 + $disp_n) : ()) };
}
for my $v (@psvnc) {
    my $disp = ":$v->{disp_n}";
    my $sess_key = "$v->{host}\t$disp";
    if (my $existing = $by_session{$sess_key}) {
        $existing->{kind} = 'vnc' unless $existing->{kind} eq 'xpra';
        $existing->{vnc_port} //= $v->{port} if defined $v->{port};
        $existing->{user} = $v->{user} if defined $v->{user} && length $v->{user};
        next;
    }
    $by_session{$sess_key} = { host=>$v->{host}, disp=>$disp, user=>$v->{user},
                               cmds=>[], procs=>[], n=>0, kind=>'vnc',
                               vnc_port=>$v->{port} };
}
for my $v (@psxpra) {
    my $disp = ":$v->{disp_n}";
    my $sess_key = "$v->{host}\t$disp";
    if (my $existing = $by_session{$sess_key}) {
        $existing->{kind} //= 'xpra';
        $existing->{user} = $v->{user} if defined $v->{user} && length $v->{user};
        next;
    }
    $by_session{$sess_key} = { host=>$v->{host}, disp=>$disp, user=>$v->{user},
                               cmds=>[], procs=>[], n=>0, kind=>'xpra' };
}
for my $r (@rows) {
    my ($host, $disp, $pid, $user, $cmd) = @$r;
    my $key = "$host\t$disp";
    # Default kind by display number: <:20 is presumed plain X, :20+ is
    # presumed xpra.  Overridden to 'xpra' for displays `xpra list`
    # confirmed.
    my ($n) = $disp =~ /^:(\d+)$/;
    my $kind_default = (defined $n && $n >= 20) ? 'xpra' : 'X';
    my $s = $by_session{$key} //= { host=>$host, disp=>$disp, user=>$user,
                                     cmds=>[], procs=>[], n=>0, kind=>$kind_default };
    $s->{kind} = 'xpra' if $xpra_listed{$key};
    # Prefer a non-empty user — some procs (eg. pulseaudio in xpra
    # sessions) report no USER and would otherwise lock in the session
    # owner as ''.
    $s->{user} = $user if length $user && !length $s->{user};
    $s->{n}++;
    push @{ $s->{procs} }, { pid => $pid, user => $user, cmd => $cmd };
    # Drop session-plumbing daemons; keep candidate "main apps" with args.
    next if $cmd =~ m{\b(?:dbus-daemon|dbus-launch|dconf-service|gvfsd|gvfs-?\S*|xdg-\S+|ibus-\S+|pulseaudio|gnome-keyring|at-spi\S*|xpra/?\S*daemonizer|sleep)\b};
    next if $cmd =~ m{/sbin/init|/lib/systemd|cron|sshd|mate-session|lxsession};
    # Drop sub-process helpers spawned by the main app.  The user-launched
    # firefox/chrome/electron we want is the parent — its forked children
    # carry -contentproc / --type=renderer-style flags.
    next if $cmd =~ m{(?:crashhelper|-helper\b|RemoteSandbox|GMPProcess|NetworkBroker|content-process)};
    next if $cmd =~ m{\s-contentproc\b|\s--type=\S};
    # X / VNC servers are session infrastructure, not user-launched apps.
    # Tag the session as VNC when we spot a VNC server process.
    if ($cmd =~ m{^(?:\S*/)?(?:Xvnc|Xtightvnc|x11vnc|Xtigervnc|krfb|vino-server|tigervncserver)\b}) {
        $s->{kind} = 'vnc' unless $s->{kind} eq 'xpra';
        $s->{vnc_port} //= 5900 + $n if defined $n;
    }
    $s->{vnc_port} //= $vnc_ports{"$host\t$n"} if defined $n;
    next if $cmd =~ m{^(?:\S*/)?(?:Xvnc|Xtightvnc|x11vnc|Xvfb|Xorg|Xtigervnc|krfb|vino-server|tigervncserver)\b};
    push @{ $s->{cmds} }, $cmd;
}

# Pick the "main app" cmdline for each session.  Heuristic:
#   1. Prefer cmds that aren't just a bare interactive shell.
#   2. Among the rest, prefer the one with the most arguments — a user-
#      invoked app like `thunderbird -P Calendar` carries args, while a
#      window-manager / wrapper typically doesn't.
#   3. Fall back to the first command if everything's a shell.
# Known GUI applications — always beat generic / shell / network tools.
my %gui_app = map { $_ => 1 } qw(
    firefox firefox-bin firefox-esr iceweasel
    chromium chromium-browser google-chrome chrome brave brave-browser
    qutebrowser nyxt epiphany
    thunderbird
    code codium vscodium electron
    libreoffice soffice loimpress lowriter localc
    gimp inkscape blender krita
    audacity vlc mpv totem
    discord slack signal-desktop telegram-desktop element-desktop zoom
    keepassxc gnumeric abiword
    emacs gvim
);

sub _argv0_basename {
    my ($cmd) = @_;
    my ($a) = $cmd =~ /^(\S+)/;
    return '' unless defined $a;
    $a =~ s{^.*/}{};
    return $a;
}

sub _main_cmd {
    my @cmds = @_;
    return '' unless @cmds;
    # Drop bare interactive shells with no args.
    my @nonshell = grep {
        $_ !~ m{^(?:/usr|/bin)?/?(?:bin/)?(?:bash|sh|csh|tcsh|zsh|ksh|fish)\s*(?:-\S+\s*)*$}
    } @cmds;
    @nonshell = @cmds unless @nonshell;
    # Tier 1: known GUI apps (firefox, thunderbird, code, ...) always
    # beat ssh, vim-in-xterm, generic invocations, etc.  Among multiple
    # GUI apps, longest invocation wins.
    my @gui = grep { $gui_app{ _argv0_basename($_) } } @nonshell;
    if (@gui) {
        return (sort { (() = $b =~ /\s\S/g) <=> (() = $a =~ /\s\S/g)
                    || length($b) <=> length($a) } @gui)[0];
    }
    # De-prioritize shell -c wrappers — the user's "main app" is usually
    # whatever a real GUI binary is, not the wrapping `sh -c '...'`.
    my @shellc  = grep {  m{^(?:/usr|/bin)?/?(?:bin/)?(?:ba|c|t|z|k)?sh\s+-c\b} } @nonshell;
    my @primary = grep { !m{^(?:/usr|/bin)?/?(?:bin/)?(?:ba|c|t|z|k)?sh\s+-c\b} } @nonshell;
    my @ranked  = @primary ? @primary : @shellc;
    # Pick the entry with the most arg tokens (longest user invocation).
    return (sort { (() = $b =~ /\s\S/g) <=> (() = $a =~ /\s\S/g)
                || length($b) <=> length($a) } @ranked)[0];
}

# Format the main cmd for display: basename + args, capped.
sub _fmt_cmd {
    my ($cmd, $max) = @_;
    return '(daemons only)' unless length $cmd;
    my ($argv0, $rest) = split /\s+/, $cmd, 2;
    $argv0 =~ s{^.*/}{};
    my $out = defined $rest && length $rest ? "$argv0 $rest" : $argv0;
    $out =~ s/\s+$//;
    $out = substr($out, 0, $max - 3) . '...' if length($out) > $max;
    return $out;
}

my @sessions = values %by_session;

# Stamp each session with an IP (looked up from candidates by name) and a
# numeric display.  Drop displays under :20 unless --all was given —
# they're presumed plain X (see kind heuristic above).
for my $s (@sessions) {
    ($s->{disp_n}) = $s->{disp} =~ /^:(\d+)/;
    $s->{ip}       = $ip_for_name{$s->{host}};
    $s->{local}    = $local_for_name{$s->{host}} ? 1 : 0;
    $s->{_extra}   = 1 if $extra_for_name{$s->{host}};
}
# --host fallback: if a manually-added host produced no sessions (or has a
# pinned display number), offer that display.
{
    my %seen = map { ("$_->{host}\t$_->{disp}", 1) } @sessions;
    for my $c (grep { $_->{_extra} } @candidates) {
        my $name = _name_for($c);
        my $dn = $c->{_disp} // 0;
        next if $seen{"$name\t:$dn"};
        # If sessions were found but no pinned display requested, skip
        next if !defined $c->{_disp} && (grep { $_->{host} eq $name } @sessions);
        # Default kind by display number (same heuristic as the main
        # aggregation): :20+ is presumed xpra, otherwise plain X.  Without
        # this, an explicitly-added xpra host whose probe couldn't reach
        # it (eg cross-subnet SSH failure) reads as base X and the action
        # menu drops 'Attach'.
        my $kind = ($dn >= 20) ? 'xpra' : 'X';
        my $apps = $kind eq 'xpra' ? '(xpra)' : '(root display)';
        push @sessions, { host => $name, disp => ":$dn", disp_n => $dn,
                          ip => $c->{ip}, local => 0, kind => $kind,
                          user => $ssh_user // $user_for_name{$name} // $ENV{USER} // '',
                          cmds => [], procs => [], n => 0,
                          apps => $apps, _extra => 1 };
    }
}
unless ($all || $any) {
    # Lower-bound only here (hide presumed-plain-X displays under :20).
    # The high-display ceiling is applied as a single final gate further
    # down, after the .xpra-start pivot and --any merge have added their
    # sessions — otherwise those late additions leak past the limit.
    @sessions = grep {
        $_->{kind} eq 'vnc' || $_->{_extra}
        || (defined $_->{disp_n} && $_->{disp_n} >= 20)
    } @sessions;
}
if (defined $user && !$any) {
    @sessions = grep { defined $_->{user} && $_->{user} eq $user } @sessions;
}

# Dedup xpra-start entries by (host, disp_n).  When a single physical
# box appears via multiple net-mgr machine rows (e.g. nas3's three NICs
# each registered as a separate machine, all flagged local) we run the
# probe N times and push N copies of every ~/.xpra-start line under the
# same host key.  The canonical-name relabel block above also
# concatenates entries from multiple aliases.  Without this dedup the
# pivot loop below emits N identical rows per display.
for my $h (keys %xs_for_host) {
    my %seen;
    $xs_for_host{$h} = [ grep { !$seen{$_->{disp_n}}++ } @{ $xs_for_host{$h} } ];
}

# If a host published a ~/.xpra-start file, pivot the picker to its
# entries.  For each line we either:
#   - reuse the live session detected at that display, or
#   - synthesize a stub session if nothing's running there yet,
# then mark _xs_running based on whether a process matching the
# expected command is observed on that display.  Sessions detected on
# the host but absent from .xpra-start are dropped — the start file is
# the source of truth when present.
for my $host (keys %xs_for_host) {
    my @entries = @{ $xs_for_host{$host} };
    next unless @entries;
    my @host_existing = grep { $_->{host} eq $host } @sessions;
    my %by_disp = map { $_->{disp_n} => $_ } @host_existing;
    my $h_local  = $host_existing[0] && $host_existing[0]{local};
    my $h_ip     = $local_for_name{$host} ? '127.0.0.1' : $ip_for_name{$host};
    my $h_user   = $local_for_name{$host}
                 ? ($ENV{USER} // '')
                 : ($ssh_user // $user_for_name{$host} // $ENV{USER} // '');
    my @new;
    for my $e (@entries) {
        my $existing = $by_disp{$e->{disp_n}};
        my $base = lc(_argv0_basename($e->{cmd}));
        my $running = 0;
        if ($existing && length $base) {
            for my $p (@{ $existing->{procs} }) {
                if (index(lc(_argv0_basename($p->{cmd})), $base) >= 0
                 || index(lc($p->{cmd}), $base) >= 0) {
                    $running = 1;
                    last;
                }
            }
        }
        my $s = $existing // {
            host        => $host,
            disp        => ":$e->{disp_n}",
            disp_n      => $e->{disp_n},
            kind        => 'xpra',
            user        => $h_user,
            n           => 0,
            cmds        => [],
            procs       => [],
            xpra_listed => 0,
            local       => $h_local ? 1 : 0,
            ip          => $h_ip,
        };
        $s->{apps}        = $e->{cmd};
        $s->{_xs_cmd}     = $e->{cmd};
        $s->{_xs_running} = $running;
        push @new, $s;
    }
    my %new_disp = map { $_->{disp_n} => 1 } @new;
    @sessions = grep {
        $_->{host} ne $host
        || (($_->{user} // '') ne $h_user)
        || ($_->{kind} eq 'vnc' && !$new_disp{$_->{disp_n}})
    } @sessions;
    push @sessions, @new;
}

# --- probe other users' ~/.xpra-start (--any) --------------------------------
# SSH as each other user to grab their intended-sessions file, then merge
# into @sessions.  Blue = running, grey = not running.
if ($any) {
    my $own_user = $ssh_user // $ENV{USER} // '';
    my %to_probe;
    for my $s (@sessions) {
        next unless defined $s->{user} && length $s->{user};
        next if $s->{user} eq $own_user;
        next if $s->{kind} eq 'vnc';
        $to_probe{"$s->{host}\t$s->{user}"} //= {
            host => $s->{host}, user => $s->{user},
            ip => $s->{ip}, local => $s->{local},
        };
    }
    if (%to_probe) {
        _keys_ensure();
        my $sel2 = IO::Select->new;
        my %pid2;
        for my $key (keys %to_probe) {
            my $info = $to_probe{$key};
            my $pipe = IO::Pipe->new;
            my $pid  = fork;
            die "fork: $!" unless defined $pid;
            if (!$pid) {
                $pipe->writer;
                $pipe->autoflush(1);
                open STDERR, '>', '/dev/null' unless $debug;
                POSIX::setsid();
                open STDIN, '<', '/dev/null';
                $SIG{ALRM} = sub { POSIX::_exit(1) };
                alarm(10);
                my @sopts = (
                    '-o', "ConnectTimeout=$ssh_to",
                    '-o', 'StrictHostKeyChecking=accept-new',
                    '-o', 'ServerAliveInterval=3',
                    '-o', 'ServerAliveCountMax=2',
                );
                my $ukey = $SETTINGS->{_user_keys}{$info->{user}};
                push @sopts, '-i', $ukey if defined $ukey && length $ukey;
                if ($no_prompt) {
                    push @sopts, '-o', 'BatchMode=yes',
                        '-o', 'NumberOfPasswordPrompts=0',
                        '-o', 'PreferredAuthentications=publickey';
                }
                my $login = "$info->{user}\@$info->{host}";
                if (defined $info->{ip} && $info->{ip} ne $info->{host}) {
                    push @sopts, '-o', "HostName=$info->{ip}";
                }
                my @cmd = ('ssh', @sopts, $login, 'cat ~/.xpra-start');
                _dbg("[debug] xs-other: ", join(' ', @cmd));
                if (open my $oh, '-|', @cmd) {
                    while (<$oh>) {
                        chomp;
                        (my $l = $_) =~ s/#.*//;
                        next if $l =~ /^\s*$/;
                        if ($l =~ /^\s*:?(\d+)\s*:\s*(\S.*?)\s*$/) {
                            print {$pipe} join("\t",
                                $info->{host}, $info->{user}, $1, $2), "\n";
                        }
                    }
                    close $oh;
                }
                POSIX::_exit(0);
            }
            $pipe->reader;
            $sel2->add($pipe);
            $pid2{$pid} = $pipe;
        }
        my %xs_other;
        my %buf2;
        my $deadline2 = time + 10;
        while ($sel2->count) {
            my $remain = $deadline2 - time;
            last if $remain <= 0;
            my @ready = $sel2->can_read($remain);
            last unless @ready;
            for my $h (@ready) {
                my $n = sysread($h, my $chunk, 4096);
                if (!$n) { $sel2->remove($h); close $h; next }
                $buf2{0+$h} .= $chunk;
                while ($buf2{0+$h} =~ s/^([^\n]*)\n//) {
                    my ($host, $xu, $dn, $cmd) = split /\t/, $1, 4;
                    push @{ $xs_other{"$host\t$xu"} },
                        { disp_n => $dn + 0, cmd => $cmd };
                }
            }
        }
        for my $pid (keys %pid2) {
            kill 'TERM', $pid if waitpid($pid, POSIX::WNOHANG()) == 0;
        }
        my $kd = time + 1;
        for my $pid (keys %pid2) {
            while (waitpid($pid, POSIX::WNOHANG()) == 0 && time < $kd) {
                select undef, undef, undef, 0.05;
            }
            kill('KILL', $pid), waitpid($pid, 0)
                if waitpid($pid, POSIX::WNOHANG()) == 0;
        }
        _dbg("[debug] xs-other: " . scalar(keys %xs_other) . " users responded");

        my %existing_disp;
        for my $s (@sessions) {
            $existing_disp{"$s->{host}\t$s->{disp_n}"} = $s;
        }
        for my $key (keys %xs_other) {
            my ($host, $xu) = split /\t/, $key, 2;
            for my $e (@{ $xs_other{$key} }) {
                my $dk = "$host\t$e->{disp_n}";
                my $existing = $existing_disp{$dk};
                my $running = $existing ? 1 : 0;
                my $s = $existing // {
                    host    => $host,
                    disp    => ":$e->{disp_n}",
                    disp_n  => $e->{disp_n},
                    kind    => 'xpra',
                    user    => $xu,
                    n       => 0,
                    cmds    => [],
                    procs   => [],
                    local   => $local_for_name{$host} ? 1 : 0,
                    ip      => $ip_for_name{$host},
                };
                $s->{apps}            = $e->{cmd};
                $s->{_xs_cmd}         = $e->{cmd};
                $s->{_xs_running}     = $running;
                $s->{_xs_other_user}  = 1;
                $s->{_attach_as}      = $xu;
                $s->{user}            = $xu;
                unless ($existing) {
                    push @sessions, $s;
                    $existing_disp{$dk} = $s;
                }
            }
        }
    }
}

# Final high-display ceiling — drop sessions above the ceiling from the
# data model after every source (discovery, .xpra-start pivot, --any
# merge) has populated @sessions.  Applies even under --all / --any:
# nothing above the ceiling (default 9999) is a real display — they're
# xpra shadow/proxy synthetic IDs (e.g. :1295132).  --all/--any show
# low/plumbing displays and other users' sessions, not impossible high
# ones.  _row_visible() re-checks at render time; this also keeps the
# high IDs out of the cache.  Set max display 0 (Settings) to disable.
if (defined $max_disp) {
    @sessions = grep {
        !defined $_->{disp_n} || $_->{disp_n} <= $max_disp
    } @sessions;
}

# Hard-removed displays (Remove action) are gone for good — drop them from
# the model entirely so the reap timer never polls them and the ↕ toggle
# can't reveal them.  Recover only by editing _removed in the config file.
if (my $rm = $SETTINGS->{_removed}) {
    @sessions = grep {
        !defined $_->{disp_n} || !$rm->{ "$_->{host}\t$_->{disp_n}" }
    } @sessions;
}

my %_usage = %{ $SETTINGS->{_usage} // {} };
@sessions = sort {
       ($b->{local}//0) <=> ($a->{local}//0)
    || ($_usage{$b->{host}}//0) <=> ($_usage{$a->{host}}//0)
    || $a->{host} cmp $b->{host}
    || $a->{disp_n} <=> $b->{disp_n}
} @sessions;

# Build display rows: pick a main cmd and format it.  An xpra-listed
# session with no surviving non-daemon procs reads as "(empty xpra)" so
# the user can still attach to it.  Rows sourced from a remote
# ~/.xpra-start are exempt — their apps text is the user's intended
# command, regardless of what's actually running on the display.
for my $s (@sessions) {
    next if defined $s->{_xs_cmd};
    next if $s->{_extra} && defined $s->{apps};
    my $main = _main_cmd(@{ $s->{cmds} });
    my $own_user = $ssh_user // $ENV{USER} // '';
    my $other_user = $any && defined $s->{user} && length $s->{user}
                   && $s->{user} ne $own_user;
    if ($other_user) {
        $s->{_attach_as} = $s->{user};
    }
    $s->{apps} = length $main           ? _fmt_cmd($main, 60)
               : $s->{xpra_listed}      ? '(empty xpra)'
               : $s->{kind} eq 'vnc'    ? '(vnc)'
               : $other_user            ? '(login required)'
               :                          '(daemons only)';
}
# Apply per-host SSH user overrides (Settings dialog, or a user typed
# into the Add/Edit-host dialog) so attach / VNC / SSH actions log in as
# that user, not just the discovery probe.
for my $s (@sessions) {
    my $u = _host_login_user($s->{host}, $s->{ip});
    $s->{_attach_as} = $u if defined $u;
}

# Drop sessions whose only contents are session plumbing (no real app to
# attach to).  Keep xpra-listed and vnc sessions even if empty — the user
# might specifically want to attach.  --all/--any keeps everything.
unless ($all || $any) {
    @sessions = grep {
        $_->{apps} ne '(daemons only)' || $_->{kind} eq 'vnc'
    } @sessions;
}

# Cache successful probe results per host so the next picker run shows
# "[N sess Tm ago]" labels — useful when ssh isn't working today.  Only
# update on positive results (>0 sessions); a transient failure shouldn't
# erase a known-good entry.
{
    my %sess_count;
    $sess_count{$_->{host}}++ for @sessions;
    my $changed;
    for my $host (keys %sess_count) {
        $CACHE->{$host} = { ts => time, n_sessions => $sess_count{$host} };
        $changed = 1;
    }
    _save_cache() if $changed;
}

_dbg("[debug] parent: " . scalar(@sessions) . " sessions ready, "
     . ($list_only ? '--list mode' : 'about to open Tk chooser'));

unless (@sessions) {
    if ($list_only) { print STDERR "no X11/xpra/VNC sessions found\n"; exit 1 }
    my $mw = _tk_mw();
    $mw->title('find-xpra');
    $mw->deiconify;
    $mw->Label(-text => 'No X11/xpra/VNC sessions found.', -padx => 30, -pady => 30)
       ->pack;
    # Destroy the window so MainLoop returns cleanly, then exit at
    # the script level — calling `exit` directly from inside a Tk
    # callback unwinds Perl while MainLoop is still on the stack and
    # Tk's END handler then segfaults tearing down a half-live UI.
    $mw->Button(-text => 'Close', -command => sub { $mw->destroy })
       ->pack(-pady => 6);
    Tk::MainLoop();
    exit 1;
}

if ($list_only) {
    printf "%-16s %-6s %-5s %-8s %-4s %s\n",
        'HOST','DISP','KIND','USER','PROC','APPS';
    for my $s (@sessions) {
        printf "%-16s %-6s %-5s %-8s %-4d %s\n",
            $s->{host}, $s->{disp}, $s->{kind}, $s->{user}, $s->{n}, $s->{apps};
    }
    exit 0;
}

# --- adopt pre-existing viewer processes -----------------------------------
# Scan for running xpra-attach / vncviewer processes so the UI shows them
# as already connected.  These are not our children (spawned by a prior
# find-xpra instance or manually), so we track them with kill(0) instead
# of waitpid.

sub _scan_attached {
    my @found;
    open my $h, '-|', 'ps', '-eo', 'pid,args' or return [];
    while (<$h>) {
        s/^\s+//;
        my ($pid, $cmd) = /^(\d+)\s+(.+)/ or next;
        $pid += 0;
        next if $pid == $$;
        if ($cmd =~ /\bxpra\b.*\battach\b.*\bssh:\/\/(?:\S+@)?([^\s\/]+)\/(\d+)\b/) {
            push @found, { pid => $pid, type => 'xpra', host => $1, disp_n => $2 + 0 };
        }
        elsif ($cmd =~ /\bxpra\b.*\battach\b.*\s:(\d+)\s*$/) {
            push @found, { pid => $pid, type => 'xpra', local => 1, disp_n => $1 + 0 };
        }
        elsif ($cmd =~ /\bvncviewer\s+localhost:(\d+)\s*$/ && $1 < 100) {
            push @found, { pid => $pid, type => 'vnc', local => 1, disp_n => $1 + 0 };
        }
        elsif ($cmd =~ /\bvncviewer\s+localhost::(\d+)\b/ && $1 >= 15900) {
            push @found, { pid => $pid, type => 'vnc', disp_n => $1 - 15900, cmd => $cmd };
        }
    }
    close $h;
    return \@found;
}

{
    my $found = _scan_attached();
    _dbg("[debug] adopt: " . scalar(@$found) . " viewer processes found");
    for my $s (@sessions) {
        my $dn = $s->{disp_n} // next;
        for my $f (@$found) {
            next unless $f->{disp_n} == $dn;
            my $match = 0;
            if ($f->{type} eq 'xpra' && $s->{kind} ne 'vnc') {
                $match = 1 if  $s->{local} &&  $f->{local};
                $match = 1 if !$s->{local} && !$f->{local}
                           && defined $f->{host} && $f->{host} eq $s->{host};
            }
            elsif ($f->{type} eq 'vnc' && $s->{kind} eq 'vnc') {
                $match = 1 if  $s->{local} &&  $f->{local};
                $match = 1 if !$s->{local} && !$f->{local}
                           && defined $f->{cmd} && $f->{cmd} =~ /\Q$s->{host}\E/;
            }
            if ($match) {
                $s->{pid} = $f->{pid};
                $s->{_adopted} = 1;
                _dbg("[debug] adopt: $s->{host} $s->{disp} -> pid $f->{pid}");
                last;
            }
        }
    }
}

# --- pop up Tk chooser ----------------------------------------------------
#
# A row per session, with an [Attach] button at the end of each row.
# Clicking [Attach] fires `xpra attach …` as a detached child and leaves
# the window up so several sessions can be attached.  Closing the window
# (regular decoration) ends the program.

my ($mw, $rows_f, $_update_scroll);

sub _ask_host {
    my ($parent, $defaults) = @_;
    $defaults //= {};
    my $title = defined $defaults->{name} ? 'Edit host' : 'Add host';
    my $dlg = $parent->Toplevel(-title => $title);
    $dlg->transient($parent);
    $dlg->grab;
    $dlg->Label(-text => 'Hostname:')->pack(-padx => 8, -pady => [8,2]);
    my $name_val = $defaults->{name} // '';
    my $name_e = $dlg->Entry(-textvariable => \$name_val, -width => 30);
    $name_e->pack(-padx => 8);
    $name_e->focus;
    $dlg->Label(-text => 'IP (optional if hostname resolves):')
        ->pack(-padx => 8, -pady => [6,2]);
    my $ip_val = $defaults->{ip} // '';
    $ip_val = '' if $ip_val eq $name_val;
    my $ip_e = $dlg->Entry(-textvariable => \$ip_val, -width => 30);
    $ip_e->pack(-padx => 8);
    $dlg->Label(-text => 'User (optional):')
        ->pack(-padx => 8, -pady => [6,2]);
    my $user_val = $defaults->{user} // '';
    my $user_e = $dlg->Entry(-textvariable => \$user_val, -width => 30);
    $user_e->pack(-padx => 8);
    $dlg->Label(-text => 'Display (optional, e.g. 0, 2):')
        ->pack(-padx => 8, -pady => [6,2]);
    my $disp_val = defined $defaults->{disp} ? $defaults->{disp} : '';
    my $disp_e = $dlg->Entry(-textvariable => \$disp_val, -width => 30);
    $disp_e->pack(-padx => 8);
    my $err_msg = '';
    my $err_lbl = $dlg->Label(-textvariable => \$err_msg,
                              -foreground => '#c00000');
    $err_lbl->pack(-padx => 8, -pady => [4,0]);
    my $ok;
    my $validate = sub {
        (my $ip = $ip_val) =~ s/^\s+|\s+$//g;
        if (length $ip) {
            unless ($ip =~ /^(\d+)\.(\d+)\.(\d+)\.(\d+)$/
                    && $1 <= 255 && $2 <= 255 && $3 <= 255 && $4 <= 255) {
                $err_msg = 'Invalid IP address';
                $ip_e->focus;
                return;
            }
        }
        (my $n = $name_val) =~ s/^\s+|\s+$//g;
        unless (length $n || length $ip) {
            $err_msg = 'Hostname or IP required';
            $name_e->focus;
            return;
        }
        $ok = 1;
        $dlg->destroy;
    };
    $name_e->bind('<Return>', sub { $ip_e->focus });
    $ip_e->bind('<Return>', sub { $user_e->focus });
    $user_e->bind('<Return>', sub { $disp_e->focus });
    $disp_e->bind('<Return>', $validate);
    my $bf = $dlg->Frame->pack(-pady => 8);
    $bf->Button(-text => 'OK',     -command => $validate)
       ->pack(-side => 'left', -padx => 4);
    $bf->Button(-text => 'Cancel', -command => sub { $dlg->destroy })
       ->pack(-side => 'left', -padx => 4);
    $dlg->waitWindow;
    return undef unless $ok;
    $name_val =~ s/^\s+|\s+$//g;
    $ip_val   =~ s/^\s+|\s+$//g;
    $user_val =~ s/^\s+|\s+$//g;
    $disp_val =~ s/^\s+|\s+$//g;
    $disp_val =~ s/^://;
    $name_val = $ip_val unless length $name_val;
    $ip_val = $name_val unless length $ip_val;
    return { name => $name_val, ip => $ip_val,
             (length $user_val ? (user => $user_val) : ()),
             (length $disp_val && $disp_val =~ /^\d+$/ ? (disp => $disp_val + 0) : ()) };
}

sub _remove_extra_host {
    # $all_rows: also tear down rows that aren't flagged _extra (used when
    # editing a discovered host — its old rows must go before the re-probe
    # re-renders them, or we'd leave a stale duplicate behind).
    my ($host, $all_rows) = @_;
    my $extras = $SETTINGS->{_extra_hosts} // [];
    @$extras = grep { $_->{name} ne $host && $_->{ip} ne $host } @$extras;
    _save_settings($SETTINGS);
    my @keep;
    for my $s (@sessions) {
        my $match = ($s->{host} eq $host || ($s->{ip} // '') eq $host)
                 && ($all_rows || $s->{_extra});
        if ($match) {
            $_->destroy for @{ $s->{_widgets} // [] };
        } else {
            push @keep, $s;
        }
    }
    @sessions = @keep;
}

# Soft-hide a single session row (host+display) — the "Hide" action.
# Reversible: the row is suppressed now and stays out of the normal list,
# but the ↕ "show hidden" toggle reveals it and Settings → Hide un-ticks
# it.  This is the recoverable counterpart to the permanent Remove below.
sub _hide_session {
    my ($sess) = @_;
    my $dn = $sess->{disp_n};
    return unless defined $dn;
    $SETTINGS->{_hidden}{"$sess->{host}\t$dn"} = 1;
    _save_settings($SETTINGS);
    _rerender_rows() if defined &_rerender_rows;
}

# Hard-remove a single session row (host+display) — the "Remove" action.
# The old code routed Remove through _remove_extra_host($host), which tore
# down EVERY row sharing the host; clicking Remove on one bad display
# wiped the lot.  Here we drop just the clicked row and blocklist that
# host+display in _removed so it never reappears on a rescan and the ↕
# toggle won't reveal it — recover only by editing _removed in the config
# file.  (Use Hide for the reversible version.)  When it was the host's
# last row, the manually-added host entry is forgotten entirely.
sub _remove_session {
    my ($sess) = @_;
    my $host = $sess->{host};
    my $ip   = $sess->{ip} // '';
    my $dn   = $sess->{disp_n};

    # Drop the clicked row from the model; _rerender_rows re-packs the
    # grid (avoids a gap where the destroyed row used to be).
    @sessions = grep { $_ != $sess } @sessions;

    # Permanently blocklist this exact display against future scans.
    $SETTINGS->{_removed}{"$host\t$dn"} = 1 if defined $dn;
    # Drop any stale soft-hide entry — Remove supersedes Hide.
    delete $SETTINGS->{_hidden}{"$host\t$dn"}
        if defined $dn && $SETTINGS->{_hidden};

    my $extras = $SETTINGS->{_extra_hosts} // [];
    my $host_left = grep {
        ($_->{host} // '') eq $host || ($_->{ip} // '') eq $host
     || ($ip ne '' && (($_->{host} // '') eq $ip || ($_->{ip} // '') eq $ip))
    } @sessions;
    if (!$host_left) {
        # Last row for this host — forget the manually-added host outright.
        @$extras = grep { $_->{name} ne $host && $_->{ip} ne $host
                       && ($ip eq '' || ($_->{name} ne $ip && $_->{ip} ne $ip)) }
                   @$extras;
    } else {
        # Other rows remain — only clear a pin that targeted this display,
        # so the fallback "(root display)" row for it doesn't re-appear.
        for my $e (@$extras) {
            next unless $e->{name} eq $host || $e->{ip} eq $host
                     || ($ip ne '' && ($e->{name} eq $ip || $e->{ip} eq $ip));
            delete $e->{disp}
                if defined $e->{disp} && defined $dn && $e->{disp} == $dn;
        }
    }
    _save_settings($SETTINGS);
    _rerender_rows() if defined &_rerender_rows;
}

sub _edit_extra_host {
    my ($sess) = @_;
    my $old_host = $sess->{host};
    my $old_ip   = $sess->{ip} // '';
    my $extras = $SETTINGS->{_extra_hosts} // [];
    my ($cur) = grep { $_->{name} eq $old_host || $_->{ip} eq $old_ip } @$extras;
    # Discovered rows aren't in _extra_hosts yet — seed the dialog from the
    # live session so user/display pre-fill, then editing promotes it to a
    # persisted (sticky) extra host via _add_host_probe.
    $cur //= {
        name => $old_host,
        ip   => $old_ip,
        (defined $sess->{user} && length $sess->{user}
            ? (user => $sess->{user}) : ()),
        (defined $sess->{disp} && $sess->{disp} =~ /^:(\d+)$/
            ? (disp => $1 + 0) : ()),
    };
    my $h = _ask_host($mw, $cur);
    return unless defined $h;
    _remove_extra_host($old_host, 1);
    _add_host_probe($mw, $h);
}

sub _add_host_probe {
    my ($parent, $prefilled) = @_;
    my $h = $prefilled // _ask_host($parent);
    return unless defined $h;
    my $host      = $h->{name};
    my $host_ip   = $h->{ip};
    my $host_user = $h->{user};
    my $host_disp = $h->{disp};
    # Persist — remove any stale entries for this name or IP first
    my $extras = $SETTINGS->{_extra_hosts} //= [];
    @$extras = grep { $_->{name} ne $host && $_->{ip} ne $host_ip } @$extras;
    my $entry = { name => $host, ip => $host_ip };
    $entry->{user} = $host_user if defined $host_user;
    $entry->{disp} = $host_disp if defined $host_disp;
    push @$extras, $entry;
    _save_settings($SETTINGS);
    _keys_ensure();
    my $remote = 'show-x11 -ns -id; echo __XPRA__; xpra list; '
               . 'echo __XSTART__; cat ~/.xpra-start; '
               . 'echo __VNC__; (ss -tln 2>/dev/null || netstat -tln 2>/dev/null); '
               . 'echo __PSVNC__; ps -eo user,pid,args';
    $remote .= q{; echo __DISPLAYS__; stat -c '%n %U' /tmp/.X11-unix/X*}
        if $any;
    pipe(my $rd, my $wr) or do { warn "add-host pipe: $!\n"; return };
    my $cpid = fork;
    if (!defined $cpid) { warn "add-host fork: $!\n"; close $rd; close $wr; return }
    if (!$cpid) {
        close $rd;
        $wr->autoflush(1);
        POSIX::setsid();
        open STDIN, '<', '/dev/null';
        if (defined(my $ap = _askpass())) { $ENV{SSH_ASKPASS} = $ap }
        $SIG{ALRM} = sub { POSIX::_exit(1) };
        alarm($overall_to + 5);
        my @tgt = ssh_target({ name => $host, ip => $host_ip });
        if (defined $host_user) {
            $tgt[-1] =~ s/^[^\@]*\@//;
            $tgt[-1] = "$host_user\@$tgt[-1]";
        }
        my @cmd = ('ssh', ssh_opts(), @tgt, $remote);
        if (open my $oh, '-|', @cmd) {
            my ($disp, $in_xpra, $in_xstart, $in_vnc, $in_psvnc, $in_disps) =
                (undef, 0, 0, 0, 0, 0);
            my %vnc_seen;
            while (defined(my $line = <$oh>)) {
                chomp $line;
                if ($line eq '__XPRA__')     { $in_xpra=1; $in_xstart=0; $in_vnc=0; $in_disps=0; $in_psvnc=0; next }
                if ($line eq '__XSTART__')  { $in_xpra=0; $in_xstart=1; $in_vnc=0; $in_disps=0; $in_psvnc=0; next }
                if ($line eq '__VNC__')     { $in_xpra=0; $in_xstart=0; $in_vnc=1; $in_disps=0; $in_psvnc=0; next }
                if ($line eq '__PSVNC__')   { $in_xpra=0; $in_xstart=0; $in_vnc=0; $in_disps=0; $in_psvnc=1; next }
                if ($line eq '__DISPLAYS__'){ $in_xpra=0; $in_xstart=0; $in_vnc=0; $in_disps=1; $in_psvnc=0; next }
                if ($in_vnc) {
                    if ($line =~ /:(\d+)\b/ && $1 >= 5900 && $1 <= 5999) {
                        my $port = $1 + 0;
                        next if $vnc_seen{$port}++;
                        my $dn = $port - 5900;
                        print { $wr } "__vnc__\t$host\t$dn\t$port\n";
                    }
                    next;
                }
                if ($in_xpra) {
                    if ($line =~ /\s+:(\d+)\s*$/) {
                        print { $wr } "__xpra__\t$host\t:$1\n";
                    }
                    next;
                }
                if ($in_xstart) {
                    if ($line =~ /^(\d+)\s+(.+)/) {
                        print { $wr } "__xs__\t$host\t$1\t$2\n";
                    }
                    next;
                }
                if ($in_disps) {
                    if ($line =~ m{/tmp/\.X11-unix/X(\d+)\s+(\S+)}) {
                        print { $wr } "__disp__\t$host\t$1\t$2\n";
                    }
                    next;
                }
                if ($in_psvnc) {
                    if ($line =~ /^\s*(\S+)\s+(\d+)\s+(.*)/) {
                        my ($u, $pid, $cmd) = ($1, $2, $3);
                        if ($cmd =~ m{(?:Xtightvnc|Xvnc|x11vnc|Xtigervnc|krfb|vino-server|tigervncserver)\b}) {
                            my $dn;
                            $dn = $1 if $cmd =~ /\s:(\d+)\b/;
                            my $port;
                            $port = $1 if $cmd =~ /-rfbport\s+(\d+)/;
                            print { $wr } join("\t", "__psvnc__", $host,
                                               $dn // '', $port // '', $u), "\n"
                                if defined $dn;
                        }
                        elsif ($cmd =~ m{(?:Xdummy|Xvfb|xpra\s+start)\b}) {
                            my $dn;
                            $dn = $1 if $cmd =~ /\s:(\d+)\b/;
                            print { $wr } "__psxpra__\t$host\t$dn\t$u\n"
                                if defined $dn;
                        }
                    }
                    next;
                }
                # show-x11 output
                if ($line =~ /^# host:\s+\S+\s+id:\s+(\S+)/) {
                    print { $wr } "__id__\t$host\t$1\n";
                    next;
                }
                if ($line =~ /^:(\d+)\b/) { $disp = ":$1" }
                next unless defined $disp;
                if ($line =~ /^\s+(\d+)\s+(\S+)\s+(.*)/) {
                    print { $wr } join("\t", $host, $disp, $1, $2, $3), "\n";
                }
            }
            close $oh;
        }
        POSIX::_exit(0);
    }
    close $wr;
    my $buf = '';
    my $probe_host = $host;
    my $probe_ip   = $host_ip;
    my $probe_user = $host_user;
    my $probe_disp = $host_disp;
    $mw->fileevent($rd, 'readable', sub {
        my $n = sysread($rd, my $chunk, 4096);
        if (!$n) {
            $mw->fileevent($rd, 'readable', '');
            close $rd;
            waitpid($cpid, 0);
            _finish_add_host($probe_host, $probe_ip, $probe_user, $probe_disp);
            return;
        }
        $buf .= $chunk;
        while ($buf =~ s/^([^\n]*)\n//) {
            _parse_add_host_line($probe_host, $1);
        }
    });
}

{
    my (%ah_xpra, %ah_vnc, %ah_xs, %ah_disp, @ah_psvnc, @ah_psxpra, @ah_rows);

    sub _parse_add_host_line {
        my ($host, $line) = @_;
        if ($line =~ /^__xpra__\t([^\t]*)\t([^\t]*)$/) {
            $ah_xpra{"$1\t$2"} = 1;
        } elsif ($line =~ /^__vnc__\t([^\t]*)\t([^\t]*)\t([^\t]*)$/) {
            $ah_vnc{"$1\t$2"} = $3 + 0;
        } elsif ($line =~ /^__xs__\t([^\t]*)\t([^\t]*)\t([^\t]*)$/) {
            push @{ $ah_xs{$1} }, { disp_n => $2 + 0, cmd => $3 };
        } elsif ($line =~ /^__disp__\t([^\t]*)\t([^\t]*)\t([^\t]*)$/) {
            $ah_disp{"$1\t$2"} = $3;
        } elsif ($line =~ /^__psvnc__\t/) {
            my @f = split /\t/, $line;
            push @ah_psvnc, { host => $f[1], disp_n => $f[2]+0,
                              port => (length $f[3] ? $f[3]+0 : undef),
                              user => $f[4] } if length $f[2];
        } elsif ($line =~ /^__psxpra__\t([^\t]*)\t([^\t]*)\t([^\t]*)$/) {
            push @ah_psxpra, { host => $1, disp_n => $2+0, user => $3 };
        } elsif ($line =~ /^__id__\t/) {
            # ignore machine-id for add-host
        } else {
            my @f = split /\t/, $line, 5;
            push @ah_rows, \@f if @f == 5;
        }
    }

    sub _finish_add_host {
        my ($host, $host_ip, $host_user, $host_disp) = @_;
        my $own_user = $host_user // $ssh_user // $ENV{USER} // '';
        my %by_sess;
        for my $key (keys %ah_xpra) {
            my ($h, $disp) = split /\t/, $key, 2;
            $by_sess{$key} = { host=>$h, disp=>$disp, user=>$own_user,
                                cmds=>[], procs=>[], n=>0, kind=>'xpra',
                                xpra_listed=>1 };
        }
        for my $key (keys %ah_vnc) {
            my ($h, $dn) = split /\t/, $key, 2;
            my $sk = "$h\t:$dn";
            if (my $e = $by_sess{$sk}) {
                $e->{kind} = 'vnc' unless $e->{kind} eq 'xpra';
                $e->{vnc_port} //= $ah_vnc{$key};
            } else {
                $by_sess{$sk} = { host=>$h, disp=>":$dn", user=>$own_user,
                                   cmds=>[], procs=>[], n=>0, kind=>'vnc',
                                   vnc_port=>$ah_vnc{$key} };
            }
        }
        for my $key (keys %ah_disp) {
            my ($h, $dn) = split /\t/, $key, 2;
            my $sk = "$h\t:$dn";
            my $owner = $ah_disp{$key};
            my $is_vnc = $ah_vnc{"$h\t$dn"} ? 1 : 0;
            if (my $e = $by_sess{$sk}) {
                $e->{user} = $owner;
                if ($is_vnc) {
                    $e->{kind} = 'vnc' unless $e->{kind} eq 'xpra';
                    $e->{vnc_port} //= 5900 + $dn;
                }
            } else {
                my $kind = $is_vnc ? 'vnc' : $dn == 0 ? 'X' : 'xpra';
                $by_sess{$sk} = { host=>$h, disp=>":$dn", user=>$owner,
                                   cmds=>[], procs=>[], n=>0, kind=>$kind,
                                   ($is_vnc ? (vnc_port => 5900+$dn) : ()) };
            }
        }
        for my $v (@ah_psvnc) {
            my $sk = "$v->{host}\t:$v->{disp_n}";
            if (my $e = $by_sess{$sk}) {
                $e->{kind} = 'vnc' unless $e->{kind} eq 'xpra';
                $e->{vnc_port} //= $v->{port} if defined $v->{port};
                $e->{user} = $v->{user} if defined $v->{user} && length $v->{user};
            } else {
                $by_sess{$sk} = { host=>$v->{host}, disp=>":$v->{disp_n}",
                                   user=>$v->{user}, cmds=>[], procs=>[], n=>0,
                                   kind=>'vnc', vnc_port=>$v->{port} };
            }
        }
        for my $v (@ah_psxpra) {
            my $sk = "$v->{host}\t:$v->{disp_n}";
            if (my $e = $by_sess{$sk}) {
                $e->{kind} //= 'xpra';
                $e->{user} = $v->{user} if defined $v->{user} && length $v->{user};
            } else {
                $by_sess{$sk} = { host=>$v->{host}, disp=>":$v->{disp_n}",
                                   user=>$v->{user}, cmds=>[], procs=>[], n=>0,
                                   kind=>'xpra' };
            }
        }
        for my $row (@ah_rows) {
            my ($h, $disp, $pid, $user, $cmd) = @$row;
            my $sk = "$h\t$disp";
            my ($dn) = $disp =~ /^:(\d+)$/;
            my $kind_default = (defined $dn && $dn >= 20) ? 'xpra' : 'X';
            my $s = $by_sess{$sk} //= { host=>$h, disp=>$disp, user=>$user,
                                          cmds=>[], procs=>[], n=>0, kind=>$kind_default };
            $s->{kind} = 'xpra' if $ah_xpra{"$h\t$disp"};
            $s->{user} = $user if length $user && !length($s->{user} // '');
            $s->{n}++;
            next if $cmd =~ m{\b(?:dbus-daemon|dbus-launch|dconf-service|gvfsd|gvfs-?\S*|xdg-\S+|ibus-\S+|pulseaudio|gnome-keyring|at-spi\S*|xpra/?\S*daemonizer|sleep)\b};
            next if $cmd =~ m{/sbin/init|/lib/systemd|cron|sshd|mate-session|lxsession};
            next if $cmd =~ m{(?:crashhelper|-helper\b|RemoteSandbox|GMPProcess|NetworkBroker|content-process)};
            next if $cmd =~ m{\s-contentproc\b|\s--type=\S};
            if ($cmd =~ m{^(?:\S*/)?(?:Xvnc|Xtightvnc|x11vnc|Xtigervnc|krfb|vino-server|tigervncserver)\b}) {
                $s->{kind} = 'vnc' unless $s->{kind} eq 'xpra';
                $s->{vnc_port} //= 5900 + $dn if defined $dn;
            }
            $s->{vnc_port} //= $ah_vnc{"$h\t$dn"} if defined $dn;
            next if $cmd =~ m{^(?:\S*/)?(?:Xvnc|Xtightvnc|x11vnc|Xvfb|Xorg|Xtigervnc|krfb|vino-server|tigervncserver)\b};
            push @{ $s->{cmds} }, $cmd;
        }
        my @new = values %by_sess;
        for my $s (@new) {
            ($s->{disp_n}) = $s->{disp} =~ /^:(\d+)/;
            $s->{ip}     = $host_ip;
            $s->{local}  = 0;
            $s->{_extra} = 1;
        }
        # If nothing found, offer a fallback display.  For an xpra-range
        # display (>= 20) default the kind to 'xpra' so the action menu
        # includes 'Attach' — otherwise an explicitly-added xpra host
        # whose probe didn't enumerate the display reads as a base X
        # server and the only useful action is missing.
        if (!@new || defined $host_disp) {
            my $dn = $host_disp // 0;
            my $key = "$host\t:$dn";
            unless ($by_sess{$key}) {
                my $kind = ($dn >= 20) ? 'xpra' : 'X';
                my $apps = $kind eq 'xpra' ? '(xpra)' : '(root display)';
                push @new, { host => $host, disp => ":$dn", disp_n => $dn,
                             ip => $host_ip, local => 0, kind => $kind,
                             user => $own_user, cmds => [], procs => [], n => 0,
                             apps => $apps, _extra => 1 };
            }
        }
        # Label apps
        for my $s (@new) {
            next if $s->{_extra} && defined $s->{apps};
            my $main = _main_cmd(@{ $s->{cmds} });
            my $other = $any && defined $s->{user} && length $s->{user}
                      && $s->{user} ne $own_user;
            $s->{_attach_as} = $s->{user} if $other;
            # An explicit per-host login (Settings, or the user just typed
            # into the Add/Edit-host dialog) wins — apply it to attach/ssh.
            my $hu = _host_login_user($s->{host}, $s->{ip}) // $host_user;
            $s->{_attach_as} = $hu if defined $hu && length $hu;
            $s->{apps} = length $main        ? _fmt_cmd($main, 60)
                       : $s->{xpra_listed}   ? '(empty xpra)'
                       : $s->{kind} eq 'vnc' ? '(vnc)'
                       : $other              ? '(login required)'
                       :                       '(daemons only)';
        }
        @new = sort { $a->{disp_n} <=> $b->{disp_n} } @new;
        for my $s (@new) {
            # Skip over-limit rows entirely — don't render and don't keep
            # them in @sessions (where the reap timer would still poll them).
            next unless _row_visible($s);
            push @sessions, $s;
            _render_row($s);
        }
        $mw->after(50, $_update_scroll);
        # Reset accumulators
        %ah_xpra = (); %ah_vnc = (); %ah_xs = (); %ah_disp = ();
        @ah_psvnc = (); @ah_psxpra = (); @ah_rows = ();
    }
}

_dbg("[debug] parent: requiring Tk for chooser");
$mw = _tk_mw();
_dbg("[debug] parent: MainWindow created");
$mw->title('find-xpra: attach to X11 session');
if (my $geo = $SETTINGS->{_geometry}) {
    $mw->geometry($geo);
}
$mw->deiconify;
my $_save_geometry = sub {
    my $g = $mw->geometry;
    if (defined $g && $g =~ /\d+x\d+[+-]/) {
        $SETTINGS->{_geometry} = $g;
        _save_settings($SETTINGS);
    }
};
$mw->protocol('WM_DELETE_WINDOW', sub {
    $_save_geometry->();
    $mw->destroy;
});
my @cols = ('', '', 'Host', 'Disp', 'User', 'Info');

# Rescan: re-exec self with the same args.  Discovery runs again and the
# UI rebuilds.  In-flight xpra-attach children are setsid'd so they
# survive the exec; their Disconnect tracking is lost (close the viewer
# via xpra's own UI in that case).
my $header_f = $mw->Frame;
$header_f->pack(-fill => 'x', -padx => 6, -pady => 4);
# Shared hover-help (tooltips) for the whole UI.  $BALLOON->attach($w, ...)
# registers help text that pops up after a short hover over $w.  Used for
# the header controls and the per-row action menu.
my $BALLOON = $mw->Balloon(-initwait => 600);
my $rescan_btn = $header_f->Button(-text => 'Rescan',
                  -command => sub { $_save_geometry->(); exec { $^X } $^X, $0, @ORIG_ARGV });
$rescan_btn->pack(-side => 'left', -fill => 'x', -expand => 1);
my $addhost_btn = $header_f->Button(-text => 'Add host',
                  -command => sub { _add_host_probe($mw) });
$addhost_btn->pack(-side => 'left', -fill => 'x', -expand => 1);
my $settings_btn = $header_f->Button(-text => 'Settings',
                  -command => sub { _show_app_settings($mw) });
$settings_btn->pack(-side => 'left', -fill => 'x', -expand => 1);
# Copy the whole session table to the clipboard as TSV — per-cell text
# selection only lets the user grab one field at a time; this is the
# "select the whole page" affordance.  Debug-only: it exists to share
# diagnostic snapshots, not as part of the everyday UI.
my $copy_btn;
if ($debug) {
    $copy_btn = $header_f->Button(-text => 'Copy',
                      -command => sub { _copy_sessions_to_clipboard() });
    $copy_btn->pack(-side => 'left', -fill => 'x', -expand => 1);
}
$BALLOON->attach($rescan_btn,
    -balloonmsg => 'Re-run discovery and rebuild the list (re-execs '
                 . 'find-xpra). Open viewers keep running.');
$BALLOON->attach($addhost_btn,
    -balloonmsg => 'Add a host by name/IP and probe it for sessions. '
                 . 'Editing it later makes the entry stick.');
$BALLOON->attach($settings_btn,
    -balloonmsg => 'App settings: max display number, VNC viewer backend, '
                 . 'and the ssh-askpass program.');
$BALLOON->attach($copy_btn,
    -balloonmsg => 'Copy the whole session table (host, display, user, info) '
                 . 'to the clipboard as tab-separated text.') if $copy_btn;
# "Show hidden" toggle: reveal sessions whose host is marked Hide (and the
# local :0, hidden by default).  Compact icon button: ↕ (a "<->" turned
# 90°).  Active state (hidden shown) shown by a sunken relief.
my $known_btn;
$known_btn = $header_f->Button(
    -text    => "\x{2195}",          # ↕ U+2195 UP DOWN ARROW
    -relief  => $show_hidden ? 'sunken' : 'raised',
    -command => sub {
        $show_hidden = !$show_hidden;
        $known_btn->configure(-relief => $show_hidden ? 'sunken' : 'raised');
        _rerender_rows();
    });
$known_btn->pack(-side => 'left', -padx => 4);
$BALLOON->attach($known_btn,
    -balloonmsg => 'Show hidden sessions (hosts marked Hide in their '
                 . 'Settings, and the local :0 by default). '
                 . 'Pressed = hidden shown.');
# Debug toggle: re-exec with --debug added/removed.  --debug governs the
# startup probe (already finished) and opens the trace log, so toggling it
# live means re-running discovery — same as Rescan, just with the flag
# flipped.  Sunken relief = currently on.  Glyph: 🐞 (falls back gracefully
# to a box if the Tk font lacks it; the relief still shows state).
my $debug_btn;
$debug_btn = $header_f->Button(
    -text    => "\x{1F41E}",         # 🐞 LADY BEETLE
    -relief  => $debug ? 'sunken' : 'raised',
    -command => sub {
        $_save_geometry->();
        my @argv = grep { $_ ne '--debug' && $_ ne '-debug' } @ORIG_ARGV;
        push @argv, '--debug' unless $debug;   # add it only when turning ON
        exec { $^X } $^X, $0, @argv;
    });
$debug_btn->pack(-side => 'left', -padx => 4);
$BALLOON->attach($debug_btn,
    -balloonmsg => 'Toggle --debug (re-execs). Writes a trace to '
                 . '/tmp/find-xpra-debug.log. (Pressed = on.)');
# Global default DPI — passed to `xpra attach --dpi=N` for every session
# unless the host's Settings dialog overrides it.  "auto" (or blank) means
# "let xpra auto-detect" (the historical behaviour).  Saved on
# FocusOut / Return.
$header_f->Label(-text => 'DPI:')
         ->pack(-side => 'left', -padx => [12, 4]);
my $default_dpi = $SETTINGS->{'*'}{dpi} // 'auto';
my $dpi_entry = $header_f->Entry(-textvariable => \$default_dpi,
                                 -width   => 5,
                                 -justify => 'right');
$dpi_entry->pack(-side => 'left');
$BALLOON->attach($dpi_entry,
    -balloonmsg => 'Default DPI for xpra attach (--dpi). "auto" or blank '
                 . 'lets xpra decide. Per-host override in host Settings.');
my $save_default_dpi = sub {
    $default_dpi =~ s/^\s+|\s+$//g;
    if (length $default_dpi && $default_dpi =~ /^\d+$/ && $default_dpi > 0) {
        $SETTINGS->{'*'}{dpi} = $default_dpi + 0;
    } else {
        # blank / "auto" / non-numeric all mean auto-detect
        delete $SETTINGS->{'*'}{dpi};
        $default_dpi = 'auto';
    }
    _save_settings($SETTINGS);
};
$dpi_entry->bind('<FocusOut>', $save_default_dpi);
$dpi_entry->bind('<Return>',   $save_default_dpi);
# Clear the "auto" placeholder on focus-in so the user types into an empty
# field; restore it on focus-out if they left it empty (save handles that).
$dpi_entry->bind('<FocusIn>', sub {
    $default_dpi = '' if $default_dpi eq 'auto';
});
# Target display for launched windows.  When find-xpra runs inside an
# xpra/nested session, set this to e.g. ":0" so viewers/terminals open on
# the real screen instead of inside this session.  Blank = inherit the
# current $DISPLAY.  Saved (as the default) on FocusOut / Return.
$header_f->Label(-text => 'Display:')
         ->pack(-side => 'left', -padx => [12, 4]);
my $disp_field = $target_display eq '' ? 'auto' : $target_display;
my $disp_entry = $header_f->Entry(-textvariable => \$disp_field,
                                  -width   => 6,
                                  -justify => 'right');
$disp_entry->pack(-side => 'left');
$BALLOON->attach($disp_entry,
    -balloonmsg => 'X display for windows find-xpra launches (e.g. :0). '
                 . 'Useful when running inside an xpra session. '
                 . '"auto" or blank = use the current $DISPLAY.');
my $save_target_display = sub {
    $disp_field =~ s/^\s+|\s+$//g;
    if (length $disp_field && lc $disp_field ne 'auto') {
        $target_display = $disp_field;
        $SETTINGS->{_target_display} = $disp_field;
    } else {
        $target_display = '';
        delete $SETTINGS->{_target_display};
        $disp_field = 'auto';
    }
    _save_settings($SETTINGS);
};
$disp_entry->bind('<FocusOut>', $save_target_display);
$disp_entry->bind('<Return>',   $save_target_display);
$disp_entry->bind('<FocusIn>', sub {
    $disp_field = '' if $disp_field eq 'auto';
});
my $about_btn = $header_f->Button(-text => 'About', -command => sub {
    my $build_date = POSIX::strftime('%Y-%m-%d %H:%M', localtime((stat $0)[9]));
    my $url = 'https://github.com/kev-cam/xpra-tools';
    my $top = $mw->Toplevel(-title => 'About find-xpra');
    $top->transient($mw);
    $top->Label(-text => "find-xpra", -font => 'sans-serif 14 bold')
        ->pack(-pady => [10,4]);
    $top->Label(-text => "Version: $VERSION\n"
                       . "Built: $build_date\n"
                       . "Perl: $^V\n"
                       . $url)
        ->pack(-padx => 20);
    $top->Button(-text => 'OK', -command => sub { $top->destroy })
        ->pack(-pady => 10);
});
$about_btn->pack(-side => 'right');
$BALLOON->attach($about_btn,
    -balloonmsg => 'Version, build date, and project URL.');

my $canvas = $mw->Canvas(-highlightthickness => 0);
my $scroll = $mw->Scrollbar(-orient => 'vertical', -command => ['yview', $canvas]);
$canvas->configure(-yscrollcommand => ['set', $scroll]);
$scroll->pack(-side => 'right', -fill => 'y');
$canvas->pack(-side => 'left', -fill => 'both', -expand => 1);
$rows_f = $canvas->Frame;
my $rows_id = $canvas->createWindow(0, 0, -window => $rows_f, -anchor => 'nw');
$rows_f->gridColumnconfigure(5, -weight => 1, -minsize => 0);
$_update_scroll = sub {
    $rows_f->update;
    $canvas->configure(-scrollregion => [$canvas->bbox('all')]);
};
$canvas->bind('<Configure>', sub {
    $canvas->itemconfigure($rows_id, -width => $canvas->width);
});
$canvas->Tk::bind('<MouseWheel>', sub {
    $canvas->yview('scroll', -($_[0]->XEvent->D / 120), 'units');
});
$canvas->Tk::bind('<Button-4>', sub { $canvas->yview('scroll', -3, 'units') });
$canvas->Tk::bind('<Button-5>', sub { $canvas->yview('scroll',  3, 'units') });

for my $i (0 .. $#cols) {
    $rows_f->Label(-text => $cols[$i], -font => 'sans-serif 11 bold',
                   -relief => 'ridge', -padx => 6, -pady => 2)
       ->grid(-row => 0, -column => $i, -sticky => 'ew');
}
my $r = 1;
# Is this session hidden?  Per-SESSION opt-out (host+display), set in the
# session's Settings dialog and stored under $SETTINGS->{_hidden}{"H\tD"}
# — keyed on host+disp so hiding one display doesn't hide the host's other
# displays.  (Distinct from the --pick picker's whole-host {HOST}{hidden}.)
# With no explicit choice, the local :0 (root X display) is hidden by
# default — rarely an attach target.  Hidden rows show only via the ↕
# "show hidden" toggle or --all.
sub _session_hidden {
    my ($s) = @_;
    my $key = ($s->{host} // '') . "\t" . ($s->{disp_n} // '');
    my $h = $SETTINGS->{_hidden}{$key};
    return $h ? 1 : 0 if defined $h;
    return ($s->{local} && defined $s->{disp_n} && $s->{disp_n} == 0) ? 1 : 0;
}
# The high-display ceiling enforced here, at the single render chokepoint,
# so NO path can leak an over-limit row onto the screen — the startup
# @sessions filter misses rows added later by the "Add host" probe
# (_finish_add_host calls _render_row directly).  Returns true if the row
# was actually rendered, false if suppressed, so callers can avoid leaving
# a suppressed session in @sessions.  --all/--any disable the ceiling.
sub _row_visible {
    my ($s) = @_;
    # Hard-removed (Remove action) — never shown, not even under --all or
    # the ↕ "show hidden" toggle.  Guard against autovivifying _removed.
    if (defined $s->{disp_n} && $SETTINGS->{_removed}
        && $SETTINGS->{_removed}{ "$s->{host}\t$s->{disp_n}" }) {
        return 0;
    }
    # Per-host "hidden" opt-out (host Settings → Hide; local :0 hidden by
    # default).  Suppressed unless the "show hidden" header toggle is on,
    # or --all was given on the command line.
    if (!$all && !$show_hidden && _session_hidden($s)) {
        return 0;
    }
    # High-display ceiling — applies even under --all / --any.  Nothing
    # above the ceiling (default 9999) is a real display: these are xpra
    # shadow/proxy synthetic IDs (6-7 digits).  --all/--any are about
    # showing low/plumbing displays and other users' sessions, NOT
    # impossible high display numbers, so they must not bypass this.
    # Set max display to 0 (Settings → unlimited) to see everything.
    if (defined $max_disp && defined $s->{disp_n}
        && $s->{disp_n} > $max_disp) {
        return 0;
    }
    return 1;
}
sub _render_row {
    my ($s) = @_;
    return 0 unless _row_visible($s);
    my @info;
    push @info, $s->{kind} if defined $s->{kind} && $s->{kind} ne 'xpra';
    if (defined $s->{apps} && $s->{apps} ne '(root display)'
        && $s->{apps} ne '(daemons only)') {
        push @info, $s->{apps};
    }
    my $info = join(' | ', @info);
    my @vals = ($s->{host}, $s->{disp}, $s->{user} // '', $info);
    my %fg;
    if (defined $s->{_xs_cmd}) {
        if ($s->{_xs_other_user}) {
            %fg = (-foreground => $s->{_xs_running} ? '#0055cc' : '#808080');
        } else {
            %fg = (-foreground => $s->{_xs_running} ? '#0a7d10' : '#c00000');
        }
    }
    my @widgets;
    # Read-only Entry widgets (rather than Labels) so the host/display/
    # user/info text is selectable for copy-paste — flat + borderless so
    # it still looks like a plain row.
    my $row_bg = $rows_f->cget('-background');
    for my $c (0 .. $#vals) {
        my $val = $vals[$c] // '';
        my $w = $rows_f->Entry(
            -relief             => 'flat',
            -borderwidth        => 0,
            -highlightthickness => 0,
            -takefocus          => 0,
            -readonlybackground => $row_bg,
            -width              => length($val) + 1,
            %fg,
        );
        $w->insert(0, $val);
        $w->configure(-state => 'readonly');
        $w->grid(-row => $r, -column => $c + 2, -sticky => 'ew', -padx => 6);
        push @widgets, $w;
    }
    my $sess = $s;
    my @ACTIONS_DETACHED = $sess->{kind} eq 'vnc'
        ? ('Attach', 'Secure VNC', 'Insecure VNC', 'X11-VNC',
           'Kill x11vnc', '---', 'SSH', 'Apps', 'Settings')
        : $sess->{kind} eq 'X'
        ? ('Secure VNC', 'Insecure VNC', 'X11-VNC',
           'Kill x11vnc', '---', 'SSH', 'Settings')
        : ('Attach', 'Secure VNC', 'Insecure VNC', 'X11-VNC',
           'Restart app', 'Restart Xpra', 'Restart Xpra+WWW',
           'Kill session',
           '---', 'SSH', 'Helper', 'Apps', 'Settings');
    my @ACTIONS_ATTACHED = $sess->{kind} eq 'vnc'
        ? ('Disconnect', 'Force kill', 'KILL',
           'Secure VNC', 'Insecure VNC', 'X11-VNC', 'Kill x11vnc',
           '---', 'SSH', 'Apps', 'Settings')
        : $sess->{kind} eq 'X'
        ? ('Disconnect', 'Force kill', 'KILL',
           'Secure VNC', 'Insecure VNC', 'X11-VNC', 'Kill x11vnc',
           '---', 'SSH', 'Settings')
        : ('Disconnect', 'Force kill', 'KILL', 'Terminal',
           'Secure VNC', 'Insecure VNC', 'X11-VNC',
           'Restart app', 'Restart Xpra', 'Restart Xpra+WWW',
           'Kill session',
           '---', 'SSH', 'Helper', 'Apps', 'Settings');
    # remmina hosts every connection in ONE shared client process/window, so a
    # Disconnect (kill of the attach + its group) would tear down everyone's
    # windows.  Drop Disconnect for remmina-backed rows and default to a benign
    # re-attach instead; Force kill/KILL stay for deliberate teardown.
    @ACTIONS_ATTACHED = grep { $_ ne 'Disconnect' } @ACTIONS_ATTACHED
        if $sess->{_remmina};
    my $attached_default = $sess->{_remmina} ? 'Secure VNC' : 'Disconnect';
    # Hide (soft, reversible) sits beside Remove (hard, permanent).  Hide
    # is on every row; Remove only on manually-added (_extra) hosts — a
    # discovered host would just reappear on the next scan.
    if ($sess->{_extra}) {
        push @ACTIONS_DETACHED, '---', 'Edit', 'Hide', 'Remove';
        push @ACTIONS_ATTACHED, '---', 'Edit', 'Hide', 'Remove';
    } else {
        push @ACTIONS_DETACHED, '---', 'Edit', 'Hide';
        push @ACTIONS_ATTACHED, '---', 'Edit', 'Hide';
    }
    # "Probe" + "Show last log" on every row: Probe dumps what's actually
    # running on the host into the log; Show last log re-opens that output.
    push @ACTIONS_DETACHED, 'Probe', 'Show last log';
    push @ACTIONS_ATTACHED, 'Probe', 'Show last log';
    my $fallback = $sess->{kind} eq 'X' ? 'Secure VNC' : 'Attach';
    my $last = $SETTINGS->{_last_action}{$sess->{host}};
    my $detached_default = (defined $last
        && grep { $_ eq $last } @ACTIONS_DETACHED) ? $last : $fallback;
    my $action = $detached_default;
    my $current_opts = \@ACTIONS_DETACHED;
    my $default_action = sub {
        return $sess->{pid} ? $attached_default : $detached_default;
    };
    my ($action_mb, $action_menu);
    my $set_actions = sub {
        my ($opts, $default) = @_;
        $current_opts = $opts if defined $opts;
        my %immediate = (
            Settings        => sub { _show_settings($sess) },
            Apps            => sub { _show_procs($sess) },
            Edit            => sub { _edit_extra_host($sess) },
            # Reversible: hide this row now; reveal via the ↕ toggle and
            # un-hide in Settings.  (Remove, by contrast, is permanent and
            # deferred behind ▶.)
            Hide            => sub { _hide_session($sess) },
            # Non-destructive: pop up the captured output of the last
            # logged command (currently Kill x11vnc) run from this row.
            'Show last log' => sub { _show_last_log($sess) },
        );
        $action_menu->delete(0, 'end');
        for my $o (@$current_opts) {
            if ($o eq '---') {
                $action_menu->add('separator');
                next;
            }
            my $val = $o;
            if (my $cb = $immediate{$val}) {
                $action_menu->add('command', -label => $o,
                    -command => $cb);
            } else {
                $action_menu->add('command', -label => $o,
                    -command => sub { $action = $val });
            }
        }
        if (defined $default) {
            $action = $default;
        } elsif (!grep { $_ eq $action } @$current_opts) {
            $action = $current_opts->[0] // '';
        }
    };
    $action_mb = $rows_f->Menubutton(
        -textvariable => \$action,
        -indicatoron  => 1,
        -relief       => 'raised',
        -borderwidth  => 1,
        -anchor       => 'w',
        -width        => 21,
    );
    $action_menu = $action_mb->Menu(-tearoff => 0);
    $action_mb->configure(-menu => $action_menu);
    if ($sess->{pid}) {
        $set_actions->(\@ACTIONS_ATTACHED, $attached_default);
    } else {
        $set_actions->(\@ACTIONS_DETACHED, $detached_default);
    }
    my $go_btn = $rows_f->Button(-text => "\x{25B6}",
        -command => sub {
            my $picked = $action;
            if ($picked eq 'Secure VNC') {
                _keys_ensure() unless $sess->{local};
                _bump_usage($sess->{host}, $picked);
                $detached_default = $picked;
                my $pid = spawn_attach($sess, 'Secure VNC',
                                       _vnc_attach_cmd($sess));
                $sess->{pid} = $pid;
                $set_actions->(\@ACTIONS_ATTACHED, $attached_default);
                return;
            }
            if ($picked eq 'Insecure VNC') {
                _bump_usage($sess->{host}, $picked);
                $detached_default = $picked;
                my $pid = spawn_attach($sess, 'Insecure VNC',
                                       _vnc_direct_cmd($sess));
                $sess->{pid} = $pid;
                $set_actions->(\@ACTIONS_ATTACHED, $attached_default);
                return;
            }
            if ($picked eq 'X11-VNC') {
                _keys_ensure() unless $sess->{local};
                _bump_usage($sess->{host}, $picked);
                $detached_default = $picked;
                my $pid = spawn_attach($sess, 'X11-VNC',
                                       _x11vnc_cmd($sess));
                $sess->{pid} = $pid;
                $set_actions->(\@ACTIONS_ATTACHED, $attached_default);
                return;
            }
            if ($picked eq 'Kill x11vnc') {
                # Select-then-▶ (so it's cancelable — change the dropdown
                # before pressing ▶ and nothing happens).  Clears a stale
                # x11vnc holding the rfb port on this display.  Not sticky:
                # no _bump_usage / $detached_default, and we reset $action
                # afterward so it never lingers armed or becomes the row's
                # remembered default.
                _keys_ensure() unless $sess->{local};
                spawn_logged($sess, 'Kill x11vnc', _kill_x11vnc_cmd($sess));
                $action = $default_action->();
                return;
            }
            if ($picked eq 'Kill session') {
                # Stop the xpra session server on this display (frees its
                # memory).  Destructive — confirm first, offering Stop
                # (graceful `xpra stop`) vs Kill (graceful, then pkill any
                # leftover Xdummy/Xvfb/xpra for the display).  Logged so the
                # result is visible via "Show last log".
                my $choice = _kill_session_dialog($sess);
                if ($choice) {       # 'stop' or 'kill'; undef = cancel
                    _keys_ensure() unless $sess->{local};
                    spawn_logged($sess, "Kill session ($choice)",
                                 _kill_session_cmd($sess, $choice eq 'kill'));
                }
                $action = $default_action->();
                return;
            }
            if ($picked eq 'Probe') {
                # Select-then-▶: run the broad host probe, then auto-open
                # its log once it's had time to finish (ssh + the remote
                # commands).  Refresh in the log window re-reads if it's
                # still arriving.  Not sticky — reset $action afterward.
                _keys_ensure() unless $sess->{local};
                spawn_logged($sess, 'Probe', _probe_host_cmd($sess));
                $mw->after(2500, sub { _show_last_log($sess) });
                $action = $default_action->();
                return;
            }
            if ($picked eq 'Attach') {
                _keys_ensure() unless $sess->{local};
                _bump_usage($sess->{host}, $picked);
                $detached_default = $picked;
                my $pid = spawn_attach($sess, 'Attach',
                    $sess->{kind} eq 'vnc'
                        ? _vnc_attach_cmd($sess)
                        : _attach_cmd($sess));
                $sess->{pid} = $pid;
                $set_actions->(\@ACTIONS_ATTACHED, $attached_default);
                return;
            }
            if ($picked eq 'Attach Browser') {
                my $url = $sess->{_html_url};
                spawn_detached('xpra-helper', $url) if $url;
            }
            elsif ($picked eq 'Terminal') {
                _keys_ensure() unless $sess->{local};
                spawn_detached(_term_cmd($sess));
            }
            elsif ($picked eq 'SSH') {
                _keys_ensure() unless $sess->{local};
                my @cmd = _ssh_cmd($sess);
                _dbg("[debug] SSH: ", join(' ', map { /\s/ ? "'$_'" : $_ } @cmd));
                spawn_detached(@cmd);
            }
            elsif ($picked eq 'Helper') {
                spawn_detached('xpra-helper', '--pin');
            }
            elsif ($picked eq 'Edit') {
                _edit_extra_host($sess);
                return;
            }
            elsif ($picked eq 'Remove') {
                _remove_session($sess);
                return;
            }
            elsif ($picked eq 'Apps') {
                _show_procs($sess);
            }
            elsif ($picked eq 'Settings') {
                _show_settings($sess);
            }
            elsif ($picked eq 'Restart app'
                || $picked eq 'Restart Xpra'
                || $picked eq 'Restart Xpra+WWW') {
                _keys_ensure() unless $sess->{local};
                spawn_detached(_launch_xpra_cmd($sess, $picked));
            }
            elsif (my $pid = $sess->{pid}) {
                # User-initiated termination: drop the attach-info so
                # the reap timer doesn't mistake the kill for a failed
                # connection and pop up a diagnostics window.  Keep the
                # log file — "Show last log" still points at it via
                # $sess->{_last_log}; it's replaced on the next command.
                delete $ATTACH_INFO{$pid};
                if ($picked eq 'Disconnect') {
                    kill 'TERM', $pid;
                    $action = 'Force kill';
                    $mw->after(2000, sub {
                        return unless $sess->{pid} && $sess->{pid} == $pid;
                        kill 'TERM', -$pid;
                        kill 'TERM',  $pid;
                        $action = 'KILL';
                        $mw->after(2000, sub {
                            return unless $sess->{pid} && $sess->{pid} == $pid;
                            kill 'KILL', -$pid;
                            kill 'KILL',  $pid;
                        });
                    });
                    return;
                }
                elsif ($picked eq 'Force kill') {
                    kill 'TERM', -$pid;
                    kill 'TERM',  $pid;
                }
                elsif ($picked eq 'KILL') {
                    kill 'KILL', -$pid;
                    kill 'KILL',  $pid;
                }
            }
            $action = $default_action->();
        });
    push @widgets, $action_mb, $go_btn;
    $action_mb->grid(-row => $r, -column => 0, -padx => 6, -pady => 1, -sticky => 'ew');
    $go_btn   ->grid(-row => $r, -column => 1, -padx => 6, -pady => 1, -sticky => 'ew');
    $BALLOON->attach($action_mb,
        -balloonmsg => 'Pick an action for this session, then press ▶ to '
                     . 'run it. Settings/Apps/Edit open immediately.');
    $BALLOON->attach($go_btn,
        -balloonmsg => 'Run the selected action on this session.');
    $sess->{_widgets} = \@widgets;
    $sess->{_enable_browser} = sub {
        return if grep { $_ eq 'Attach Browser' } @ACTIONS_DETACHED;
        splice(@ACTIONS_DETACHED, 1, 0, 'Attach Browser');
        splice(@ACTIONS_ATTACHED, 1, 0, 'Attach Browser');
        $set_actions->();
    };
    $sess->{_set_actions}      = $set_actions;
    $sess->{_actions_detached} = \@ACTIONS_DETACHED;
    $sess->{_detached_default} = \$detached_default;
    $r++;
}
for my $s (@sessions) { _render_row($s) }
$mw->after(50, $_update_scroll);

# Re-render every row from scratch — used by the "known hosts only"
# toggle.  Destroys current row widgets, resets the grid row counter, and
# re-renders whichever sessions _row_visible() now admits.
sub _rerender_rows {
    for my $s (@sessions) {
        $_->destroy for @{ $s->{_widgets} // [] };
        delete $s->{_widgets};
    }
    $r = 1;
    for my $s (@sessions) { _render_row($s) }
    $mw->after(50, $_update_scroll);
}

# Background HTML5-port probe.  We can't synchronously TCP-connect from
# the Tk thread without freezing the UI on closed/firewalled ports
# (1s × N), so a forked child does the probes serially and writes
# "host\tdisp_n\tport\tfound\n" back through a pipe.  Plain pipe() +
# typeglobs (rather than IO::Pipe) so Tk's fileevent has no doubt about
# what filehandle it's polling — empirically the IO::Pipe variant
# stayed silent.  sysread + line-buffer drain handles the "multiple
# lines arrived in one read" case (Smak Gotcha #11).
{
    pipe(my $html_r, my $html_w) or warn "find-xpra: html pipe: $!\n";
    # Snapshot every IPv4 we own so the probe can also try the real
    # interface for "local" sessions — xpra-web bound to a specific
    # NIC (eg 192.168.x.y) won't be reachable on 127.0.0.1.
    my @local_ips = sort grep {
        /^\d+\.\d+\.\d+\.\d+\z/ && !/^127\./
    } keys %{ _local_ips_set() };
    if ($html_r && $html_w) {
        my $html_kid = fork;
        if (!defined $html_kid) {
            warn "find-xpra: html probe fork: $!\n";
            close $html_r; close $html_w;
        } elsif ($html_kid == 0) {
            close $html_r;
            select((select($html_w), $|=1)[0]);
            POSIX::setsid();
            open STDIN, '<', '/dev/null';
            for my $s (@sessions) {
                next unless defined $s->{disp_n};
                my $port = 14500 + $s->{disp_n};
                # Try several addresses; the first to accept wins and
                # becomes the URL host.  Loopback first for local
                # sessions (covers xpra-web on 127.0.0.1); then the
                # session's IP and hostname (covers xpra-web bound to
                # a real interface, e.g. 192.168.x.y, even when the
                # session is "local" to find-xpra).
                my @addrs;
                if ($s->{local}) {
                    push @addrs, '127.0.0.1', @local_ips;
                }
                for my $a ($s->{ip}, $s->{host}) {
                    next unless defined $a && length $a;
                    push @addrs, $a unless grep { $_ eq $a } @addrs;
                }
                my $found = '';
                for my $addr (@addrs) {
                    my $sock = IO::Socket::INET->new(
                        PeerAddr => $addr, PeerPort => $port,
                        Proto => 'tcp', Timeout => 1);
                    if ($sock) { close $sock; $found = $addr; last }
                }
                _dbg("[debug] html: $s->{host} :$s->{disp_n} port=$port "
                   . "addrs=[@addrs] found=" . ($found // '-'));
                print $html_w
                    join("\t", $s->{host}, $s->{disp_n}, $port, $found), "\n";
            }
            close $html_w;
            POSIX::_exit(0);
        } else {
            close $html_w;
            my $buf = '';
            $mw->fileevent($html_r, 'readable', sub {
                my $n = sysread($html_r, my $chunk, 4096);
                if (!$n) {
                    $mw->fileevent($html_r, 'readable', '');
                    close $html_r;
                    waitpid($html_kid, 0);
                    _dbg("[debug] html: probe child reaped");
                    return;
                }
                $buf .= $chunk;
                while ($buf =~ s/^([^\n]*)\n//) {
                    my ($h, $d, $p, $found) = split /\t/, $1, 4;
                    _dbg("[debug] html: result host=$h disp=$d port=$p "
                       . "found=" . (defined $found && length $found ? $found : '-'));
                    next unless defined $found && length $found;
                    for my $s (@sessions) {
                        next unless $s->{host} eq $h
                                 && defined $s->{disp_n}
                                 && $s->{disp_n} == $d;
                        $s->{_html_url} = "https://$found:$p/";
                        $s->{_enable_browser}->() if $s->{_enable_browser};
                        _dbg("[debug] html: enabled browser action for "
                           . "$h :$d -> $s->{_html_url}");
                        last;
                    }
                }
            });
        }
    }
}

# Reap exited viewer processes so the UI flips back when the viewer closes
# on its own.  Try waitpid first — it handles both freshly spawned children
# AND children inherited through exec (Rescan).  For truly external
# processes (adopted from a different find-xpra PID), waitpid returns -1
# (ECHILD); fall back to kill(0) for those.
$mw->repeat(750, sub {
    for my $s (@sessions) {
        my $pid = $s->{pid} // next;
        my $r = waitpid($pid, POSIX::WNOHANG());
        my $status = $?;
        my $gone = $r > 0              ? 1
                 : $r == 0             ? 0
                 : !kill(0, $pid);      # -1 (ECHILD): not our child
        if ($gone) {
            $s->{pid} = undef;
            $s->{_adopted} = 0;
            $s->{_set_actions}->($s->{_actions_detached},
                                 ${$s->{_detached_default}});
            # Diagnostic pop-up: a viewer that exits non-zero shortly
            # after launch is almost certainly a failed connection, not
            # a user-initiated close.  Show the command + captured
            # stdout/stderr so the user can see what went wrong.
            if (my $info = delete $ATTACH_INFO{$pid}) {
                my $runtime = time - ($info->{start} // time);
                if ($r > 0 && $status != 0 && $runtime < 5) {
                    _show_attach_diag($s, $info, $status);
                }
                # Don't unlink the log — "Show last log" still points at
                # it ($s->{_last_log} shares this path).  It's replaced
                # when the next command runs on this row.
            }
        }
    }
});

Tk::MainLoop();

# Dump the visible session table to the X clipboard as tab-separated text
# (Host / Disp / User / Info, headed by the column names).  Useful when
# the user wants to share the list — per-cell Entry widgets only support
# single-field selection.
sub _copy_sessions_to_clipboard {
    my @lines = (join("\t", qw(Host Disp User Info)));
    for my $s (@sessions) {
        my @info;
        push @info, $s->{kind} if defined $s->{kind} && $s->{kind} ne 'xpra';
        if (defined $s->{apps} && $s->{apps} ne '(root display)'
            && $s->{apps} ne '(daemons only)') {
            push @info, $s->{apps};
        }
        push @lines, join("\t",
            $s->{host}        // '',
            $s->{disp}        // '',
            $s->{user}        // '',
            join(' | ', @info));
    }
    my $text = join("\n", @lines) . "\n";
    $mw->clipboardClear;
    $mw->clipboardAppend($text);
}

# Application-wide settings (header "Settings" button) — distinct from the
# per-host dialog below.  Currently just the max-display ceiling; designed
# to grow.  Saves to ~/.config/find-xpra/config.json.  Changing the ceiling
# offers an immediate Rescan so the new value takes effect on the list.
sub _show_app_settings {
    my ($parent) = @_;
    my $top = $parent->Toplevel(-title => 'find-xpra: settings');
    $top->transient($parent);

    $top->Label(-text => 'Maximum display number to show:',
                -font => 'sans-serif 11 bold')
        ->pack(-anchor => 'w', -padx => 12, -pady => [10, 2]);
    $top->Label(-text => 'Sessions on displays above this are hidden '
                       . "(e.g. xpra shadow servers on :1000000+).\n"
                       . '0 or blank = no limit.  Default is '
                       . "$MAX_DISP_DEFAULT.",
                -justify => 'left', -anchor => 'w')
        ->pack(-anchor => 'w', -padx => 12);
    my $val = defined $max_disp ? $max_disp : 0;
    $top->Entry(-textvariable => \$val, -width => 10, -justify => 'right')
        ->pack(-anchor => 'w', -padx => 30, -pady => [4, 0]);

    # VNC viewer backend.  'auto' = let net-vnc pick (remmina if present),
    # except tunneled modes (Secure VNC / X11-VNC) auto-prefer a blocking
    # viewer so the ssh tunnel survives.  Pick a specific viewer to force
    # it everywhere.  Only offers viewers actually found on PATH.
    $top->Label(-text => 'VNC viewer backend:',
                -font => 'sans-serif 11 bold')
        ->pack(-anchor => 'w', -padx => 12, -pady => [14, 2]);
    $top->Label(-text => "'auto' lets the system choose (remmina if "
                       . "installed).\nremmina detaches immediately, which "
                       . "breaks tunneled\nSecure VNC / X11-VNC — pick "
                       . 'vncviewer for those.',
                -justify => 'left', -anchor => 'w')
        ->pack(-anchor => 'w', -padx => 12);
    my @viewers = ('auto');
    for my $cand (qw(remmina vncviewer xtigervncviewer xvncviewer gvncviewer)) {
        push @viewers, $cand if _have_exe($cand);
    }
    my $viewer_val = $SETTINGS->{_vnc_viewer} // 'auto';
    push @viewers, $viewer_val
        unless grep { $_ eq $viewer_val } @viewers;   # keep a stale choice visible
    my $viewer_om = $top->Optionmenu(
        -options  => [@viewers],
        -variable => \$viewer_val,
    );
    $viewer_om->pack(-anchor => 'w', -padx => 30, -pady => [4, 0]);
    $viewer_om->setOption($viewer_val)
        if grep { $_ eq $viewer_val } @viewers;

    # ssh-askpass program.  ssh needs a GUI askpass to prompt for
    # passwords (the probe forks have no tty); if the configured one
    # isn't installed, connections silently fail.  Free-text (Entry, not
    # a dropdown) because the right program varies by platform — Cygwin,
    # BSD, etc. live outside our Linux candidate list.  'auto' or blank =
    # auto-detect the first installed candidate; anything else is used
    # verbatim (bare name resolved on PATH by ssh, or a full path).
    $top->Label(-text => 'SSH askpass program:',
                -font => 'sans-serif 11 bold')
        ->pack(-anchor => 'w', -padx => 12, -pady => [14, 2]);
    my $ap_now = _askpass();
    my @installed = grep { -x $_ } @ASKPASS_CANDIDATES;
    $top->Label(-text => "GUI password prompt for ssh.  'auto' or blank "
                       . "= auto-detect; or give a name/path.\n"
                       . 'Currently resolves to: '
                       . ($ap_now // '(NONE FOUND — connections will fail)')
                       . "\nDetected on this box: "
                       . (@installed ? join(', ', @installed) : '(none)'),
                -justify => 'left', -anchor => 'w')
        ->pack(-anchor => 'w', -padx => 12);
    my $askpass_val = $SETTINGS->{_askpass} // 'auto';
    my $ap_row = $top->Frame->pack(-anchor => 'w', -fill => 'x',
                                   -padx => 30, -pady => [4, 0]);
    my $askpass_e = $ap_row->Entry(-textvariable => \$askpass_val, -width => 40);
    $askpass_e->pack(-side => 'left', -fill => 'x', -expand => 1);
    $ap_row->Button(-text => 'Browse', -command => sub {
        my $f = $top->getOpenFile(-title => 'Select ssh-askpass program');
        $askpass_val = $f if defined $f && length $f;
    })->pack(-side => 'left', -padx => [4, 0]);

    # Extra ssh arguments appended to every ssh invocation (probe, attach,
    # VNC tunnel, terminal, ...).  e.g. -Y for trusted X11 forwarding, or
    # -C for compression.  Split on whitespace; stored verbatim.
    $top->Label(-text => 'Extra ssh arguments:',
                -font => 'sans-serif 11 bold')
        ->pack(-anchor => 'w', -padx => 12, -pady => [14, 2]);
    $top->Label(-text => 'Passed to every ssh call (e.g. -Y for trusted '
                       . "X11 forwarding, -C for compression).\n"
                       . 'Space-separated; leave blank for none.',
                -justify => 'left', -anchor => 'w')
        ->pack(-anchor => 'w', -padx => 12);
    my $sshargs_val = $SETTINGS->{_ssh_extra_args} // '';
    my $sa_row = $top->Frame->pack(-anchor => 'w', -fill => 'x',
                                   -padx => 30, -pady => [4, 0]);
    my $sshargs_e = $sa_row->Entry(-textvariable => \$sshargs_val, -width => 40);
    $sshargs_e->pack(-side => 'left', -fill => 'x', -expand => 1);
    $sa_row->Button(-text => '-Y', -command => sub {
        $sshargs_val = length $sshargs_val ? "$sshargs_val -Y" : '-Y'
            unless $sshargs_val =~ /(?:^|\s)-Y(?:\s|$)/;
    })->pack(-side => 'left', -padx => [4, 0]);

    my $err = '';
    $top->Label(-textvariable => \$err, -foreground => '#c00000')
        ->pack(-anchor => 'w', -padx => 12, -pady => [2, 0]);

    my $btns = $top->Frame->pack(-pady => 10);
    my $save = sub {
        my ($rescan) = @_;
        (my $v = $val) =~ s/^\s+|\s+$//g;
        $v = '0' if $v eq '';
        unless ($v =~ /^\d+$/) {
            $err = 'Enter a non-negative whole number (0 = no limit)';
            return;
        }
        $v += 0;
        if ($v == 0) {
            delete $SETTINGS->{_max_disp};
            $max_disp = undef;
        } else {
            $SETTINGS->{_max_disp} = $v;
            $max_disp = $v;
        }
        if (!defined $viewer_val || $viewer_val eq 'auto') {
            delete $SETTINGS->{_vnc_viewer};
        } else {
            $SETTINGS->{_vnc_viewer} = $viewer_val;
        }
        $askpass_val =~ s/^\s+|\s+$//g if defined $askpass_val;
        if (!defined $askpass_val || !length $askpass_val
            || $askpass_val eq 'auto') {
            delete $SETTINGS->{_askpass};
        } else {
            $SETTINGS->{_askpass} = $askpass_val;
        }
        _save_settings($SETTINGS);
        $top->destroy;
        if ($rescan) {
            $_save_geometry->();
            exec { $^X } $^X, $0, @ORIG_ARGV;
        }
    };
    $btns->Button(-text => 'Save & Rescan', -command => sub { $save->(1) })
        ->pack(-side => 'left', -padx => 6);
    $btns->Button(-text => 'Save', -command => sub { $save->(0) })
        ->pack(-side => 'left', -padx => 6);
    $btns->Button(-text => 'Cancel', -command => sub { $top->destroy })
        ->pack(-side => 'left', -padx => 6);
    $top->protocol('WM_DELETE_WINDOW' => sub { $top->destroy });
}

# Pop up a per-host settings window — currently just terminal choice,
# but designed to grow.  Saves to ~/.config/find-xpra/config.json on Save.
sub _show_settings {
    my ($s) = @_;
    my $host = $s->{host};
    my $top  = $mw->Toplevel(-title => "find-xpra: settings for $host");

    # Host info section
    my $info_f = $top->Frame(-relief => 'groove', -borderwidth => 2);
    $info_f->pack(-fill => 'x', -padx => 12, -pady => [8, 4]);
    my @info_rows;
    push @info_rows, ['Host:', $host];
    push @info_rows, ['IP:', $s->{ip}] if defined $s->{ip} && $s->{ip} ne $host;
    push @info_rows, ['Display:', $s->{disp}] if defined $s->{disp};
    if (my $cur_port = $SETTINGS->{$host}{ssh_port}) {
        push @info_rows, ['SSH port:', $cur_port];
    }
    my $usage = $SETTINGS->{_usage}{$host} // 0;
    push @info_rows, ['Connections:', $usage] if $usage;
    my $last = $SETTINGS->{_last_action}{$host};
    push @info_rows, ['Last action:', $last] if defined $last;
    for my $i (0 .. $#info_rows) {
        $info_f->Label(-text => $info_rows[$i][0], -font => 'sans-serif 10 bold',
                       -anchor => 'e', -width => 14)
            ->grid(-row => $i, -column => 0, -sticky => 'e', -padx => [6, 2]);
        $info_f->Label(-text => $info_rows[$i][1], -anchor => 'w')
            ->grid(-row => $i, -column => 1, -sticky => 'w', -padx => [2, 6]);
    }

    $top->Label(-text => "Terminal for $host:",
                -font => 'sans-serif 11 bold')
        ->pack(-anchor => 'w', -padx => 12, -pady => 6);

    my @choices = qw(xterm mate-terminal gnome-terminal urxvt
                     alacritty kitty terminator lxterminal st);
    my $sel = _terminal_for($host);
    for my $t (@choices) {
        $top->Radiobutton(-text => $t, -value => $t, -variable => \$sel,
                          -anchor => 'w')
            ->pack(-fill => 'x', -padx => 30);
    }

    # Per-host DPI override.  Blank = inherit the global default DPI
    # (set beside the Rescan button).
    $top->Label(-text => "DPI override for $host (blank = use default):",
                -font => 'sans-serif 11 bold')
        ->pack(-anchor => 'w', -padx => 12, -pady => [10, 6]);
    my $host_dpi = $SETTINGS->{$host}{dpi} // '';
    $top->Entry(-textvariable => \$host_dpi, -width => 8, -justify => 'right')
        ->pack(-anchor => 'w', -padx => 30);

    # SSH user override — used as the login for attach / VNC / SSH actions.
    $top->Label(-text => "SSH user for $host (blank = default):",
                -font => 'sans-serif 11 bold')
        ->pack(-anchor => 'w', -padx => 12, -pady => [10, 6]);
    my $host_ssh_user = $SETTINGS->{$host}{ssh_user} // '';
    $top->Entry(-textvariable => \$host_ssh_user, -width => 20)
        ->pack(-anchor => 'w', -padx => 30);

    # SSH port override — e.g. a forwarded port reaching a VM behind
    # Hyper-V / VirtualBox NAT.  Blank or 22 = default.
    $top->Label(-text => "SSH port for $host (blank = 22):",
                -font => 'sans-serif 11 bold')
        ->pack(-anchor => 'w', -padx => 12, -pady => [10, 6]);
    my $host_ssh_port = $SETTINGS->{$host}{ssh_port} // '';
    $top->Entry(-textvariable => \$host_ssh_port, -width => 8, -justify => 'right')
        ->pack(-anchor => 'w', -padx => 30);

    # VNC zoom factor — percentage applied via FLTK_SCALING_FACTOR /
    # GDK_DPI_SCALE / QT_SCALE_FACTOR when launching vncviewer.
    $top->Label(-text => "VNC zoom % for $host (blank = 100%):",
                -font => 'sans-serif 11 bold')
        ->pack(-anchor => 'w', -padx => 12, -pady => [10, 6]);
    my $host_zoom = $SETTINGS->{$host}{vnc_zoom} // '';
    $top->Entry(-textvariable => \$host_zoom, -width => 8, -justify => 'right')
        ->pack(-anchor => 'w', -padx => 30);

    # Hide this session (host+display): hidden sessions show only via the
    # ↕ "show hidden" toggle (or --all).  Defaults on for the local :0.
    my $hide_key = ($s->{host} // '') . "\t" . ($s->{disp_n} // '');
    my $hide_val = exists $SETTINGS->{_hidden}{$hide_key}
        ? ($SETTINGS->{_hidden}{$hide_key} ? 1 : 0)
        : (($s->{local} && defined $s->{disp_n} && $s->{disp_n} == 0) ? 1 : 0);
    $top->Checkbutton(
        -text     => 'Hide this session (show only via the ↕ toggle)',
        -variable => \$hide_val,
        -anchor   => 'w',
    )->pack(-anchor => 'w', -padx => 12, -pady => [12, 0]);

    my $btns = $top->Frame->pack(-pady => 10);
    $btns->Button(-text => 'Save', -command => sub {
        $SETTINGS->{$host}{terminal} = $sel;
        $host_ssh_user =~ s/^\s+|\s+$//g;
        if (length $host_ssh_user) {
            $SETTINGS->{$host}{ssh_user} = $host_ssh_user;
            $s->{_attach_as} = $host_ssh_user;
        } else {
            delete $SETTINGS->{$host}{ssh_user};
            delete $s->{_attach_as};
        }
        $host_dpi =~ s/^\s+|\s+$//g;
        if (length $host_dpi && $host_dpi =~ /^\d+$/) {
            $SETTINGS->{$host}{dpi} = $host_dpi + 0;
        } else {
            delete $SETTINGS->{$host}{dpi};
        }
        $host_ssh_port =~ s/^\s+|\s+$//g;
        if (length $host_ssh_port && $host_ssh_port =~ /^\d+$/
                && $host_ssh_port > 0 && $host_ssh_port < 65536
                && $host_ssh_port != 22) {
            $SETTINGS->{$host}{ssh_port} = $host_ssh_port + 0;
        } else {
            delete $SETTINGS->{$host}{ssh_port};
        }
        $host_zoom =~ s/^\s+|\s+$//g;
        if (length $host_zoom && $host_zoom =~ /^\d+$/ && $host_zoom != 100) {
            $SETTINGS->{$host}{vnc_zoom} = $host_zoom + 0;
        } else {
            delete $SETTINGS->{$host}{vnc_zoom};
        }
        # Store an explicit 0/1 (not delete-when-0) so un-hiding the local
        # :0 sticks against its default-hidden behaviour in _session_hidden.
        $SETTINGS->{_hidden}{$hide_key} = $hide_val ? 1 : 0;
        _save_settings($SETTINGS);
        $top->destroy;
        _rerender_rows() if defined &_rerender_rows;
    })->pack(-side => 'left', -padx => 6);
    $btns->Button(-text => 'Cancel', -command => sub { $top->destroy })
         ->pack(-side => 'left', -padx => 6);
}

# Pop up a window with every process on this (host, display).  Useful
# when the picked "main app" doesn't represent what's really running.
sub _show_procs {
    my ($s) = @_;
    my $top = $mw->Toplevel(-title => "$s->{host} $s->{disp} — all processes");
    my $txt = $top->Scrolled('Text',
                             -scrollbars => 'osoe',
                             -width      => 110,
                             -height     => 25,
                             -font       => 'monospace 10',
                             -wrap       => 'none',
                            )->pack(-fill => 'both', -expand => 1);
    for my $p (@{ $s->{procs} }) {
        $txt->insert('end', sprintf("%7d  %-10s  %s\n",
                     $p->{pid}, $p->{user}, $p->{cmd}));
    }
    $txt->configure(-state => 'disabled');
    $top->Button(-text => 'Close', -command => sub { $top->destroy })
        ->pack(-pady => 4);
}

# Pop up a diagnostics window when an attach child exited quickly with
# non-zero status.  Shows the command that was run, the exit info, and
# the captured stdout/stderr so the user can see why it failed.
sub _show_attach_diag {
    my ($s, $info, $status) = @_;
    my $exit   = $status >> 8;
    my $signal = $status & 0x7f;
    my $reason = $signal ? "killed by signal $signal"
               : $exit == 127 ? "command not found (exit 127)"
               : "exit code $exit";
    my $cmd = join(' ', map { /[\s'"\\]/ ? "'$_'" : $_ } @{ $info->{cmd} });
    my $log = '';
    if ($info->{log} && -e $info->{log}) {
        if (open my $fh, '<', $info->{log}) {
            local $/; $log = <$fh>;
            close $fh;
        }
        # Don't unlink — $sess->{_last_log} shares this path so the user
        # can reopen it via "Show last log".  Replaced on next command.
    }
    $log = "(no output captured)\n" unless length $log;
    my $top = $mw->Toplevel(-title =>
        "find-xpra: connection failed — $s->{host} $s->{disp}");
    $top->transient($mw);
    $top->Label(-text => "Connection to $s->{host} $s->{disp} failed",
                -font => 'sans-serif 12 bold', -foreground => '#c00000')
        ->pack(-anchor => 'w', -padx => 12, -pady => [10, 4]);
    $top->Label(-text => $reason, -anchor => 'w')
        ->pack(-anchor => 'w', -padx => 12);
    $top->Label(-text => 'Command:', -font => 'sans-serif 10 bold',
                -anchor => 'w')
        ->pack(-anchor => 'w', -padx => 12, -pady => [8, 0]);
    my $cmd_txt = $top->Scrolled('Text',
                                 -scrollbars => 'oe',
                                 -width      => 100,
                                 -height     => 3,
                                 -font       => 'monospace 9',
                                 -wrap       => 'word',
                                )->pack(-fill => 'x', -padx => 12, -pady => 2);
    $cmd_txt->insert('end', $cmd);
    $cmd_txt->configure(-state => 'disabled');
    $top->Label(-text => 'Output:', -font => 'sans-serif 10 bold',
                -anchor => 'w')
        ->pack(-anchor => 'w', -padx => 12, -pady => [8, 0]);
    my $out_txt = $top->Scrolled('Text',
                                 -scrollbars => 'osoe',
                                 -width      => 100,
                                 -height     => 20,
                                 -font       => 'monospace 9',
                                 -wrap       => 'none',
                                )->pack(-fill => 'both', -expand => 1,
                                        -padx => 12, -pady => 2);
    $out_txt->insert('end', $log);
    $out_txt->configure(-state => 'disabled');
    my $btns = $top->Frame->pack(-pady => 8);
    $btns->Button(-text => 'Copy command', -command => sub {
        $top->clipboardClear;
        $top->clipboardAppend($cmd);
    })->pack(-side => 'left', -padx => 4);
    $btns->Button(-text => 'Close', -command => sub { $top->destroy })
         ->pack(-side => 'left', -padx => 4);
}

# Show the captured output of the last logged command run from this row
# (see spawn_logged).  Non-destructive: the log file is left in place so
# it can be re-viewed.  If nothing has been run yet, say so.
sub _show_last_log {
    my ($s) = @_;
    my $ll = $s->{_last_log};
    unless ($ll) {
        my $top = $mw->Toplevel(-title => "find-xpra: last log — $s->{host}");
        $top->transient($mw);
        $top->Label(-text => "No logged command has been run from "
                           . "$s->{host} $s->{disp} yet.",
                    -padx => 24, -pady => 24)->pack;
        $top->Button(-text => 'Close', -command => sub { $top->destroy })
            ->pack(-pady => [0, 12]);
        return;
    }
    my $cmd = join(' ', map { /[\s'"\\]/ ? "'$_'" : $_ } @{ $ll->{cmd} });
    my $when = $ll->{start} ? _ago(time - $ll->{start}) . ' ago' : '';
    my $log = '';
    if ($ll->{log} && -e $ll->{log}) {
        if (open my $fh, '<', $ll->{log}) {
            local $/; $log = <$fh>;
            close $fh;
        }
    }
    $log = "(no output captured — command may still be running)\n"
        unless length $log;
    my $title = $ll->{label} // 'command';
    my $top = $mw->Toplevel(-title =>
        "find-xpra: $title log — $s->{host} $s->{disp}");
    $top->transient($mw);
    $top->Label(-text => "$title on $s->{host} $s->{disp}"
                       . ($when ? "  ($when)" : ''),
                -font => 'sans-serif 12 bold')
        ->pack(-anchor => 'w', -padx => 12, -pady => [10, 4]);
    $top->Label(-text => 'Command:', -font => 'sans-serif 10 bold',
                -anchor => 'w')
        ->pack(-anchor => 'w', -padx => 12, -pady => [8, 0]);
    my $cmd_txt = $top->Scrolled('Text',
                                 -scrollbars => 'oe',
                                 -width      => 100,
                                 -height     => 3,
                                 -font       => 'monospace 9',
                                 -wrap       => 'word',
                                )->pack(-fill => 'x', -padx => 12, -pady => 2);
    $cmd_txt->insert('end', $cmd);
    $cmd_txt->configure(-state => 'disabled');
    $top->Label(-text => 'Output:', -font => 'sans-serif 10 bold',
                -anchor => 'w')
        ->pack(-anchor => 'w', -padx => 12, -pady => [8, 0]);
    my $out_txt = $top->Scrolled('Text',
                                 -scrollbars => 'osoe',
                                 -width      => 100,
                                 -height     => 20,
                                 -font       => 'monospace 9',
                                 -wrap       => 'none',
                                )->pack(-fill => 'both', -expand => 1,
                                        -padx => 12, -pady => 2);
    $out_txt->insert('end', $log);
    $out_txt->configure(-state => 'disabled');
    my $btns = $top->Frame->pack(-pady => 8);
    $btns->Button(-text => 'Refresh', -command => sub {
        my $new = '';
        if ($ll->{log} && -e $ll->{log} && open my $fh, '<', $ll->{log}) {
            local $/; $new = <$fh>;
            close $fh;
        }
        $new = "(no output captured — command may still be running)\n"
            unless length $new;
        $out_txt->configure(-state => 'normal');
        $out_txt->delete('1.0', 'end');
        $out_txt->insert('end', $new);
        $out_txt->configure(-state => 'disabled');
    })->pack(-side => 'left', -padx => 4);
    $btns->Button(-text => 'Copy command', -command => sub {
        $top->clipboardClear;
        $top->clipboardAppend($cmd);
    })->pack(-side => 'left', -padx => 4);
    # Copy the whole captured output to the clipboard — selecting text in a
    # disabled scrolled Text widget is fiddly, so give the user a one-click
    # grab.  Re-read the (possibly Refreshed) widget contents rather than
    # the stale $log so a Refresh-then-Copy gets the latest.
    $btns->Button(-text => 'Copy output', -command => sub {
        my $txt = $out_txt->get('1.0', 'end');
        $top->clipboardClear;
        $top->clipboardAppend($txt);
    })->pack(-side => 'left', -padx => 4);
    $btns->Button(-text => 'Close', -command => sub { $top->destroy })
         ->pack(-side => 'left', -padx => 4);
}

exit 0;

our $XPRA_BIN;
sub _xpra_bin {
    return $XPRA_BIN if defined $XPRA_BIN;
    _dbg("[debug] _xpra_bin: \$^O=$^O  XPRA=" . ($ENV{XPRA} // '(unset)'));
    # Honour an explicit override first (e.g. XPRA=/path/to/xpra).
    if (defined $ENV{XPRA} && length $ENV{XPRA}) {
        _dbg("[debug] _xpra_bin: using XPRA env=$ENV{XPRA}");
        return $XPRA_BIN = $ENV{XPRA};
    }
    # Cygwin/MSYS/Windows: prefer the native Windows install under
    # Program Files over whatever `command -v xpra` reports.  Cygwin's
    # PATH often leaks Windows directories so PATH lookup can find a
    # broken stub or a binary that won't actually run from a Cygwin
    # process; the explicit Xpra_cmd.exe / Xpra.exe paths are the
    # reliable choice.  $^O is "cygwin" / "msys" / "MSWin32".
    if ($^O =~ /^(?:cygwin|msys|MSWin32)$/i) {
        for my $p (
            '/cygdrive/c/Program Files/Xpra/Xpra_cmd.exe',
            '/cygdrive/c/Program Files (x86)/Xpra/Xpra_cmd.exe',
            '/cygdrive/c/Program Files/Xpra/Xpra.exe',
            '/cygdrive/c/Program Files (x86)/Xpra/Xpra.exe',
            'C:/Program Files/Xpra/Xpra_cmd.exe',
            'C:/Program Files (x86)/Xpra/Xpra_cmd.exe',
            'C:/Program Files/Xpra/Xpra.exe',
            'C:/Program Files (x86)/Xpra/Xpra.exe',
        ) {
            my $hit = -e $p ? 'exists' : 'missing';
            my $exec = -x $p ? 'exec'   : 'noexec';
            _dbg("[debug] _xpra_bin:   $p ($hit, $exec)");
            if (-e $p) {
                _dbg("[debug] _xpra_bin: using $p");
                return $XPRA_BIN = $p;
            }
        }
    }
    # If something on PATH responds, use it.
    my $rc = system 'sh', '-c', 'command -v xpra >/dev/null 2>&1';
    _dbg("[debug] _xpra_bin: PATH lookup rc=$rc -> "
         . ($rc == 0 ? 'using bare xpra' : 'falling through'));
    return $XPRA_BIN = 'xpra' if $rc == 0;
    # Last resort — let exec fail loudly rather than silently.
    return $XPRA_BIN = 'xpra';
}

sub _attach_cmd {
    my ($s) = @_;
    (my $disp_n = $s->{disp}) =~ s/^://;
    my @dpi_opts;
    if (defined(my $dpi = _dpi_for($s->{host}))) {
        push @dpi_opts, "--dpi=$dpi";
    }
    if ($s->{local} && !$s->{_attach_as}) {
        return (_xpra_bin(), 'attach', @dpi_opts, ":$disp_n");
    }
    # Use the host name in the ssh URL so ~/.ssh/config Host blocks (User,
    # IdentityFile, ...) match.  If we know the IP, force the actual
    # connection to it via xpra's --ssh override (`-o HostName=$ip`) so
    # we don't depend on DNS/mDNS being right for the name.
    my $name = $s->{host};
    my $ip   = $s->{ip};
    my @opts;
    if ($s->{_extra}) {
        $name = $ip // $name;
    } elsif (defined $name && defined $ip && $name ne $ip) {
        push @opts, "--ssh=ssh -o HostName=$ip";
    } else {
        $name = $ip if defined $ip;
    }
    my $login_user = $s->{_attach_as} // $ssh_user;
    my $url = defined $login_user
        ? "ssh://$login_user\@$name/$disp_n"
        : "ssh://$name/$disp_n";
    return (_xpra_bin(), 'attach', @opts, @dpi_opts, $url);
}

sub _free_port {
    my ($preferred) = @_;
    require IO::Socket::INET;
    for my $p ($preferred, $preferred + 100, 0) {
        my $s = IO::Socket::INET->new(
            LocalAddr => '127.0.0.1', LocalPort => $p,
            Proto => 'tcp', Listen => 1, ReuseAddr => 1);
        if ($s) {
            my $port = $s->sockport;
            close $s;
            return $port;
        }
    }
    return $preferred;
}

# Is NAME runnable (absolute path or on PATH)?
sub _have_exe {
    my ($name) = @_;
    return 1 if $name =~ m{/} && -x $name;
    for my $d (split /:/, $ENV{PATH} // '') {
        return 1 if length $d && -x "$d/$name";
    }
    return 0;
}

# True if this attach command will bring up remmina as its VNC viewer. Only
# net-vnc launches a viewer; it picks remmina unless NET_VNC_VIEWER forces
# another. remmina is a single shared client (one window hosts every
# connection), so find-xpra must not offer to Disconnect/kill it per-row.
sub _cmd_uses_remmina {
    my $joined = join(' ', @_);
    return 0 unless $joined =~ /\bnet-vnc\b/;
    return ($1 eq 'remmina' ? 1 : 0) if $joined =~ /NET_VNC_VIEWER=(\S+)/;
    return _have_exe('remmina') ? 1 : 0;   # auto: net-vnc uses remmina if present
}

# Resolve the VNC viewer backend to hand net-vnc via NET_VNC_VIEWER.
# Returns a viewer name to force, or undef to let net-vnc auto-pick.
#   $SETTINGS->{_vnc_viewer}: 'auto'/unset = net-vnc's own choice
#   (remmina if installed); 'remmina' = force remmina; <name> = force it.
# $need_blocking: the caller tunnels and tears the tunnel down when the
# viewer exits (Secure VNC, X11-VNC).  remmina's `-c` handoff detaches
# immediately, so it would kill the tunnel before the window connects.
# In 'auto' mode for those callers, prefer the first *blocking* viewer on
# PATH so the tunnel survives; fall back to undef if none is installed.
sub _vnc_viewer {
    my ($need_blocking) = @_;
    my $v = $SETTINGS->{_vnc_viewer};
    return $v if defined $v && length $v && $v ne 'auto';
    if ($need_blocking) {
        for my $cand (qw(vncviewer xtigervncviewer xvncviewer gvncviewer)) {
            return $cand if _have_exe($cand);
        }
    }
    return undef;
}

sub _vnc_attach_cmd {
    my ($s) = @_;
    (my $disp_n = $s->{disp}) =~ s/^://;
    my $port = $s->{vnc_port} // (5900 + $disp_n);
    my (@env, $env_sh);
    if (defined(my $zoom = _zoom_for($s->{host}))) {
        my $scale = sprintf("%.2f", $zoom / 100);
        @env = ('env', "FLTK_SCALING_FACTOR=$scale",
                "GDK_DPI_SCALE=$scale", "QT_SCALE_FACTOR=$scale");
        $env_sh = "FLTK_SCALING_FACTOR=$scale GDK_DPI_SCALE=$scale"
                . " QT_SCALE_FACTOR=$scale ";
    }
    if ($s->{local}) {
        # Local: no ssh tunnel to tear down, so a detaching viewer is
        # harmless — only force a viewer if the user explicitly chose one.
        if (defined(my $lv = _vnc_viewer(0))) {
            splice @env, 0, 0, 'env' unless @env;
            splice @env, 1, 0, "NET_VNC_VIEWER=$lv";
        }
        return (@env, 'net-vnc', "localhost:$disp_n");
    }
    # Tunneled: needs a blocking viewer or the kill below drops the tunnel
    # the instant the viewer detaches (the remmina failure mode).
    my $viewer = _vnc_viewer(1);
    my @tgt  = ssh_target(_sess_target($s));
    my @sopts = ssh_opts(interactive => 1);
    my $local_port = _free_port(15900 + $disp_n);
    my $ssh_str = join(' ', map { /[\s'"]/ ? "'$_'" : $_ }
                       ('ssh', @sopts, @tgt,
                        '-L', "$local_port:localhost:$port", '-N'));
    $env_sh //= '';
    $env_sh = "NET_VNC_VIEWER=$viewer $env_sh" if defined $viewer;
    my $script = "trap 'kill 0' TERM; "
               . "$ssh_str & VNC_SSH=\$!; sleep 1; "
               . "${env_sh}net-vnc localhost::$local_port; "
               . "kill \$VNC_SSH 2>/dev/null";
    return ('bash', '-c', $script);
}

sub _vnc_direct_cmd {
    my ($s) = @_;
    (my $disp_n = $s->{disp}) =~ s/^://;
    my @env;
    if (defined(my $zoom = _zoom_for($s->{host}))) {
        my $scale = sprintf("%.2f", $zoom / 100);
        @env = ('env', "FLTK_SCALING_FACTOR=$scale",
                "GDK_DPI_SCALE=$scale", "QT_SCALE_FACTOR=$scale");
    }
    # Prefer a numeric IP so we don't depend on DNS or net-lookup.
    my $target;
    for my $t ($s->{ip}, $s->{host}) {
        if (defined $t && $t =~ /^\d+\.\d+\.\d+\.\d+$/) {
            $target = $t; last;
        }
    }
    $target //= $s->{ip} // $s->{host};
    # Direct connection (no tunnel to tear down), so a detaching viewer is
    # fine — only force a viewer if the user explicitly chose one.
    if (defined(my $v = _vnc_viewer(0))) {
        splice @env, 0, 0, 'env' unless @env;
        splice @env, 1, 0, "NET_VNC_VIEWER=$v";
    }
    return (@env, 'net-vnc', "$target:$disp_n");
}

sub _x11vnc_cmd {
    my ($s) = @_;
    (my $disp_n = $s->{disp}) =~ s/^://;
    my $target = $s->{ip} // $s->{host};
    my $login_user = $s->{_attach_as};
    my $dest = (defined $login_user ? "$login_user\@" : '') . "$target:$disp_n";
    my @sopts = ssh_opts(interactive => 1);
    # net-vnc --x11vnc invokes ssh @ssh_extra $login — push -p into the
    # opts so a per-host port override carries through to that ssh.
    my $port = $SETTINGS->{$s->{host}}{ssh_port}
            // ($s->{ip} ? $SETTINGS->{$s->{ip}}{ssh_port} : undef);
    push @sopts, '-p', $port if defined $port && $port =~ /^\d+$/ && $port != 22;
    # net-vnc --x11vnc tunnels internally and runs the viewer in the
    # foreground, tearing the tunnel down on viewer exit — so it needs a
    # blocking viewer for the same reason as Secure VNC.
    my @env;
    if (defined(my $v = _vnc_viewer(1))) {
        @env = ('env', "NET_VNC_VIEWER=$v");
    }
    return (@env, 'net-vnc', '--x11vnc', $dest, @sopts);
}

# Kill any x11vnc serving a specific display on the host.  Used to clear
# a stale/wedged x11vnc that's holding the rfb port (5900+), which makes a
# subsequent Secure VNC / X11-VNC attach fail or land on the wrong screen.
# Scoped to the one display: pkill matches `x11vnc ... -display :N` and the
# common bare `x11vnc :N` form, with a word boundary so :0 doesn't also
# match :0something.  Runs locally (sh -c) for a local session, else ssh.
# Broad "what's running on this host?" probe for the log viewer.  Reuses
# the bourne-style remote command shape that discovery uses (so it works
# on the same hosts), but dumps everything human-readable rather than
# parsing it: VNC/x11vnc/xpra processes, listening RFB (5900+) and X
# (6000+) ports, the X11 sockets, and `xpra list`.  This is what tells
# the user why a VNC attach clashes (e.g. a server already on :0's port,
# under a different process name than the kill pattern expects).
sub _probe_host_cmd {
    my ($s) = @_;
    (my $disp_n = $s->{disp}) =~ s/^://;
    my $remote = join('; ',
        'echo "== host =="',
        'hostname; id',
        'echo',
        'echo "== VNC / x11vnc / Xvnc processes =="',
        'ps -eo user,pid,args | grep -E '
            . "'[Xx](11)?vnc|tigervnc|tightvnc|vino|krfb|Xvnc' "
            . '| grep -v grep || echo "(none)"',
        'echo',
        'echo "== xpra / Xdummy / Xvfb processes =="',
        'ps -eo user,pid,args | grep -E '
            . "'xpra|Xdummy|Xvfb' | grep -v grep || echo \"(none)\"",
        'echo',
        'echo "== listening RFB (5900-5999) & X (6000-6099) ports =="',
        '(ss -tlnp 2>/dev/null || ss -tln 2>/dev/null '
            . '|| netstat -tlnp 2>/dev/null || netstat -tln 2>/dev/null) '
            . "| grep -E ':(59[0-9][0-9]|60[0-9][0-9])' || echo \"(none)\"",
        'echo',
        'echo "== X11 sockets (/tmp/.X11-unix) =="',
        'ls -la /tmp/.X11-unix/ 2>/dev/null || echo "(none)"',
        'echo',
        'echo "== xpra list =="',
        'xpra list 2>&1 || echo "(xpra list failed)"',
        'true',
    );
    if ($s->{local}) {
        return ('sh', '-c', $remote);
    }
    my @tgt = ssh_target(_sess_target($s));
    if (defined $s->{_attach_as} && length $s->{_attach_as}) {
        $tgt[-1] =~ s/^[^\@]*\@//;
        $tgt[-1] = "$s->{_attach_as}\@$tgt[-1]";
    }
    my @sopts = ssh_opts(interactive => 1);
    return ('ssh', @sopts, @tgt, $remote);
}

sub _kill_x11vnc_cmd {
    my ($s) = @_;
    (my $disp_n = $s->{disp}) =~ s/^://;
    # Match x11vnc invoked as either `-display :N` or a bare `:N`, but not
    # :Nm (e.g. :1 must not match :10).  [^0-9] / end-of-arg guards that.
    # Diagnostic: list matching x11vnc before/after and report each pkill's
    # exit so "Show last log" tells the user what actually happened (e.g.
    # "(none)" = nothing to kill, pkill rc=1 = no match, rc=0 = killed).
    my $pat1 = "x11vnc.*-display[[:space:]]*:$disp_n([^0-9]|\$)";
    my $pat2 = "x11vnc([[:space:]].*)?[[:space:]]:$disp_n([^0-9]|\$)";
    my $remote =
          "echo '== x11vnc matching :$disp_n (before) =='; "
        . "{ pgrep -af '$pat1'; pgrep -af '$pat2'; } | sort -u || true; "
        . "pkill -f '$pat1'; echo \"pkill -display rc=\$?\"; "
        . "pkill -f '$pat2'; echo \"pkill bare rc=\$?\"; "
        . "sleep 1; "
        . "echo '== x11vnc matching :$disp_n (after) =='; "
        . "{ pgrep -af '$pat1'; pgrep -af '$pat2'; } | sort -u || echo '(none left)'; "
        . "true";
    if ($s->{local}) {
        return ('sh', '-c', $remote);
    }
    my @tgt   = ssh_target(_sess_target($s));
    if (defined $s->{_attach_as} && length $s->{_attach_as}) {
        $tgt[-1] =~ s/^[^\@]*\@//;
        $tgt[-1] = "$s->{_attach_as}\@$tgt[-1]";
    }
    my @sopts = ssh_opts(interactive => 1);
    return ('ssh', @sopts, @tgt, $remote);
}

# Confirmation dialog for "Kill session": offers Stop (graceful) vs Kill
# (force) vs Cancel.  Returns 'stop', 'kill', or undef (cancel).  Modal:
# grab + waitWindow so the caller blocks until the user chooses.
sub _kill_session_dialog {
    my ($s) = @_;
    my $choice;        # stays undef on cancel / window close
    my $dlg = $mw->Toplevel(-title => 'find-xpra: kill session');
    $dlg->transient($mw);
    # Grab BEFORE building/mapping the widgets — matches the working
    # _ask_host dialog.  Grabbing an already-mapped toplevel misbehaves on
    # some window managers and can leave the content unmapped (blank).
    $dlg->grab;
    $dlg->Label(-text => "Kill the xpra session on $s->{host} $s->{disp}?",
                -font => 'sans-serif 11 bold', -padx => 16, -pady => [14, 4])
        ->pack(-anchor => 'w');
    $dlg->Label(
        -justify => 'left', -anchor => 'w', -padx => 16, -pady => [0, 8],
        -text => "Stop  — graceful `xpra stop` (disconnects clients).\n"
               . "Kill  — stop, then force-kill any leftover\n"
               . "          Xdummy/Xvfb/xpra for this display.",
    )->pack(-anchor => 'w');
    my $bf = $dlg->Frame->pack(-pady => 10);
    $bf->Button(-text => 'Stop', -width => 8,
        -command => sub { $choice = 'stop'; $dlg->destroy })
       ->pack(-side => 'left', -padx => 6);
    $bf->Button(-text => 'Kill', -width => 8,
        -command => sub { $choice = 'kill'; $dlg->destroy })
       ->pack(-side => 'left', -padx => 6);
    $bf->Button(-text => 'Cancel', -width => 8,
        -command => sub { $dlg->destroy })
       ->pack(-side => 'left', -padx => 6);
    $dlg->protocol('WM_DELETE_WINDOW' => sub { $dlg->destroy });
    $dlg->waitWindow;
    return $choice;
}

# Stop an xpra session server on this display, freeing its memory.
# `xpra stop :N` shuts the server down cleanly (disconnects clients, tears
# down the Xdummy/Xvfb).  With $force, also pkill any leftover server
# procs for the display.  Diagnostic: report whether a server was listed
# before/after so "Show last log" shows what happened.  $xpra is the
# resolved xpra binary; the remote runs it by basename via PATH, so for
# the remote case we just say "xpra" (the local _xpra_bin path may not
# exist on the remote).
sub _kill_session_cmd {
    my ($s, $force) = @_;
    (my $disp_n = $s->{disp}) =~ s/^://;
    my $xpra_local = _xpra_bin();
    # Force mode: after the graceful `xpra stop`, pkill any server process
    # still bound to this display — the xpra wrapper, its Xdummy/Xvfb, and
    # the xpra proxy/start for :N — for a session too wedged to stop on its
    # own.  Word-boundary guard so :1 doesn't also match :10.
    my $force_pat = "(xpra_Xdummy|Xdummy|Xvfb|xpra)([[:space:]].*)?"
                  . "[[:space:]]:$disp_n([^0-9]|\$)";
    my $build = sub {
        my ($xpra) = @_;
        my $cmd =
              "echo '== xpra :$disp_n (before) =='; "
            . "$xpra list 2>&1 | grep -E ':$disp_n\\b' || echo '(not listed)'; "
            . "echo '== stopping :$disp_n =='; "
            . "$xpra stop :$disp_n 2>&1; echo \"xpra stop rc=\$?\"; "
            . "sleep 1; ";
        if ($force) {
            $cmd .=
                  "echo '== force-killing leftovers =='; "
                . "pkill -f '$force_pat'; echo \"pkill rc=\$?\"; "
                . "sleep 1; ";
        }
        $cmd .=
              "echo '== xpra :$disp_n (after) =='; "
            . "$xpra list 2>&1 | grep -E ':$disp_n\\b' || echo '(gone)'; ";
        $cmd .= "pgrep -af '$force_pat' || echo '(no leftover procs)'; "
            if $force;
        $cmd .= "true";
        return $cmd;
    };
    if ($s->{local}) {
        return ('sh', '-c', $build->($xpra_local));
    }
    my $remote = $build->('xpra');
    my @tgt = ssh_target(_sess_target($s));
    if (defined $s->{_attach_as} && length $s->{_attach_as}) {
        $tgt[-1] =~ s/^[^\@]*\@//;
        $tgt[-1] = "$s->{_attach_as}\@$tgt[-1]";
    }
    my @sopts = ssh_opts(interactive => 1);
    return ('ssh', @sopts, @tgt, $remote);
}

sub _bump_usage {
    my ($host, $action) = @_;
    $SETTINGS->{_usage}{$host} = ($SETTINGS->{_usage}{$host} // 0) + 1;
    $SETTINGS->{_last_action}{$host} = $action if defined $action;
    _save_settings($SETTINGS);
}

# Build a launch-xpra invocation for the given session and action
# ("Restart app" / "Restart Xpra").  launch-xpra reads the host's own
# ~/.xpra-start to find the app command, so we just hand it the display
# number, the mode flag, and (for Restart Xpra) the resolved DPI.
sub _launch_xpra_cmd {
    my ($s, $action) = @_;
    (my $disp_n = $s->{disp}) =~ s/^://;
    my $mode = $action eq 'Restart app' ? '--restart-app' : '--restart-xpra';
    my @lx = ('launch-xpra', $mode, "--display=$disp_n");
    if ($mode eq '--restart-xpra') {
        if (defined(my $dpi = _dpi_for($s->{host}))) {
            push @lx, "--dpi=$dpi";
        }
        push @lx, '--web' if $action eq 'Restart Xpra+WWW';
    }
    return @lx if $s->{local};
    return ('ssh', ssh_opts(interactive => 1),
            ssh_target(_sess_target($s)),
            @lx);
}

# Build the command to launch a terminal on the session's display.
# Uses the `( cmd & )` subshell-background idiom so the launching shell
# can exit immediately (and ssh with it).  Forces bash because the
# remote login shell may be csh/tcsh.
sub _load_settings {
    return {} unless -f $CONFIG_PATH;
    open my $fh, '<', $CONFIG_PATH or return {};
    local $/; my $json = <$fh>;
    close $fh;
    return eval { decode_json($json) } // {};
}

sub _save_settings {
    my ($s) = @_;
    make_path($CONFIG_DIR);
    open my $fh, '>', $CONFIG_PATH or do { warn "save: $!"; return };
    print $fh encode_json($s);
    close $fh;
}

sub _load_cache {
    return {} unless -f $CACHE_PATH;
    open my $fh, '<', $CACHE_PATH or return {};
    local $/; my $json = <$fh>;
    close $fh;
    return eval { decode_json($json) } // {};
}

sub _save_cache {
    make_path($CONFIG_DIR);
    open my $fh, '>', $CACHE_PATH or do { warn "cache save: $!"; return };
    print $fh encode_json($CACHE);
    close $fh;
}

sub _ago {
    my ($ts) = @_;
    my $a = time - ($ts // 0);
    return $a < 60     ? "${a}s"
         : $a < 3600   ? sprintf("%dm", int($a/60))
         : $a < 86400  ? sprintf("%dh", int($a/3600))
         :               sprintf("%dd", int($a/86400));
}

sub _cache_label {
    my ($name) = @_;
    my $c = $CACHE->{$name} or return undef;
    return undef unless defined $c->{n_sessions} && $c->{n_sessions} > 0;
    return sprintf('%d sess %s ago', $c->{n_sessions}, _ago($c->{ts}));
}

sub _terminal_for {
    my ($host) = @_;
    return $SETTINGS->{$host}{terminal}
        // $SETTINGS->{'*'}{terminal}
        // 'xterm';
}

# Resolve the DPI to pass to `xpra attach --dpi=N` for $host.  Per-host
# override wins over the global default (entry beside Rescan).  Returns
# undef when neither is set (xpra falls back to auto-detect).
sub _dpi_for {
    my ($host) = @_;
    my $dpi = $SETTINGS->{$host}{dpi} // $SETTINGS->{'*'}{dpi};
    return undef unless defined $dpi && $dpi =~ /^\d+$/ && $dpi > 0;
    return $dpi + 0;
}

sub _zoom_for {
    my ($host) = @_;
    my $zoom = $SETTINGS->{$host}{vnc_zoom} // $SETTINGS->{'*'}{vnc_zoom};
    return undef unless defined $zoom && $zoom =~ /^\d+$/ && $zoom > 0 && $zoom != 100;
    return $zoom + 0;
}

sub _ssh_cmd {
    my ($s) = @_;
    my $term = _terminal_for($s->{host});
    my @ssh = ('ssh', ssh_opts(interactive => 1),
               ssh_target(_sess_target($s)));
    my $login_user = $s->{_attach_as};
    if (defined $login_user) {
        $ssh[-1] =~ s/^[^\@]*\@//;
        $ssh[-1] = "$login_user\@$ssh[-1]";
    }
    my @env = ('env', 'SSH_ASKPASS=' . (_askpass() // 'ssh-askpass'),
               'SSH_ASKPASS_REQUIRE=prefer');
    if ($term eq 'xterm') {
        return (@env, $term, '-e', @ssh);
    }
    return (@env, $term, '--', @ssh);
}

sub _term_cmd {
    my ($s) = @_;
    (my $disp_n = $s->{disp}) =~ s/^://;
    my $term = _terminal_for($s->{host});
    # mate-terminal / gnome-terminal don't accept `-display`; they use
    # the DISPLAY env var.  xterm accepts both — we use env-var form so
    # one launch line works for everything.
    my $cmd = "(DISPLAY=:$disp_n $term &)";
    if ($s->{local}) {
        # Perl exec hands $cmd to bash directly — no shell re-tokenisation,
        # so no extra quoting needed.
        return ('bash', '-c', $cmd);
    }
    # ssh joins everything after the target with spaces and ships it to
    # the remote shell, which re-parses.  Without literal single quotes
    # around the bash arg, the remote shell would interpret the parens
    # as a subshell of *its own* and bash -c would get an empty arg.
    return ('ssh', ssh_opts(interactive => 1),
            ssh_target(_sess_target($s)),
            'bash', '-c', "'$cmd'");
}

# Like spawn_detached, but capture the command's stdout+stderr to a
# per-row temp log so "Show last log" can display it.  Stamps the session
# with {_last_log}=>{cmd,log,start,label}; replaces (and unlinks) any
# previous log for that row.  Used for diagnostic one-shots like Kill
# x11vnc where the user needs to see what happened on the remote.
sub spawn_logged {
    my ($sess, $label, @cmd) = @_;
    _dbg("[debug] $label: " . join(' ', map { /\s/ ? "'$_'" : $_ } @cmd));
    # Drop the prior log for this row before starting a new one.
    if (my $old = $sess->{_last_log}) {
        unlink $old->{log} if $old->{log};
    }
    my ($lfh, $lpath) = eval { tempfile('find-xpra-cmd-XXXXXX',
                                        TMPDIR => 1, SUFFIX => '.log') };
    $sess->{_last_log} = { cmd => [@cmd], log => $lpath,
                           start => time, label => $label };
    my $pid = fork // die "fork: $!";
    if ($pid) { close $lfh if $lfh; waitpid($pid, 0); return; }
    POSIX::setsid();
    my $pid2 = fork;
    POSIX::_exit(1) unless defined $pid2;
    POSIX::_exit(0) if $pid2;
    open STDIN, '<', '/dev/null';
    if ($lfh) {
        open STDOUT, '>&', $lfh or open STDOUT, '>', '/dev/null';
        open STDERR, '>&', $lfh or open STDERR, '>', '/dev/null';
    } else {
        open STDOUT, '>', '/dev/null';
        open STDERR, '>', '/dev/null';
    }
    _apply_target_display();
    exec { $cmd[0] } @cmd or POSIX::_exit(127);
}

# Fire-and-forget spawn (no PID tracking, no zombie).  Double-fork into
# a new session so it survives find-xpra exit; init reaps the orphan.
sub spawn_detached {
    my @cmd = @_;
    my $pid = fork // die "fork: $!";
    if ($pid) { waitpid($pid, 0); return; }
    # In the forked child: skip Tk's END handler, which would close the
    # X11 fd inherited from the parent and crash the chooser.
    POSIX::setsid();
    my $pid2 = fork;
    POSIX::_exit(1) unless defined $pid2;
    POSIX::_exit(0) if $pid2;
    open STDIN,  '<', '/dev/null';
    open STDOUT, '>', '/dev/null';
    open STDERR, '>', '/dev/null';
    _apply_target_display();
    exec { $cmd[0] } @cmd or POSIX::_exit(127);
}

# Spawn an xpra-attach child in its own session (so it keeps running if
# find-xpra exits or the controlling terminal closes) and return the
# child PID.  Caller is expected to waitpid(WNOHANG) it from the Tk
# repeat-timer when the viewer exits.
#
# Records the command's log on BOTH %ATTACH_INFO (keyed by pid, consumed
# by the reap timer for the auto-diagnostic pop-up) and $sess->{_last_log}
# (so "Show last log" can show it later — the auto-popup only fires on a
# quick non-zero exit, but the user may want to inspect a slow failure or
# a viewer that exited 0 but never connected).  The two share one temp
# file; it survives until the next command on this row replaces it.
sub spawn_attach {
    my ($sess, $label, @cmd) = @_;
    _dbg("[debug] $label: " . join(' ', map { /\s/ ? "'$_'" : $_ } @cmd));
    # Drop the prior log for this row before starting a new one.
    if (my $old = $sess->{_last_log}) {
        unlink $old->{log} if $old->{log};
    }
    my ($lfh, $lpath) = eval { tempfile('find-xpra-attach-XXXXXX',
                                        TMPDIR => 1, SUFFIX => '.log') };
    my $pid = fork;
    die "fork: $!" unless defined $pid;
    if ($pid) {
        close $lfh if $lfh;
        $ATTACH_INFO{$pid} = { cmd => [@cmd], log => $lpath, start => time };
        # remmina is a single shared client; flag the row so its action menu
        # omits Disconnect (which would close every connection's window).
        $sess->{_remmina} = _cmd_uses_remmina(@cmd);
        $sess->{_last_log} = { cmd => [@cmd], log => $lpath,
                               start => time, label => $label };
        return $pid;
    }
    # In the forked child: skip Tk's END so we don't share-close the
    # parent chooser's X11 fd if exec fails.
    POSIX::setsid();
    open STDIN,  '<', '/dev/null';
    # Always tee stdout/stderr to a per-attach temp log so a quick
    # non-zero exit can pop up a diagnostics window in the parent.  In
    # --debug mode also dup into the debug log so output stays visible.
    if ($lfh) {
        open STDOUT, '>&', $lfh or open STDOUT, '>', '/dev/null';
        open STDERR, '>&', $lfh or open STDERR, '>', '/dev/null';
    } elsif ($debug && $DEBUG_LOG_FH) {
        open STDOUT, '>&', $DEBUG_LOG_FH;
        open STDERR, '>&', $DEBUG_LOG_FH;
    } else {
        open STDOUT, '>', '/dev/null';
        open STDERR, '>', '/dev/null';
    }
    _apply_target_display();
    exec { $cmd[0] } @cmd or POSIX::_exit(127);
}
