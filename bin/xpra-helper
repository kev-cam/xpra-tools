#!/usr/bin/perl
# xpra-helper — route a URL or file to one of your xpra sessions or
# to a local-display target (self or root).
#
# Set as the default handler for whatever schemes/MIME types want
# routing (xdg-mime default ...).  When invoked with an argument the
# helper either:
#
#   - dispatches via a URL filter (first glob match wins),
#   - dispatches via a sticky "kind" default (URL scheme like
#     `mailto`/`https`, or file extension like `ics`), or
#   - pops up a Tk chooser with separate target and application
#     drop-downs; pick a target+app combination to send the argument
#     there.  Tick the remember boxes to record a sticky default
#     and/or a URL filter.
#
# `xpra-helper --edit` opens a preferences window to inspect, change,
# or remove existing sticky defaults and URL filters.
#
# ~/.xpra-start format: one target+app pair per line.  Prefix forms:
#     20: thunderbird -P mail        # xpra display :20
#     :20: thunderbird -P mail       #   (equivalent)
#     self: chromium                 # current $DISPLAY as you
#     : firefox -P personal          # current $DISPLAY as you (alias for self:)
#     root: wireshark                # current $DISPLAY as root (via sudo)
# Lines starting with `#` and blank lines are ignored.  Targets and
# applications are extracted from these lines and offered orthogonally
# in the chooser, so any combination is dispatchable.  If the file is
# absent or empty, xpra-helper auto-discovers common browsers ($BROWSER
# plus firefox/chromium/chrome/brave) and offers self+root targets.
#
# Dispatch sets DISPLAY (and XAUTHORITY for root) and double-forks so
# the caller doesn't block.  Root targets run via `$XPRA_HELPER_SUDO`
# (default `sudo -E`); set it to `pkexec env` if you want a GUI prompt.
#
# Config lives at ~/.config/xpra-helper/sticky.json:
#   {
#     "sticky":      { "https": { "target": ":22",
#                                 "app":    "firefox -P main" } },
#     "url_filters": [ { "pattern": "*github.com*",
#                        "target":  "self",
#                        "app":     "chromium" } ]
#   }
# The `target` field holds a target id — `:N` for xpra sessions or
# `self` / `root` for local-display.  Older cache formats (flat
# `{ "https": ":22" }` and the intermediate `display: "self:firefox"`
# style) are migrated on read.

use strict;
use warnings;
use POSIX ();
use JSON::PP;
use File::Path qw(make_path);

my $START_FILE = "$ENV{HOME}/.xpra-start";
my $CONFIG_DIR = "$ENV{HOME}/.config/xpra-helper";
my $CACHE_FILE = "$CONFIG_DIR/sticky.json";

# --- target / app / session ---------------------------------------------

sub local_display { $ENV{DISPLAY} // ':0' }

sub which {
    my ($bin) = @_;
    return undef unless defined $bin && length $bin;
    return $bin if $bin =~ m{/} && -x $bin;
    for my $dir (split /:/, ($ENV{PATH} // '')) {
        return "$dir/$bin" if -x "$dir/$bin";
    }
    return undef;
}

# A target is a place to dispatch to:
#   - xpra :N  (kind=xpra, display=:N, id=:N)
#   - self     (kind=self, display=$DISPLAY, id="self")
#   - root     (kind=root, display=$DISPLAY, id="root")
sub make_target {
    my ($kind, $display) = @_;
    my $id = $kind eq 'xpra' ? $display : $kind;
    return { kind => $kind, display => $display, id => $id };
}

sub target_from_id {
    my ($id) = @_;
    return undef unless defined $id && length $id;
    return make_target('xpra', $id)             if $id =~ /^:\d+$/;
    return make_target('self', local_display()) if $id eq 'self';
    return make_target('root', local_display()) if $id eq 'root';
    return undef;
}

sub make_session {
    my ($kind, $display, $app) = @_;
    return { target => make_target($kind, $display), app => $app };
}

# Probe PATH for a small set of well-known browsers; return a session
# per (target,app) for each match.  $BROWSER (if executable) wins.
sub discover_local_browsers {
    my @want = qw(firefox firefox-esr
                  chromium chromium-browser
                  google-chrome google-chrome-stable chrome
                  brave-browser microsoft-edge);
    my @cmds;
    if (my $b = $ENV{BROWSER}) {
        push @cmds, $b if which((split /\s+/, $b)[0]);
    }
    for my $c (@want) {
        next if grep { $_ eq $c } @cmds;
        push @cmds, $c if which($c);
    }
    my @out;
    my $disp = local_display();
    for my $c (@cmds) {
        push @out, make_session('self', $disp, $c);
        push @out, make_session('root', $disp, $c);
    }
    return @out;
}

sub load_sessions {
    my @s;
    if (open my $fh, '<', $START_FILE) {
        while (<$fh>) {
            s/#.*//;
            next if /^\s*$/;
            if (/^\s*:?(\d+)\s*:\s*(\S.*?)\s*$/) {
                push @s, make_session('xpra', ":$1", $2);
            } elsif (/^\s*(self|root)\s*:\s*(\S.*?)\s*$/) {
                push @s, make_session($1, local_display(), $2);
            } elsif (/^\s*:\s*(\S.*?)\s*$/) {
                push @s, make_session('self', local_display(), $1);
            } else {
                warn "xpra-helper: $START_FILE: ignoring '$_'";
            }
        }
    }
    push @s, discover_local_browsers() unless @s;
    return @s;
}

# Project a session list down to deduped target choices and apps.
# Target choices include the suggested app from ~/.xpra-start as a
# hint, e.g. ":20  thunderbird -P mail".  `self` and `root` are
# guaranteed to appear so the chooser can offer them even when the
# file uses only xpra entries.
sub derive_choices {
    my ($sessions) = @_;
    my (@target_choices, %t_seen, @apps, %a_seen);
    for my $s (@$sessions) {
        my $label = sprintf('%s  %s', $s->{target}{id}, $s->{app});
        push @target_choices, $label unless $t_seen{$label}++;
        push @apps, $s->{app}        unless $a_seen{$s->{app}}++;
    }
    for my $extra (qw(self root)) {
        push @target_choices, $extra
            unless grep { /^\Q$extra\E(?:\s|$)/ } @target_choices;
    }
    return (\@target_choices, \@apps);
}

# Pull the bare target id out of a chooser label.  Anything matching
# `:N`, `self`, or `root` at the head wins; trailing text is the app
# suggestion.  Free-form input is returned as-is for the id and "" for
# the app.
sub parse_target_choice {
    my ($s) = @_;
    return ('', '') unless defined $s && length $s;
    if ($s =~ /^\s*(:\d+|self|root)\s*(.*?)\s*$/) {
        return ($1, $2);
    }
    return ($s, '');
}

sub label_for_target_id {
    my ($id, $choices) = @_;
    return $id unless defined $id && length $id;
    for my $c (@$choices) {
        my ($cid) = parse_target_choice($c);
        return $c if $cid eq $id;
    }
    return $id;
}

# --- sticky cache --------------------------------------------------------

sub empty_cache { { sticky => {}, url_filters => [] } }

# Resolve an old-style id ("/.N", "self:cmd", "root:cmd") to a
# {target, app} pair, consulting $sessions to recover the app on xpra
# entries when possible.
sub _resolve_legacy_id {
    my ($id, $sessions) = @_;
    return undef unless defined $id && length $id && !ref $id;
    if ($id =~ /^:\d+$/) {
        for my $s (@$sessions) {
            return { target => $id, app => $s->{app} }
                if $s->{target}{id} eq $id;
        }
        return { target => $id, app => '' };
    }
    if ($id =~ /^(self|root):(.*)$/s) {
        return { target => $1, app => $2 };
    }
    return undef;
}

sub _migrate_cache {
    my ($c, $sessions) = @_;
    for my $k (keys %{ $c->{sticky} }) {
        my $v = $c->{sticky}{$k};
        if (ref $v eq 'HASH' && exists $v->{target}) {
            $v->{app} //= '';
            next;
        }
        my $p = _resolve_legacy_id($v, $sessions);
        if ($p) { $c->{sticky}{$k} = $p }
        else    { delete $c->{sticky}{$k} }
    }
    for my $f (@{ $c->{url_filters} }) {
        if (exists $f->{target}) {
            $f->{app} //= '';
            next;
        }
        my $p = _resolve_legacy_id($f->{display}, $sessions);
        delete $f->{display};
        if ($p) { $f->{target} = $p->{target}; $f->{app} = $p->{app} }
    }
    @{ $c->{url_filters} } = grep { exists $_->{target} } @{ $c->{url_filters} };
}

sub load_cache {
    my ($sessions) = @_;
    my $c = empty_cache();
    if (-f $CACHE_FILE && open my $fh, '<', $CACHE_FILE) {
        local $/; my $j = <$fh>; close $fh;
        my $raw = eval { decode_json($j) } // {};
        if (ref $raw eq 'HASH'
            && !exists $raw->{sticky} && !exists $raw->{url_filters}) {
            $c->{sticky} = $raw;
        } else {
            $c->{sticky}      = $raw->{sticky}      || {};
            $c->{url_filters} = $raw->{url_filters} || [];
        }
    }
    _migrate_cache($c, $sessions);
    return $c;
}

sub save_cache {
    my ($c) = @_;
    make_path($CONFIG_DIR);
    open my $fh, '>', $CACHE_FILE or do { warn "save: $!"; return };
    print $fh encode_json($c);
    close $fh;
}

# Pick a stable cache key for $arg:
#   - URL-ish (scheme:rest)        -> the lower-cased scheme
#   - bare path with an extension  -> the lower-cased extension
#   - anything else                -> "default"
sub kind_of {
    my ($a) = @_;
    return lc($1) if $a =~ /^([A-Za-z][A-Za-z0-9+.\-]*):/;
    return lc($1) if $a =~ /\.([A-Za-z0-9]+)\z/;
    return 'default';
}

# Best-effort hostname glob for prefilling the filter entry, e.g.
# `https://user@github.com:443/x` -> `*github.com*`.
sub host_glob {
    my ($a) = @_;
    return '' unless $a =~ m{^[A-Za-z][A-Za-z0-9+.\-]*://([^/?#]+)};
    my $h = $1;
    $h =~ s/^[^@]+\@//;
    $h =~ s/:\d+$//;
    return length $h ? "*$h*" : '';
}

# --- url filter matching -------------------------------------------------

sub glob_to_re {
    my ($p) = @_;
    my $re = quotemeta $p;
    $re =~ s/\\\*/.*/g;
    $re =~ s/\\\?/./g;
    return qr/^$re\z/;
}

sub match_filter {
    my ($arg, $filters) = @_;
    for my $f (@$filters) {
        next unless length($f->{pattern} // '');
        next unless length($f->{target}  // '');
        next unless length($f->{app}     // '');
        my $re = glob_to_re($f->{pattern});
        return $f if $arg =~ $re;
    }
    return undef;
}

# --- dispatch ------------------------------------------------------------

# Run $app with $arg appended, on the X display implied by $target_id,
# fully detached.  Root targets are wrapped with $XPRA_HELPER_SUDO.
sub dispatch_pair {
    my ($target_id, $app, $arg) = @_;
    my $target = target_from_id($target_id)
        or die "xpra-helper: unknown target '$target_id'\n";
    die "xpra-helper: empty application command\n" unless length($app // '');

    my $pid = fork;
    die "fork: $!" unless defined $pid;
    return if $pid;
    POSIX::setsid();
    my $pid2 = fork;
    POSIX::_exit(0) if !defined $pid2 || $pid2 != 0;
    open STDIN,  '<', '/dev/null';
    open STDOUT, '>>', '/dev/null';
    open STDERR, '>>', '/dev/null';
    $ENV{DISPLAY} = $target->{display};
    my @cmd = split /\s+/, $app;
    push @cmd, $arg;
    if ($target->{kind} eq 'root') {
        my $sudo  = $ENV{XPRA_HELPER_SUDO} // 'sudo -E';
        my @sudo  = split /\s+/, $sudo;
        my $xauth = $ENV{XAUTHORITY} // "$ENV{HOME}/.Xauthority";
        @cmd = (@sudo, 'env',
                "DISPLAY=$target->{display}",
                "XAUTHORITY=$xauth",
                @cmd);
    }
    { exec { $cmd[0] } @cmd };
    POSIX::_exit(127);
}

# --- chooser (Tk) --------------------------------------------------------

sub chooser {
    my ($arg, $kind, $target_choices, $apps, $cache) = @_;
    require Tk;
    require Tk::BrowseEntry;
    Tk->import;

    my $mw = MainWindow->new(-title => 'xpra-helper');
    $mw->optionAdd('*Font' => 'sans-serif 11');

    my $shown = length($arg) > 80 ? substr($arg, 0, 77) . '…' : $arg;
    $mw->Label(-text   => $shown,
               -font   => 'sans-serif 11 bold',
               -anchor => 'w', -padx => 10, -justify => 'left')
       ->pack(-fill => 'x', -pady => [8, 2]);
    $mw->Label(-text   => "kind: $kind   —   pick target and application",
               -anchor => 'w', -padx => 10, -fg => '#555')
       ->pack(-fill => 'x', -pady => [0, 6]);

    my $save_sticky = 0;
    $mw->Checkbutton(
        -text     => "Remember as default for [$kind]",
        -variable => \$save_sticky,
        -anchor   => 'w', -padx => 10,
    )->pack(-fill => 'x');

    my $save_filter = 0;
    my $pattern     = host_glob($arg);
    my $fframe      = $mw->Frame->pack(-fill => 'x', -padx => 10);
    $fframe->Checkbutton(
        -text     => 'Also add URL filter:',
        -variable => \$save_filter,
        -anchor   => 'w',
    )->pack(-side => 'left');
    $fframe->Entry(-textvariable => \$pattern, -width => 32)
           ->pack(-side => 'left', -padx => 4, -fill => 'x', -expand => 1);

    my $tgt = $target_choices->[0];
    my (undef, $tgt_app) = parse_target_choice($tgt);
    my $app = length $tgt_app ? $tgt_app : $apps->[0];

    my $picker = $mw->Frame->pack(-fill => 'x', -padx => 10, -pady => [6, 0]);
    $picker->Label(-text => 'Target:', -width => 12, -anchor => 'e')
           ->pack(-side => 'left');
    $picker->BrowseEntry(-variable  => \$tgt,
                         -choices   => $target_choices,
                         -width     => 28,
                         -browsecmd => sub {
                            my (undef, $a) = parse_target_choice($tgt);
                            $app = $a if length $a;
                         })
           ->pack(-side => 'left', -padx => 4, -fill => 'x', -expand => 1);
    $picker->Label(-text => 'Application:', -anchor => 'e')
           ->pack(-side => 'left', -padx => [12, 0]);
    $picker->BrowseEntry(-variable => \$app,
                         -choices  => $apps,
                         -width    => 28)
           ->pack(-side => 'left', -padx => 4, -fill => 'x', -expand => 1);

    my $btns = $mw->Frame->pack(-fill => 'x', -padx => 10, -pady => [8, 8]);
    $btns->Button(
        -text    => 'Open',
        -default => 'active',
        -command => sub {
            my ($tid) = parse_target_choice($tgt);
            unless (length($tid // '') && length($app // '')) {
                $mw->messageBox(-type => 'OK', -icon => 'error',
                                -message => 'Pick a target and an application.');
                return;
            }
            my $dirty = 0;
            if ($save_sticky) {
                $cache->{sticky}{$kind} = { target => $tid, app => $app };
                $dirty = 1;
            }
            if ($save_filter && length($pattern // '')) {
                push @{ $cache->{url_filters} },
                     { pattern => $pattern, target => $tid, app => $app };
                $dirty = 1;
            }
            save_cache($cache) if $dirty;
            dispatch_pair($tid, $app, $arg);
            $mw->destroy;
        },
    )->pack(-side => 'right', -padx => 4);
    $btns->Button(-text => 'Cancel',
                  -command => sub { $mw->destroy; exit 1 })
         ->pack(-side => 'right');

    Tk::MainLoop();
}

# --- preferences editor (Tk) ---------------------------------------------

sub edit_ui {
    my ($cache, $target_choices, $apps) = @_;
    require Tk;
    require Tk::BrowseEntry;
    Tk->import;

    my $mw = MainWindow->new(-title => 'xpra-helper — preferences');
    $mw->optionAdd('*Font' => 'sans-serif 11');

    my $body   = $mw->Frame->pack(-fill => 'both', -expand => 1,
                                  -padx => 8, -pady => 8);
    my $bottom = $mw->Frame->pack(-fill => 'x', -padx => 8, -pady => [0, 8]);

    my $rebuild;
    $rebuild = sub {
        $_->destroy for $body->children;

        # --- sticky defaults ---
        $body->Label(-text => 'Sticky defaults',
                     -font => 'sans-serif 11 bold', -anchor => 'w')
             ->pack(-fill => 'x');
        my $sf = $body->Frame->pack(-fill => 'x', -padx => 12, -pady => [0, 6]);
        my @kinds = sort keys %{ $cache->{sticky} };
        if (!@kinds) {
            $sf->Label(-text => '(none)', -anchor => 'w', -fg => '#777')
               ->pack(-fill => 'x');
        }
        for my $k (@kinds) {
            my $key = $k;
            my $v   = $cache->{sticky}{$key};
            my $tgt = label_for_target_id($v->{target}, $target_choices);
            my $app = $v->{app};
            my $row = $sf->Frame->pack(-fill => 'x', -pady => 1);
            $row->Label(-text => sprintf('%-10s →', $key),
                        -anchor => 'w', -width => 12)
                ->pack(-side => 'left');
            $row->BrowseEntry(-variable  => \$tgt,
                              -choices   => $target_choices,
                              -width     => 24,
                              -browsecmd => sub {
                                  my (undef, $a) = parse_target_choice($tgt);
                                  $app = $a if length $a;
                              })
                ->pack(-side => 'left', -padx => [0, 4]);
            $row->BrowseEntry(-variable => \$app,
                              -choices  => $apps,
                              -width    => 24)
                ->pack(-side => 'left', -fill => 'x', -expand => 1);
            $row->Button(-text => 'Apply',
                         -command => sub {
                            my ($tid) = parse_target_choice($tgt);
                            $cache->{sticky}{$key}
                                = { target => $tid, app => $app };
                            save_cache($cache);
                            $rebuild->();
                         })->pack(-side => 'left', -padx => [6, 0]);
            $row->Button(-text => 'Remove',
                         -command => sub {
                            delete $cache->{sticky}{$key};
                            save_cache($cache);
                            $rebuild->();
                         })->pack(-side => 'left', -padx => [4, 0]);
        }

        # --- url filters ---
        $body->Label(-text => 'URL filters (first match wins; runs before sticky)',
                     -font => 'sans-serif 11 bold', -anchor => 'w')
             ->pack(-fill => 'x', -pady => [10, 0]);
        my $ff = $body->Frame->pack(-fill => 'x', -padx => 12, -pady => [0, 6]);
        my $filters = $cache->{url_filters};
        if (!@$filters) {
            $ff->Label(-text => '(none)', -anchor => 'w', -fg => '#777')
               ->pack(-fill => 'x');
        }
        for my $i (0 .. $#$filters) {
            my $idx = $i;
            my $f   = $filters->[$idx];
            my $pat = $f->{pattern};
            my $tgt = label_for_target_id($f->{target}, $target_choices);
            my $app = $f->{app};
            my $row = $ff->Frame->pack(-fill => 'x', -pady => 1);
            $row->Entry(-textvariable => \$pat, -width => 22)
                ->pack(-side => 'left', -padx => [0, 4]);
            $row->Label(-text => '→')->pack(-side => 'left');
            $row->BrowseEntry(-variable  => \$tgt,
                              -choices   => $target_choices,
                              -width     => 22,
                              -browsecmd => sub {
                                  my (undef, $a) = parse_target_choice($tgt);
                                  $app = $a if length $a;
                              })
                ->pack(-side => 'left', -padx => [4, 4]);
            $row->BrowseEntry(-variable => \$app,
                              -choices  => $apps,
                              -width    => 20)
                ->pack(-side => 'left', -fill => 'x', -expand => 1);
            $row->Button(-text => 'Apply',
                         -command => sub {
                            my ($tid) = parse_target_choice($tgt);
                            $filters->[$idx] = { pattern => $pat,
                                                 target  => $tid,
                                                 app     => $app };
                            save_cache($cache);
                            $rebuild->();
                         })->pack(-side => 'left', -padx => [6, 0]);
            $row->Button(-text => 'Up',
                         -state => $idx == 0 ? 'disabled' : 'normal',
                         -command => sub {
                            @{$filters}[$idx-1, $idx]
                              = @{$filters}[$idx, $idx-1];
                            save_cache($cache);
                            $rebuild->();
                         })->pack(-side => 'left', -padx => [4, 0]);
            $row->Button(-text => 'Down',
                         -state => $idx == $#$filters ? 'disabled' : 'normal',
                         -command => sub {
                            @{$filters}[$idx, $idx+1]
                              = @{$filters}[$idx+1, $idx];
                            save_cache($cache);
                            $rebuild->();
                         })->pack(-side => 'left', -padx => 2);
            $row->Button(-text => 'Remove',
                         -command => sub {
                            splice @$filters, $idx, 1;
                            save_cache($cache);
                            $rebuild->();
                         })->pack(-side => 'left');
        }

        # --- add filter form ---
        my $af = $body->Frame->pack(-fill => 'x', -padx => 12, -pady => [4, 0]);
        $af->Label(-text => 'Add:')->pack(-side => 'left');
        my $pat = '';
        my $tgt = $target_choices->[0];
        my (undef, $tgt_app) = parse_target_choice($tgt);
        my $app = length $tgt_app ? $tgt_app : $apps->[0];
        $af->Entry(-textvariable => \$pat, -width => 22)
           ->pack(-side => 'left', -padx => [4, 0]);
        $af->Label(-text => '→')->pack(-side => 'left', -padx => 4);
        $af->BrowseEntry(-variable  => \$tgt,
                         -choices   => $target_choices,
                         -width     => 22,
                         -browsecmd => sub {
                             my (undef, $a) = parse_target_choice($tgt);
                             $app = $a if length $a;
                         })
           ->pack(-side => 'left', -padx => [0, 4]);
        $af->BrowseEntry(-variable => \$app,
                         -choices  => $apps,
                         -width    => 20)
           ->pack(-side => 'left', -fill => 'x', -expand => 1);
        $af->Button(-text => 'Add',
                    -command => sub {
                        return unless length $pat;
                        my ($tid) = parse_target_choice($tgt);
                        return unless length($tid // '') && length($app // '');
                        push @$filters, { pattern => $pat,
                                          target  => $tid,
                                          app     => $app };
                        save_cache($cache);
                        $rebuild->();
                    })->pack(-side => 'left', -padx => [6, 0]);
    };
    $rebuild->();

    $bottom->Button(
        -text => 'Reset all',
        -command => sub {
            my $ok = $mw->messageBox(
                -type    => 'OkCancel',
                -icon    => 'warning',
                -title   => 'Reset all',
                -message => 'Clear all sticky defaults and URL filters?');
            return unless lc $ok eq 'ok';
            %$cache = %{ empty_cache() };
            save_cache($cache);
            $rebuild->();
        })->pack(-side => 'left');
    $bottom->Button(-text => 'Close',
                    -command => sub { $mw->destroy })
           ->pack(-side => 'right');

    Tk::MainLoop();
}

# --- main ----------------------------------------------------------------

sub usage {
    print <<'EOF';
usage:
  xpra-helper <url|file>   dispatch an argument to a session
  xpra-helper --edit       open the preferences window
  xpra-helper --help       this message
EOF
}

my $edit_mode = 0;
while (@ARGV && $ARGV[0] =~ /^-/) {
    my $opt = shift @ARGV;
    if    ($opt eq '--edit')                  { $edit_mode = 1 }
    elsif ($opt eq '--help' || $opt eq '-h')  { usage(); exit 0 }
    elsif ($opt eq '--')                      { last }
    else { die "xpra-helper: unknown option $opt (try --help)\n" }
}

my @sessions = load_sessions();
die "xpra-helper: no sessions in $START_FILE and no browsers found in PATH\n"
    unless @sessions;
my ($target_choices, $apps) = derive_choices(\@sessions);

if ($edit_mode) {
    my $cache = load_cache(\@sessions);
    edit_ui($cache, $target_choices, $apps);
    exit 0;
}

my $arg = shift @ARGV;
die "usage: xpra-helper <url|file>  (or --edit / --help)\n"
    unless defined $arg;
warn "xpra-helper: extra arguments ignored: @ARGV\n" if @ARGV;

my $cache = load_cache(\@sessions);
my $kind  = kind_of($arg);

# 1) URL filter wins if any pattern matches.
if (my $f = match_filter($arg, $cache->{url_filters})) {
    dispatch_pair($f->{target}, $f->{app}, $arg);
    exit 0;
}

# 2) Sticky default by kind.
if (my $s = $cache->{sticky}{$kind}) {
    if (ref $s eq 'HASH'
        && length($s->{target} // '')
        && length($s->{app}    // ''))
    {
        dispatch_pair($s->{target}, $s->{app}, $arg);
        exit 0;
    }
}

# 3) Fall through to the chooser.
chooser($arg, $kind, $target_choices, $apps, $cache);
exit 0;
