#!/usr/bin/perl
# xpra-web — start (or reuse) an xpra session running mate-terminal
# (or any command), served over HTTPS+WebSocket via xpra's HTML5 client
# on loopback with PAM auth, then point the default browser at it.
#
# Defaults:
#   display      :100
#   port         14501
#   cert         ~/.config/xpra/ssl-cert.pem  (auto-generated if missing)
#   pam service  xpra
#   command      mate-terminal     (override with --start)

use strict;
use warnings;
use Getopt::Long qw(:config no_ignore_case no_bundling);
use IO::Socket::INET;
use File::Path qw(make_path);
use File::Basename qw(dirname);
use Sys::Hostname qw(hostname);

my $DISPLAY_BASE = 100;
my $PORT_BASE    = 14501;

my $display;     # undef -> next free at/after $DISPLAY_BASE
my $port;        # undef -> next free at/after $PORT_BASE
my $iface_arg   = '127.0.0.1';
my $cert        = "$ENV{HOME}/.config/xpra/ssl-cert.pem";
my $pam_service = 'xpra';
my $start_cmd   = 'mate-terminal';
my $new_key;
my $no_browser;
my $help;

sub usage { <<EOF }
usage: xpra-web [options]
  --display N      xpra display (default: next free :$DISPLAY_BASE+)
  --port N         https port (default: 14500 + display number, e.g.
                   :100 → 14600; falls back to next free $PORT_BASE+
                   if the display-aligned port is taken)
  -i, --interface ADDR[,ADDR…]
                   bind address(es), comma-separated (default
                   $iface_arg — loopback only).  Use 0.0.0.0 to expose on
                   every interface, or a list like
                   '127.0.0.1,192.168.1.10' to bind both loopback and a
                   specific NIC.  PAM auth is the only thing between
                   callers and your desktop; pick a strong account
                   password.
  --cert FILE      ssl cert + key, self-signed and generated if missing.
                   The auto-gen cert includes localhost, 127.0.0.1, and
                   `hostname` as SANs; if you pass --interface with an
                   IP / hostname not already covered, it's added too.
                   (default ~/.config/xpra/ssl-cert.pem)
  --new-key        regenerate the cert at --cert even if it exists
                   (forces a fresh key + SAN list)
  --pam-service N  PAM service name (default $pam_service; falls back
                   gracefully if /etc/pam.d/$pam_service is absent —
                   try `--pam-service login` then)
  -c, --command CMD command to run in the session (default $start_cmd)
  --no-browser     don't open the browser; just start the session
  -h, --help       this message
EOF

GetOptions(
    'display=s'     => \$display,
    'port=i'        => \$port,
    'i|interface=s' => \$iface_arg,
    'cert=s'        => \$cert,
    'pam-service=s' => \$pam_service,
    'c|command=s'   => \$start_cmd,
    'new-key'       => \$new_key,
    'no-browser'    => \$no_browser,
    'h|help'        => \$help,
) or die usage();
print(usage()), exit 0 if $help;

my @ifaces = grep { length } split /,/, $iface_arg;
@ifaces = ('127.0.0.1') unless @ifaces;
my $all_loopback = !grep { $_ ne '127.0.0.1' && $_ ne '::1' } @ifaces;
my $any_wildcard =  grep { $_ eq '0.0.0.0'   || $_ eq '::'  } @ifaces;

# A display is "in use" if either the X11 lock or the unix socket is
# present.  This catches both live xpra/X servers and stale leftovers
# (xpra start would refuse a stale display without --clobber).
sub display_in_use {
    my ($n) = @_;
    return -e "/tmp/.X${n}-lock" || -e "/tmp/.X11-unix/X${n}";
}

# A port is "in use" if we can't bind it on every requested interface.
# Bind them all simultaneously — closing each in turn would let a fast
# competitor sneak in between checks.  ReuseAddr keeps a recent
# TIME_WAIT from making us skip a port we could have used.  Tiny TOCTOU
# between the close here and xpra binding it later — accept it.
sub port_in_use {
    my ($p) = @_;
    my @held;
    for my $a (@ifaces) {
        my $s = IO::Socket::INET->new(
            LocalAddr => $a, LocalPort => $p,
            Proto => 'tcp', ReuseAddr => 1, Listen => 1);
        if (!$s) {
            close $_ for @held;
            return 1;
        }
        push @held, $s;
    }
    close $_ for @held;
    return 0;
}

if (defined $display) {
    $display = ":$display" if $display =~ /^\d+$/;
} else {
    my $n = $DISPLAY_BASE;
    $n++ while display_in_use($n) && $n < $DISPLAY_BASE + 200;
    die "xpra-web: no free display in :$DISPLAY_BASE..:" . ($DISPLAY_BASE+199) . "\n"
        if display_in_use($n);
    $display = ":$n";
}

if (!defined $port) {
    # Prefer the display-aligned port (14500 + N) so the URL is
    # predictable from the display number — find-xpra and friends can
    # construct it without asking us.  Fall back to scan only if it's
    # already taken.
    my ($disp_n) = $display =~ /^:(\d+)$/;
    if (defined $disp_n) {
        my $aligned = 14500 + $disp_n;
        $port = $aligned if $aligned >= 1024 && !port_in_use($aligned);
    }
    if (!defined $port) {
        my $p = $PORT_BASE;
        $p++ while port_in_use($p) && $p < $PORT_BASE + 200;
        die "xpra-web: no free port in $PORT_BASE.." . ($PORT_BASE+199) . "\n"
            if port_in_use($p);
        $port = $p;
    }
}

sub port_open {
    # If any of the requested interfaces accepts a connection, xpra is
    # listening.  Loopback if it's in the list (it's always reachable
    # from the same host); otherwise probe each specific interface.
    my @probes = grep { $_ ne '0.0.0.0' && $_ ne '::' } @ifaces;
    @probes = ('127.0.0.1') unless @probes;
    unshift @probes, '127.0.0.1'
        if $any_wildcard && !grep { $_ eq '127.0.0.1' } @probes;
    for my $a (@probes) {
        my $s = IO::Socket::INET->new(
            PeerAddr => $a, PeerPort => $port,
            Proto => 'tcp', Timeout => 1);
        if ($s) { close $s; return 1 }
    }
    return 0;
}

# 1. Cert: generate one if it isn't there.  Self-signed, key + cert in
#    the same PEM (which is what xpra's --ssl-cert wants).  SANs cover
#    the common ways someone will reach this host (loopback + own
#    hostname), plus whatever --interface said if it's an extra
#    name/address.  Requires OpenSSL 1.1.1+ for -addext.
if ($new_key && -f $cert) {
    print "Removing existing cert at $cert\n";
    unlink $cert or die "unlink $cert: $!\n";
}
if (! -f $cert) {
    my $dir = dirname($cert);
    make_path($dir, { mode => 0700 }) unless -d $dir;
    my $host = hostname();
    my @sans = ('DNS:localhost', 'IP:127.0.0.1');
    push @sans, "DNS:$host" if length $host;
    for my $a (@ifaces) {
        next if $a eq '127.0.0.1' || $a eq '::1';
        next if $a eq '0.0.0.0'   || $a eq '::';
        my $tag = $a =~ /^[\d.]+$|:/ ? 'IP' : 'DNS';
        my $san = "$tag:$a";
        push @sans, $san unless grep { $_ eq $san } @sans;
    }
    print "Generating self-signed cert at $cert (SAN: @sans)\n";
    my $rc = system('openssl', 'req', '-x509', '-newkey', 'rsa:2048',
                    '-nodes', '-days', '3650',
                    '-keyout', $cert,
                    '-out',    $cert,
                    '-subj',   '/CN=' . (length $host ? $host : 'localhost'),
                    '-addext', 'subjectAltName=' . join(',', @sans));
    die "openssl failed (exit @{[$rc>>8]})\n" if $rc != 0;
    chmod 0600, $cert;
}

# 2. Anything already running on this display?  `xpra list` is the
#    authoritative source; matching on the display string keeps us
#    independent of system vs user xpra layout.
my $live = 0;
if (open my $fh, '-|', 'xpra', 'list') {
    while (<$fh>) {
        $live = 1 if /\bLIVE session at\s+\Q$display\E\b/;
    }
    close $fh;
}

if ($live) {
    print "xpra $display already running\n";
    die "xpra $display is up but nothing's listening on port $port — "
      . "wrong --port?\n" unless port_open();
} else {
    my $bind_summary = join(',', @ifaces);
    print "Starting xpra $display on $bind_summary:$port\n";
    warn "xpra-web: WARNING — exposing $display on $bind_summary; "
       . "PAM ($pam_service) is the only barrier between callers and "
       . "your desktop\n" unless $all_loopback;
    my $auth = "pam:service=$pam_service";
    my @cmd = ('xpra', 'start', $display,
               "--start=$start_cmd",
               (map { "--bind-ssl=$_:$port" } @ifaces),
               "--ssl-cert=$cert",
               '--html=on',
               "--auth=$auth",
               '--no-mdns');
    my $rc = system(@cmd);
    die "xpra start failed (exit @{[$rc>>8]})\n" if $rc != 0;

    # `xpra start` daemonizes; poll for the port instead of guessing.
    my $deadline = time + 15;
    while (time < $deadline) {
        last if port_open();
        select undef, undef, undef, 0.2;
    }
    die "xpra started but $port never came up — check ~/.xpra/$display.log\n"
        unless port_open();
}

# One URL per bound interface, so the user can copy whichever fits the
# context they're in.  Pick the most "from this host"-friendly one to
# hand to xdg-open: loopback if it's bound, else the first specific
# interface, else the system hostname for a wildcard bind.
my @url_hosts = grep { $_ ne '0.0.0.0' && $_ ne '::' } @ifaces;
unshift @url_hosts, '127.0.0.1'
    if $any_wildcard && !grep { $_ eq '127.0.0.1' } @url_hosts;
push @url_hosts, hostname() if $any_wildcard && length(hostname() // '');
my @urls = map { "https://$_:$port/" } @url_hosts;
print "URL: $_\n" for @urls;
if ($any_wildcard) {
    print "     (also reachable on every other local interface)\n";
}
my $primary = $urls[0];
my ($lb) = grep { m{^https://127\.0\.0\.1:} } @urls;
$primary = $lb if defined $lb;
unless ($no_browser) {
    system('xdg-open', $primary) == 0
        or warn "xdg-open failed; open the URL manually\n";
}
exit 0;
